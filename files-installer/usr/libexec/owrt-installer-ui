# shellcheck shell=sh
# shellcheck disable=SC2034,SC2154

UI_MODE_ACTUAL="line"
UI_WIDTH=80
UI_HEIGHT=25
UI_TERM_COLS=80
UI_INNER_WIDTH=76
UI_CURSOR_HIDDEN=0
UI_DIALOGRC=""
UI_DIALOG_CMD=""
UI_MOUSE_ENABLED=0
UI_MENU_FIRST_ROW=0
UI_MENU_LAST_ROW=0
UI_MENU_TOP=1
UI_INPUT_ACTION="submit"
MENU_NOTE_KIND=""
UI_BACKTITLE_BASE="OpenWrt Hellforge Installer"
UI_BACKTITLE="$UI_BACKTITLE_BASE"
UI_PAYLOAD_VERSION=""
UI_LOGO_TEXT=' _______                     ________        __
|       |.-----.-----.-----.|  |  |  |.----.|  |_
|   -   ||  _  |  -__|     ||  |  |  ||   _||   _|
|_______||   __|_____|__|__||________||__|  |____|
         |__| W I R E L E S S   F R E E D O M'

ui_repeat() {
	repeat_char="$1"
	repeat_count="$2"
	while [ "$repeat_count" -gt 0 ]; do
		printf '%s' "$repeat_char"
		repeat_count=$((repeat_count - 1))
	done
}

ui_text_len() {
	printf '%s' "$1" | wc -c | tr -d ' '
}

ui_set_payload_version() {
	ui_title_version="$1"
	case "$ui_title_version" in
		""|*[![:alnum:]._+-]*)
			UI_PAYLOAD_VERSION=""
			ui_refresh_branding
			return 0
			;;
	esac
	if [ "$(ui_text_len "$ui_title_version")" -gt 32 ]; then
		UI_PAYLOAD_VERSION=""
		ui_refresh_branding
		return 0
	fi
	UI_PAYLOAD_VERSION="$ui_title_version"
	ui_refresh_branding
}

ui_refresh_branding() {
	ui_branding_title="$UI_BACKTITLE_BASE"
	if [ -n "$UI_PAYLOAD_VERSION" ]; then
		ui_branding_title="$ui_branding_title | OpenWrt $UI_PAYLOAD_VERSION"
	fi
	if [ "${OWRT_UI_NO_LOGO:-0}" != "1" ] &&
		[ "$UI_MODE_ACTUAL" = "whiptail" ] &&
		[ "$UI_TERM_COLS" -ge 80 ] && [ "$UI_HEIGHT" -ge 24 ]; then
		UI_BACKTITLE="$UI_LOGO_TEXT
$ui_branding_title"
	else
		UI_BACKTITLE="$ui_branding_title"
	fi
}

ui_trunc() {
	text="$1"
	max="$2"
	if [ "$max" -le 0 ]; then
		return 0
	fi
	printf '%s' "$text" | cut -c 1-"$max"
}

ui_print_padded() {
	text="$(ui_trunc "$1" "$UI_INNER_WIDTH")"
	len="$(ui_text_len "$text")"
	printf '%s' "$text"
	if [ "$len" -lt "$UI_INNER_WIDTH" ]; then
		ui_repeat ' ' "$((UI_INNER_WIDTH - len))"
	fi
}

ui_terminal_size() {
	UI_WIDTH=80
	UI_HEIGHT=25
	if [ -t 1 ] && command -v stty >/dev/null 2>&1; then
		size="$(stty size 2>/dev/null || true)"
		rows="${size%% *}"
		cols="${size#* }"
		case "$rows" in
			""|*[!0-9]*) rows=25 ;;
		esac
		case "$cols" in
			""|*[!0-9]*) cols=80 ;;
		esac
		[ "$rows" -gt 0 ] || rows=25
		[ "$cols" -gt 0 ] || cols=80
		UI_HEIGHT="$rows"
		UI_WIDTH="$cols"
	fi
	UI_TERM_COLS="$UI_WIDTH"
	[ "$UI_WIDTH" -gt 100 ] && UI_WIDTH=100
	[ "$UI_WIDTH" -lt 60 ] && UI_WIDTH=60
	UI_INNER_WIDTH=$((UI_WIDTH - 4))
}

ui_is_serial() {
	tty_path="$(tty 2>/dev/null || true)"
	case "$tty_path" in
		/dev/ttyS*|/dev/ttyAMA*|/dev/hvc*|/dev/ttyUSB*)
			return 0
			;;
	esac
	return 1
}

ui_ready_marker() {
	ui_ready_title="$1"
	case "$ui_ready_title" in
		"Online image unavailable") ui_ready_name="online-unavailable" ;;
		"New OpenWrt release available") ui_ready_name="online-update" ;;
		"Select download uplink") ui_ready_name="online-uplink" ;;
		"Select download network mode") ui_ready_name="online-network-mode" ;;
		"Download static IPv4") ui_ready_name="online-static" ;;
		"Download PPPoE username") ui_ready_name="online-pppoe-username" ;;
		"Download PPPoE password") ui_ready_name="online-pppoe-password" ;;
		"Online image ready") ui_ready_name="online-ready" ;;
		"Offline fallback") ui_ready_name="online-fallback" ;;
		"Select OpenWrt image source") ui_ready_name="image-source" ;;
		"Select custom OpenWrt build") ui_ready_name="custom-build-select" ;;
		"Custom build warning") ui_ready_name="custom-build-warning" ;;
		"Custom build ready") ui_ready_name="custom-build-ready" ;;
		"Custom build rejected") ui_ready_name="custom-build-rejected" ;;
		"Select target disk") ui_ready_name="target-disk" ;;
		"Select installation type") ui_ready_name="install-type" ;;
		"Select installation action") ui_ready_name="existing-system-action" ;;
		"Select OpenWrt partition size") ui_ready_name="storage-layout" ;;
		"Select storage profile") ui_ready_name="storage-profile" ;;
		"Configure data partitions") ui_ready_name="storage-data" ;;
		"Sysupgrade compatibility warning") ui_ready_name="storage-warning" ;;
		"Data partition "*" size") ui_ready_name="storage-data-size" ;;
		"Data partition "*" label") ui_ready_name="storage-data-label" ;;
		"Data partition "*" mount point") ui_ready_name="storage-data-mount" ;;
		"Custom OpenWrt partition size") ui_ready_name="storage-custom" ;;
		"Select rescue scope") ui_ready_name="rescue-scope" ;;
		"Full rescue warning") ui_ready_name="rescue-full-warning" ;;
		"Rescue version warning") ui_ready_name="rescue-version-warning" ;;
		"Rescue ready") ui_ready_name="rescue-ready" ;;
		"Standard OpenWrt upgrade") ui_ready_name="existing-upgrade" ;;
		"Select backup archive") ui_ready_name="config-import-archive" ;;
		"Select import scope") ui_ready_name="config-import-scope" ;;
		"Imported network configuration") ui_ready_name="config-import-network" ;;
		"Backup ready") ui_ready_name="config-import-ready" ;;
		"Select LAN interface") ui_ready_name="lan-interface" ;;
		"Select WAN interface") ui_ready_name="wan-interface" ;;
		"WAN interface") ui_ready_name="wan-interface-auto" ;;
		"LAN IPv4 settings") ui_ready_name="lan-ip" ;;
		"PPPoE username") ui_ready_name="pppoe-username" ;;
		"PPPoE password") ui_ready_name="pppoe-password" ;;
		"Static WAN IPv4 settings") ui_ready_name="wan-static" ;;
		"Select WAN mode") ui_ready_name="wan-mode" ;;
		"Select WAN IPv6 configuration type") ui_ready_name="wan6-mode" ;;
		"Review installation") ui_ready_name="review-summary" ;;
		"Review action") ui_ready_name="review-action" ;;
		"Final erase confirmation") ui_ready_name="final-erase-info" ;;
		"Final system upgrade confirmation") ui_ready_name="final-upgrade-info" ;;
		"Installation success") ui_ready_name="installation-success" ;;
		"Installation completed") ui_ready_name="post-install-menu" ;;
		*) return 0 ;;
	esac
	if command -v autostart_serial_marker >/dev/null 2>&1; then
		autostart_serial_marker "OWRT_INSTALLER_UI_READY=$ui_ready_name"
	fi
}

ui_command_usable() {
	command -v "$1" >/dev/null 2>&1 || return 1
	"$1" --version >/dev/null 2>&1
}

setup_ui() {
	C_RESET=""
	C_BOLD=""
	C_DIM=""
	C_RED=""
	C_GREEN=""
	C_YELLOW=""
	C_BLUE=""
	C_REVERSE=""
	UI_MODE_ACTUAL="line"
	ui_terminal_size

	if [ -t 1 ] && [ "${TERM:-dumb}" != "dumb" ]; then
		C_RESET="$(printf '\033[0m')"
		C_BOLD="$(printf '\033[1m')"
		C_DIM="$(printf '\033[2m')"
		C_RED="$(printf '\033[31m')"
		C_GREEN="$(printf '\033[32m')"
		C_YELLOW="$(printf '\033[33m')"
		C_BLUE="$(printf '\033[36m')"
		C_REVERSE="$(printf '\033[7m')"
	fi

	case "${OWRT_UI_MODE:-auto}" in
		line)
			UI_MODE_ACTUAL="line"
			;;
		dialog)
			if [ -t 0 ] && [ -t 1 ] && [ "${TERM:-dumb}" != "dumb" ] &&
				ui_command_usable dialog; then
				UI_MODE_ACTUAL="dialog"
				UI_DIALOG_CMD="dialog"
				ui_dialog_setup_theme
			elif [ -t 0 ] && [ -t 1 ] && [ "${TERM:-dumb}" != "dumb" ]; then
				UI_MODE_ACTUAL="ansi"
			fi
			;;
		whiptail)
			if [ -t 0 ] && [ -t 1 ] && [ "${TERM:-dumb}" != "dumb" ] &&
				ui_command_usable whiptail; then
				UI_MODE_ACTUAL="whiptail"
				UI_DIALOG_CMD="whiptail"
				ui_dialog_setup_theme
			elif [ -t 0 ] && [ -t 1 ] && [ "${TERM:-dumb}" != "dumb" ]; then
				UI_MODE_ACTUAL="ansi"
			fi
			;;
		curses)
			if [ -t 0 ] && [ -t 1 ] && [ "${TERM:-dumb}" != "dumb" ]; then
				if ui_command_usable dialog; then
					UI_MODE_ACTUAL="dialog"
					UI_DIALOG_CMD="dialog"
					ui_dialog_setup_theme
				elif ui_command_usable whiptail; then
					UI_MODE_ACTUAL="whiptail"
					UI_DIALOG_CMD="whiptail"
					ui_dialog_setup_theme
				else
					UI_MODE_ACTUAL="ansi"
				fi
			fi
			;;
		ansi)
			if [ -t 0 ] && [ -t 1 ] && [ "${TERM:-dumb}" != "dumb" ]; then
				UI_MODE_ACTUAL="ansi"
			fi
			;;
		auto|"")
			if [ -t 0 ] && [ -t 1 ] && [ "${TERM:-dumb}" != "dumb" ] &&
				! ui_is_serial && [ "$UI_WIDTH" -ge 80 ] && [ "$UI_HEIGHT" -ge 24 ]; then
				if ui_command_usable dialog; then
					UI_MODE_ACTUAL="dialog"
					UI_DIALOG_CMD="dialog"
					ui_dialog_setup_theme
				else
					case "${TERM:-dumb}" in
						linux*)
							if ui_command_usable whiptail; then
								UI_MODE_ACTUAL="whiptail"
								UI_DIALOG_CMD="whiptail"
								ui_dialog_setup_theme
							else
								UI_MODE_ACTUAL="ansi"
							fi
							;;
						*) UI_MODE_ACTUAL="ansi" ;;
					esac
				fi
			fi
			;;
		*)
			UI_MODE_ACTUAL="line"
			;;
	esac
	ui_refresh_branding
}

ui_ansi_active() {
	[ "$UI_MODE_ACTUAL" = "ansi" ]
}

ui_dialog_active() {
	[ "$UI_MODE_ACTUAL" = "dialog" ] || [ "$UI_MODE_ACTUAL" = "whiptail" ]
}

ui_dialog_mouse_arg() {
	[ "$UI_MODE_ACTUAL" = "dialog" ] || return 0
	[ "${OWRT_UI_NO_MOUSE:-0}" = "1" ] || printf '%s\n' "--mouse"
}

ui_dialog_run() {
	mouse_arg="$(ui_dialog_mouse_arg)"
	if [ "$UI_MODE_ACTUAL" = "whiptail" ]; then
		set -- --fb "$@"
	fi
	if [ -n "$mouse_arg" ]; then
		"$UI_DIALOG_CMD" "$mouse_arg" "$@"
	else
		"$UI_DIALOG_CMD" "$@"
	fi
}

ui_dialog_capture() {
	# Both programs normally return widget values on stderr. Keep the terminal
	# rendering on the original stdout and capture only the selected value.
	mouse_arg="$(ui_dialog_mouse_arg)"
	if [ "$UI_MODE_ACTUAL" = "whiptail" ]; then
		set -- --fb "$@"
	fi
	if [ -n "$mouse_arg" ]; then
		"$UI_DIALOG_CMD" "$mouse_arg" "$@" 3>&1 1>&2 2>&3
	else
		"$UI_DIALOG_CMD" "$@" 3>&1 1>&2 2>&3
	fi
}

ui_ansi_mouse_supported() {
	ui_ansi_active || return 1
	[ "${OWRT_UI_NO_MOUSE:-0}" != "1" ] || return 1
	ui_is_serial && return 1
	case "${TERM:-dumb}" in
		xterm*|screen*|tmux*|rxvt*|konsole*|alacritty*|kitty*|wezterm*|foot*)
			return 0
			;;
	esac
	return 1
}

ui_mouse_enable() {
	ui_ansi_mouse_supported || return 0
	[ "$UI_MOUSE_ENABLED" = "1" ] && return 0
	printf '\033[?1000h\033[?1006h'
	UI_MOUSE_ENABLED=1
}

ui_mouse_disable() {
	[ "$UI_MOUSE_ENABLED" = "1" ] || return 0
	printf '\033[?1000l\033[?1006l'
	UI_MOUSE_ENABLED=0
}

ui_dialog_setup_theme() {
	if [ "$UI_MODE_ACTUAL" = "whiptail" ]; then
		NEWT_COLORS="${NEWT_COLORS:-root=white,black;window=white,black;border=cyan,black;shadow=black,black;title=yellow,black;button=white,black;actbutton=black,yellow;compactbutton=white,black;checkbox=yellow,black;actcheckbox=black,yellow;entry=white,black;label=white,black;listbox=white,black;actlistbox=black,yellow;sellistbox=white,black;actsellistbox=black,yellow;textbox=white,black;acttextbox=black,yellow;helpline=white,black;roottext=white,black;emptyscale=white,black;fullscale=yellow,black;disentry=gray,black}"
		export NEWT_COLORS
		return 0
	fi
	UI_DIALOGRC="${DIALOGRC:-/tmp/owrt-installer.dialogrc}"
	if [ ! -s "$UI_DIALOGRC" ]; then
		{
			printf 'use_colors = ON\n'
			printf 'screen_color = (WHITE,BLACK,OFF)\n'
			printf 'shadow_color = (BLACK,BLACK,OFF)\n'
			printf 'dialog_color = (WHITE,BLACK,OFF)\n'
			printf 'title_color = (YELLOW,BLACK,ON)\n'
			printf 'border_color = (CYAN,BLACK,ON)\n'
			printf 'button_active_color = (BLACK,YELLOW,ON)\n'
			printf 'button_inactive_color = (WHITE,BLACK,OFF)\n'
			printf 'tag_color = (YELLOW,BLACK,ON)\n'
			printf 'tag_selected_color = (BLACK,YELLOW,ON)\n'
			printf 'item_color = (WHITE,BLACK,OFF)\n'
			printf 'item_selected_color = (BLACK,YELLOW,ON)\n'
			printf 'inputbox_color = (WHITE,BLACK,OFF)\n'
			printf 'inputbox_border_color = (CYAN,BLACK,ON)\n'
		} > "$UI_DIALOGRC" 2>/dev/null || true
	fi
	export DIALOGRC="$UI_DIALOGRC"
}

ui_leave() {
	ui_mouse_disable
	if [ "$UI_CURSOR_HIDDEN" = "1" ]; then
		printf '\033[?25h'
		UI_CURSOR_HIDDEN=0
	fi
	if ui_dialog_active; then
		if [ "$UI_MODE_ACTUAL" = "dialog" ]; then
			ui_dialog_run --clear 2>/dev/null || true
		else
			printf '\033[0m\033[?25h'
		fi
	fi
}

clear_screen() {
	if ui_ansi_active; then
		printf '\033[2J\033[H'
	fi
}

ui_hide_cursor() {
	if ui_ansi_active; then
		printf '\033[?25l'
		UI_CURSOR_HIDDEN=1
	fi
}

ui_show_cursor() {
	if ui_ansi_active; then
		printf '\033[?25h'
		UI_CURSOR_HIDDEN=0
	fi
}

ui_rule() {
	printf '%s+%s+%s\n' "$C_BLUE" "$(ui_repeat '-' "$((UI_WIDTH - 2))")" "$C_RESET"
}

ui_line() {
	printf '%s|%s ' "$C_BLUE" "$C_RESET"
	ui_print_padded "$1"
	printf ' %s|%s\n' "$C_BLUE" "$C_RESET"
}

ui_line_selected() {
	printf '%s|%s ' "$C_BLUE" "$C_RESET"
	printf '%s%s' "$C_REVERSE" "$C_YELLOW"
	ui_print_padded "$1"
	printf '%s %s|%s\n' "$C_RESET" "$C_BLUE" "$C_RESET"
}

ui_line_error() {
	printf '%s|%s ' "$C_BLUE" "$C_RESET"
	printf '%s%s' "$C_RED" "$C_BOLD"
	ui_print_padded "$1"
	printf '%s %s|%s\n' "$C_RESET" "$C_BLUE" "$C_RESET"
}

ui_line_warning() {
	printf '%s|%s ' "$C_BLUE" "$C_RESET"
	printf '%s%s' "$C_RED" "$C_BOLD"
	ui_print_padded "$1"
	printf '%s %s|%s\n' "$C_RESET" "$C_BLUE" "$C_RESET"
}

ui_blank() {
	ui_line ""
}

ui_step_name() {
	title="$1"
	case "$title" in
		*disk*|*Disk*) printf '%s\n' "DISK" ;;
		*partition*|*Partition*|*rescue*|*Rescue*|*backup*|*Backup*|*installation\ action*) printf '%s\n' "STORAGE" ;;
		*LAN*) printf '%s\n' "LAN" ;;
		*WAN*|*PPPoE*|*Static*) printf '%s\n' "WAN" ;;
		*summary*|*Summary*|*Review*|*ERASE*|*erase*) printf '%s\n' "REVIEW" ;;
		*completed*|*Completed*|*Install*) printf '%s\n' "INSTALL" ;;
		*) printf '%s\n' "READY" ;;
	esac
}

ui_steps_text() {
	active="$1"
	out="Steps:"
	for step in DISK STORAGE LAN WAN REVIEW INSTALL; do
		if [ "$step" = "$active" ]; then
			out="$out [$step]"
		else
			out="$out  $step "
		fi
		[ "$step" = "INSTALL" ] || out="$out ->"
	done
	printf '%s\n' "$out"
}

ui_header() {
	version="${INSTALLER_VERSION:-unknown}"
	header_title="OPENWRT HELLFORGE INSTALLER"
	if [ -n "$UI_PAYLOAD_VERSION" ]; then
		header_title="$header_title | OpenWrt $UI_PAYLOAD_VERSION"
	fi
	ui_render_logo
	ui_rule
	ui_line "$header_title | $version"
	ui_rule
}

ui_render_logo() {
	[ "${OWRT_UI_NO_LOGO:-0}" != "1" ] || return 0
	ui_ansi_active || return 0
	[ "$UI_TERM_COLS" -ge 90 ] && [ "$UI_HEIGHT" -ge 30 ] || return 0
	printf '%s\n' "$UI_LOGO_TEXT" | while IFS= read -r ui_logo_line; do
		ui_logo_len="$(ui_text_len "$ui_logo_line")"
		ui_logo_pad=0
		if [ "$ui_logo_len" -lt "$UI_WIDTH" ]; then
			ui_logo_pad=$(((UI_WIDTH - ui_logo_len) / 2))
		fi
		ui_repeat ' ' "$ui_logo_pad"
		printf '%s%s%s%s\n' "$C_BLUE" "$C_BOLD" "$ui_logo_line" "$C_RESET"
	done
}

ui_screen_begin() {
	title="$1"
	clear_screen
	ui_hide_cursor
	ui_header
	ui_line "$(ui_steps_text "$(ui_step_name "$title")")"
	ui_rule
	ui_line "$title"
	ui_rule
}

ui_footer() {
	ui_rule
	if ui_ansi_mouse_supported; then
		ui_line "Up/Down Move  Enter/Click Select  Wheel Scroll  Esc/q Cancel"
	else
		ui_line "Up/Down Move  Enter Select  Esc/q Cancel"
	fi
	ui_rule
}

section() {
	title="$1"
	if ui_ansi_active; then
		ui_screen_begin "$title"
	else
		printf '\n%s%s%s%s\n' "$C_BLUE" "$C_BOLD" "$title" "$C_RESET"
		printf '%s\n' "------------------------------------------------------------"
	fi
}

can_arrow_menu() {
	ui_ansi_active &&
		[ -t 0 ] && [ -t 1 ] &&
		[ "${TERM:-dumb}" != "dumb" ] &&
		command -v stty >/dev/null 2>&1
}

menu_reset() {
	: > "$MENU_LIST"
	MENU_NOTE=""
	MENU_NOTE_KIND=""
}

menu_note() {
	MENU_NOTE="$1"
	MENU_NOTE_KIND="note"
}

menu_warning() {
	MENU_NOTE="$1"
	MENU_NOTE_KIND="warning"
}

menu_add() {
	value="$1"
	label="$2"
	printf '%s|%s\n' "$value" "$label" >> "$MENU_LIST"
}

menu_count() {
	wc -l < "$MENU_LIST" | tr -d ' '
}

menu_value_at() {
	sed -n "${1}s/|.*//p" "$MENU_LIST"
}

menu_label_at() {
	sed -n "${1}s/^[^|]*|//p" "$MENU_LIST"
}

ui_note_lines() {
	text="$1"
	max="$UI_INNER_WIDTH"
	while [ -n "$text" ]; do
		ui_line "$(ui_trunc "$text" "$max")"
		text="$(printf '%s' "$text" | cut -c $((max + 1))-)"
	done
}

ui_warning_lines() {
	text="$1"
	max="$UI_INNER_WIDTH"
	while [ -n "$text" ]; do
		ui_line_warning "$(ui_trunc "$text" "$max")"
		text="$(printf '%s' "$text" | cut -c $((max + 1))-)"
	done
}

ui_menu_note_lines() {
	if [ "$MENU_NOTE_KIND" = "warning" ]; then
		ui_warning_lines "$MENU_NOTE"
	else
		ui_note_lines "$MENU_NOTE"
	fi
}

ui_log_tail_lines() {
	log_file="$1"
	count="${2:-4}"
	[ -n "$log_file" ] && [ -r "$log_file" ] || return 1
	tail -n "$count" "$log_file" 2>/dev/null |
		while IFS= read -r line; do
			[ -n "$line" ] || continue
			ui_line "  $line"
		done
}

ui_log_tail_text() {
	log_file="$1"
	count="${2:-4}"
	[ -n "$log_file" ] && [ -r "$log_file" ] || return 1
	tail -n "$count" "$log_file" 2>/dev/null || true
}

ui_install_stage_position() {
	case "$1" in
		Verify*) printf '%s\n' "1 10" ;;
		Prepare*) printf '%s\n' "2 10" ;;
		Write\ image*) printf '%s\n' "3 10" ;;
		Sync*) printf '%s\n' "4 10" ;;
		Reread*) printf '%s\n' "5 10" ;;
		Grow*) printf '%s\n' "6 10" ;;
		Check\ ext4*) printf '%s\n' "7 10" ;;
		Resize\ ext4*) printf '%s\n' "8 10" ;;
		Final\ ext4*) printf '%s\n' "9 10" ;;
		Write\ installed*) printf '%s\n' "10 10" ;;
		*) printf '%s\n' "0 0" ;;
	esac
}

ui_install_progress_line() {
	stage="$1"
	position="$(ui_install_stage_position "$stage")"
	index="${position% *}"
	total="${position#* }"
	[ "$total" -gt 0 ] || return 0
	bar_width=34
	filled=$((index * bar_width / total))
	[ "$filled" -lt 1 ] && filled=1
	[ "$filled" -gt "$bar_width" ] && filled="$bar_width"
	empty=$((bar_width - filled))
	ui_line "Progress: [$(ui_repeat '#' "$filled")$(ui_repeat '-' "$empty")] $index/$total"
}

ui_install_byte_progress() {
	ui_byte_stage="$1"
	ui_byte_detail="$2"
	ui_byte_percent="$3"
	ui_byte_log_file="${4:-}"
	case "$ui_byte_percent" in
		''|*[!0-9]*) return 0 ;;
	esac
	[ "$ui_byte_percent" -gt 100 ] && ui_byte_percent=100
	ui_byte_bar_width=34
	ui_byte_filled=$((ui_byte_percent * ui_byte_bar_width / 100))
	ui_byte_empty=$((ui_byte_bar_width - ui_byte_filled))

	if ui_ansi_active; then
		ui_screen_begin "Install"
		ui_line "Stage: $ui_byte_stage"
		ui_line "Write: [$(ui_repeat '#' "$ui_byte_filled")$(ui_repeat '-' "$ui_byte_empty")] ${ui_byte_percent}%"
		[ -n "$ui_byte_detail" ] && ui_line "$ui_byte_detail"
		ui_blank
		if [ -n "$ui_byte_log_file" ] && [ -r "$ui_byte_log_file" ]; then
			ui_line "Recent log:"
			ui_log_tail_lines "$ui_byte_log_file" 4 || true
			ui_blank
		fi
		ui_line "Do not power off the machine while this step is running."
		ui_rule
		ui_show_cursor
	else
		printf '[owrt-installer] write progress: %s%%\n' "$ui_byte_percent"
	fi
}

ui_install_progress_stream() {
	ui_progress_fifo="$1"
	ui_progress_stage="$2"
	ui_progress_detail="$3"
	ui_progress_log_file="${4:-}"

	if ui_dialog_active; then
		ui_progress_body="Stage: $ui_progress_stage

$ui_progress_detail

Writing the embedded image. Do not power off the machine."
		while IFS= read -r ui_progress_percent; do
			case "$ui_progress_percent" in
				''|*[!0-9]*) continue ;;
			esac
			if command -v autostart_serial_marker >/dev/null 2>&1; then
				autostart_serial_marker "OWRT_INSTALLER_WRITE_PROGRESS=$ui_progress_percent"
			fi
			printf '%s\n' "$ui_progress_percent"
		done < "$ui_progress_fifo" |
			ui_dialog_run --backtitle "$UI_BACKTITLE" --title "Install" \
				--gauge "$ui_progress_body" 12 76 0
		return $?
	fi

	while IFS= read -r ui_progress_percent; do
		case "$ui_progress_percent" in
			''|*[!0-9]*) continue ;;
		esac
		if command -v autostart_serial_marker >/dev/null 2>&1; then
			autostart_serial_marker "OWRT_INSTALLER_WRITE_PROGRESS=$ui_progress_percent"
		fi
		ui_install_byte_progress "$ui_progress_stage" "$ui_progress_detail" \
			"$ui_progress_percent" "$ui_progress_log_file"
	done < "$ui_progress_fifo"
}

render_numbered_menu() {
	if [ -n "$MENU_NOTE" ]; then
		if ui_ansi_active; then
			ui_menu_note_lines
			ui_blank
		else
			printf '%s\n\n' "$MENU_NOTE"
		fi
	fi
	number=0
	while IFS='|' read -r value label; do
		[ -n "$value" ] || continue
		number=$((number + 1))
		if ui_ansi_active; then
			ui_line "[$number] $label"
		else
			printf '[%s] %s\n' "$number" "$label"
		fi
	done < "$MENU_LIST"
}

render_arrow_menu() {
	title="$1"
	selected="$2"
	count="$(menu_count)"
	ui_terminal_size
	ui_screen_begin "$title"
	current_row=8

	if [ -n "$MENU_NOTE" ]; then
		ui_menu_note_lines
		ui_blank
		note_length="$(ui_text_len "$MENU_NOTE")"
		note_lines=$(((note_length + UI_INNER_WIDTH - 1) / UI_INNER_WIDTH))
		current_row=$((current_row + note_lines + 1))
	fi

	max_items=$((UI_HEIGHT - 12))
	[ "$max_items" -lt 5 ] && max_items=5
	[ "$max_items" -gt 12 ] && max_items=12
	top=1
	if [ "$selected" -gt "$max_items" ]; then
		top=$((selected - max_items + 1))
	fi
	end=$((top + max_items - 1))

	if [ "$top" -gt 1 ]; then
		ui_line "  ... more above ..."
		current_row=$((current_row + 1))
	fi
	UI_MENU_TOP="$top"
	UI_MENU_FIRST_ROW="$current_row"

	number=0
	while IFS='|' read -r value label; do
		[ -n "$value" ] || continue
		number=$((number + 1))
		[ "$number" -lt "$top" ] && continue
		[ "$number" -gt "$end" ] && continue
		if [ "$number" -eq "$selected" ]; then
			ui_line_selected "> $label"
		else
			ui_line "  $label"
		fi
		current_row=$((current_row + 1))
	done < "$MENU_LIST"
	UI_MENU_LAST_ROW=$((current_row - 1))

	if [ "$end" -lt "$count" ]; then
		ui_line "  ... more below ..."
	fi
	ui_footer
}

read_one_key() {
	dd bs=1 count=1 2>/dev/null || true
}

read_optional_key() {
	current_state="$(stty -g 2>/dev/null || true)"
	stty min 0 time 1 2>/dev/null || true
	dd bs=1 count=1 2>/dev/null || true
	if [ -n "$current_state" ]; then
		stty "$current_state" 2>/dev/null || true
	fi
}

read_sgr_mouse_event() {
	MOUSE_BUTTON=""
	MOUSE_X=""
	MOUSE_Y=""
	MOUSE_ACTION=""
	payload=""
	remaining=32
	while [ "$remaining" -gt 0 ]; do
		char="$(read_optional_key)"
		[ -n "$char" ] || return 1
		case "$char" in
			M|m)
				MOUSE_ACTION="$char"
				break
				;;
			[0-9]|';')
				payload="$payload$char"
				;;
			*)
				return 1
				;;
		esac
		remaining=$((remaining - 1))
	done
	[ -n "$MOUSE_ACTION" ] || return 1
	case "$payload" in
		*[!0-9\;]*|*';'*';'*';'*|*';;'*|';'*|*';'|"") return 1 ;;
	esac
	MOUSE_BUTTON="${payload%%;*}"
	rest="${payload#*;}"
	MOUSE_X="${rest%%;*}"
	MOUSE_Y="${rest#*;}"
	case "$MOUSE_BUTTON$MOUSE_X$MOUSE_Y" in
		*[!0-9]*|"") return 1 ;;
	esac
	[ "${#MOUSE_BUTTON}" -le 3 ] || return 1
	[ "${#MOUSE_X}" -le 5 ] || return 1
	[ "${#MOUSE_Y}" -le 5 ] || return 1
	return 0
}

ui_menu_mouse_index() {
	MOUSE_MENU_INDEX=""
	[ "$MOUSE_ACTION" = "M" ] || return 1
	[ "$MOUSE_X" -ge 2 ] && [ "$MOUSE_X" -lt "$UI_WIDTH" ] || return 1
	[ "$MOUSE_Y" -ge "$UI_MENU_FIRST_ROW" ] &&
		[ "$MOUSE_Y" -le "$UI_MENU_LAST_ROW" ] || return 1
	MOUSE_MENU_INDEX=$((UI_MENU_TOP + MOUSE_Y - UI_MENU_FIRST_ROW))
	return 0
}

ui_restore_tty() {
	ui_mouse_disable
	if [ -n "$TTY_STATE" ]; then
		stty "$TTY_STATE" 2>/dev/null || true
		TTY_STATE=""
	fi
	ui_show_cursor
}

ui_discard_escape_sequence() {
	escape_remaining=8
	while [ "$escape_remaining" -gt 0 ]; do
		escape_char="$(read_optional_key)"
		[ -n "$escape_char" ] || return 0
		case "$escape_char" in
			[A-Za-z]|'~') return 0 ;;
		esac
		escape_remaining=$((escape_remaining - 1))
	done
}

ui_read_form_input() {
	input_default="$1"
	input_secret="$2"
	UI_INPUT_ACTION="submit"
	SELECTED_INPUT=""

	if ui_ansi_active && [ -t 0 ] && command -v stty >/dev/null 2>&1; then
		input_buffer=""
		esc="$(printf '\033')"
		backspace="$(printf '\010')"
		delete="$(printf '\177')"
		eot="$(printf '\004')"
		cr="$(printf '\r')"
		TTY_STATE="$(stty -g)"
		stty -icanon -echo min 1 time 0
		while :; do
			input_key="$(read_one_key)"
			if [ "$input_key" = "$esc" ]; then
				input_key2="$(read_optional_key)"
				case "$input_key2" in
					"" )
						UI_INPUT_ACTION="back"
						break
						;;
					"["|"O")
						ui_discard_escape_sequence
						continue
						;;
					*)
						UI_INPUT_ACTION="back"
						break
						;;
				esac
			fi
			case "$input_key" in
				""|"$cr")
					SELECTED_INPUT="${input_buffer:-$input_default}"
					break
					;;
				"$backspace"|"$delete")
					if [ -n "$input_buffer" ]; then
						input_buffer="${input_buffer%?}"
						printf '\b \b'
					fi
					;;
				"$eot")
					UI_INPUT_ACTION="back"
					break
					;;
				[[:print:]])
					input_buffer="$input_buffer$input_key"
					if [ "$input_secret" = "1" ]; then
						printf '*'
					else
						printf '%s' "$input_key"
					fi
					;;
			esac
		done
		ui_restore_tty
		printf '\n'
		return 0
	fi

	if [ "$input_secret" = "1" ] && [ -t 0 ] && command -v stty >/dev/null 2>&1; then
		TTY_STATE="$(stty -g)"
		stty -echo
		if ! IFS= read -r input_answer; then
			ui_restore_tty
			printf '\n'
			die "Input cancelled"
		fi
		ui_restore_tty
		printf '\n'
	elif ! IFS= read -r input_answer; then
		die "Input cancelled"
	fi
	case "$input_answer" in
		'!back')
			UI_INPUT_ACTION="back"
			SELECTED_INPUT=""
			;;
		'!!back')
			SELECTED_INPUT="!back"
			;;
		*)
			SELECTED_INPUT="${input_answer:-$input_default}"
			;;
	esac
}

select_from_menu() {
	title="$1"
	prompt="$2"
	count="$(menu_count)"
	[ "$count" -gt 0 ] || die "No choices available for $prompt"
	ui_ready_marker "$title"

	if ui_dialog_active; then
		if [ "$UI_MODE_ACTUAL" = "whiptail" ]; then
			set -- --notags
		else
			set --
		fi
		set -- "$@" \
			--backtitle "$UI_BACKTITLE" \
			--title "$title" \
			--menu "${MENU_NOTE:-Select $prompt.}" 0 0 0
		number=0
		while IFS='|' read -r value label; do
			[ -n "$value" ] || continue
			number=$((number + 1))
			set -- "$@" "$value" "$label"
		done < "$MENU_LIST"
		dialog_status=0
		SELECTED_VALUE="$(ui_dialog_capture "$@")" || dialog_status=$?
		case "$dialog_status" in
			0) ;;
			1|255) die "Selection cancelled" ;;
			*) die "Selection dialog failed with status $dialog_status" ;;
		esac
		MENU_NOTE=""
		return 0
	fi

	if can_arrow_menu; then
		selected=1
		esc="$(printf '\033')"
		TTY_STATE="$(stty -g)"
		stty -icanon -echo min 1 time 0
		ui_mouse_enable
		while :; do
			render_arrow_menu "$title" "$selected"
			key="$(read_one_key)"
			if [ "$key" = "$esc" ]; then
				key2="$(read_optional_key)"
				if [ -z "$key2" ]; then
					ui_restore_tty
					die "Selection cancelled"
				fi
				key3="$(read_optional_key)"
				case "$key2$key3" in
					"[A")
						[ "$selected" -gt 1 ] && selected=$((selected - 1))
						;;
					"[B")
						[ "$selected" -lt "$count" ] && selected=$((selected + 1))
						;;
					"[<")
						if read_sgr_mouse_event; then
							case "$MOUSE_BUTTON" in
								0)
									if ui_menu_mouse_index; then
										selected="$MOUSE_MENU_INDEX"
										ui_restore_tty
										SELECTED_VALUE="$(menu_value_at "$selected")"
										MENU_NOTE=""
										clear_screen
										return 0
									fi
									;;
								64)
									[ "$MOUSE_ACTION" = "M" ] && [ "$selected" -gt 1 ] && selected=$((selected - 1))
									;;
								65)
									[ "$MOUSE_ACTION" = "M" ] && [ "$selected" -lt "$count" ] && selected=$((selected + 1))
									;;
							esac
						fi
						;;
				esac
				continue
			fi
			case "$key" in
				q|Q)
					ui_restore_tty
					die "Selection cancelled"
					;;
				"")
					ui_restore_tty
					SELECTED_VALUE="$(menu_value_at "$selected")"
					MENU_NOTE=""
					clear_screen
					return 0
					;;
			esac
		done
	fi

	section "$title"
	render_numbered_menu
	printf '\nEnter %s number: ' "$prompt"
	IFS= read -r choice
	case "$choice" in
		*[!0-9]*|"") die "Invalid $prompt selection" ;;
	esac
	SELECTED_VALUE="$(menu_value_at "$choice")"
	[ -n "$SELECTED_VALUE" ] || die "Invalid $prompt selection"
	MENU_NOTE=""
}

prompt_default() {
	label="$1"
	default="$2"
	title="${3:-$label}"
	example="${4:-}"
	error="${5:-}"
	details="${6:-}"
	ui_ready_marker "$title"
	if ui_dialog_active; then
		body="$details"
		[ -n "$example" ] && body="${body}${body:+
}$example"
		[ -n "$error" ] && body="${body}${body:+
}ERROR: $error"
		[ -n "$body" ] || body="Type a new value or press Enter to keep the default."
		dialog_status=0
		SELECTED_INPUT="$(ui_dialog_capture --backtitle "$UI_BACKTITLE" --title "$title" --inputbox "$body" 0 0 "$default")" || dialog_status=$?
		case "$dialog_status" in
			0) UI_INPUT_ACTION="submit" ;;
			1|255)
				UI_INPUT_ACTION="back"
				SELECTED_INPUT=""
				return 0
				;;
			*) die "Input dialog failed with status $dialog_status" ;;
		esac
		[ -n "$SELECTED_INPUT" ] || SELECTED_INPUT="$default"
		return 0
	fi
	if ui_ansi_active; then
		ui_screen_begin "$title"
		if [ -n "$details" ]; then
			ui_note_lines "$details"
			ui_blank
		fi
		ui_line "Field: $label"
		ui_line "Current/default: $default"
		[ -n "$example" ] && ui_line "$example"
		if [ -n "$error" ]; then
			ui_blank
			ui_line_error "ERROR: $error"
		fi
		ui_blank
		ui_line "Type a value. Enter keeps current/default. Esc goes back."
		ui_rule
		ui_show_cursor
	else
		if [ -n "$title" ] && [ "$title" != "$label" ]; then
			section "$title"
		fi
		[ -n "$details" ] && printf '%s\n' "$details"
		[ -n "$example" ] && printf '%s\n' "$example"
		[ -n "$error" ] && printf '%sERROR:%s %s\n' "$C_RED" "$C_RESET" "$error"
		printf '%s\n' "Type !back to return; type !!back for a literal !back value."
	fi
	printf '%s [%s]: ' "$label" "$default"
	ui_read_form_input "$default" 0
}

ui_passwordbox_height() {
	body="$1"
	body_rows="$(printf '%s\n' "$body" | awk -v cols="$((UI_TERM_COLS - 4))" '
		{
			length_in_columns = length($0)
			rows += (cols < 1 || length_in_columns <= cols) ? 1 : int((length_in_columns + cols - 1) / cols)
		}
		END { print rows + 0 }
	')"
	box_height=$((body_rows + 9))
	max_height=$((UI_HEIGHT - 2))
	[ "$max_height" -ge 9 ] || max_height=9
	[ "$box_height" -le "$max_height" ] || box_height="$max_height"
	printf '%s\n' "$box_height"
}

prompt_secret() {
	label="$1"
	title="${2:-$label}"
	error="${3:-}"
	details="${4:-}"
	default="${5:-}"
	ui_ready_marker "$title"
	if ui_dialog_active; then
		body="${details:-Input is hidden.}"
		[ -n "$default" ] && body="$body
A value is already set; submit an empty value to keep it."
		[ -n "$error" ] && body="${body}${body:+
}ERROR: $error"
		box_height=0
		if [ "$UI_MODE_ACTUAL" = "whiptail" ]; then
			ui_terminal_size
			box_height="$(ui_passwordbox_height "$body")"
		fi
		dialog_status=0
		SELECTED_INPUT="$(ui_dialog_capture --backtitle "$UI_BACKTITLE" --title "$title" --passwordbox "$body" "$box_height" 0)" || dialog_status=$?
		case "$dialog_status" in
			0) UI_INPUT_ACTION="submit" ;;
			1|255)
				UI_INPUT_ACTION="back"
				SELECTED_INPUT=""
				return 0
				;;
			*) die "Password dialog failed with status $dialog_status" ;;
		esac
		[ -n "$SELECTED_INPUT" ] || SELECTED_INPUT="$default"
		return 0
	fi
	if ui_ansi_active; then
		ui_screen_begin "$title"
		if [ -n "$details" ]; then
			ui_note_lines "$details"
			ui_blank
		fi
		ui_line "Field: $label"
		ui_line "Input is hidden."
		[ -n "$default" ] && ui_line "A value is already set; Enter keeps it."
		if [ -n "$error" ]; then
			ui_blank
			ui_line_error "ERROR: $error"
		fi
		ui_blank
		ui_line "Enter submits/keeps the value. Esc goes back."
		ui_rule
		ui_show_cursor
	else
		if [ -n "$title" ] && [ "$title" != "$label" ]; then
			section "$title"
		fi
		[ -n "$details" ] && printf '%s\n' "$details"
		[ -n "$error" ] && printf '%sERROR:%s %s\n' "$C_RED" "$C_RESET" "$error"
		[ -n "$default" ] && printf '%s\n' "A value is already set; Enter keeps it."
		printf '%s\n' "Type !back to return; type !!back for a literal !back value."
	fi
	printf '%s: ' "$label"
	ui_read_form_input "$default" 1
}

ui_welcome_screen() {
	version="$1"
	auto_started="$2"
	if ui_ansi_active; then
		ui_screen_begin "Welcome"
		ui_line "OpenWrt x86 Installer $version"
		ui_blank
		if [ "$auto_started" = "1" ]; then
			ui_line "Autostart mode: installer launched from the boot console."
		fi
		if [ "${DRY_RUN:-0}" = "1" ]; then
			ui_line_warning "HARDWARE TEST / DRY RUN"
			ui_line "The full wizard and confirmation gate will run without disk writes."
		else
			ui_line "This installer writes a prebuilt OpenWrt image to a disk."
			ui_line "The selected disk will be erased only after final confirmation."
		fi
		ui_rule
		ui_show_cursor
	else
		clear_screen
		printf '\nOpenWrt x86 Installer %s\n\n' "$version"
		[ "$auto_started" = "1" ] && printf 'Autostart mode: installer launched from boot console.\n\n'
		if [ "${DRY_RUN:-0}" = "1" ]; then
			printf 'HARDWARE TEST / DRY RUN: the wizard will not write any disk.\n\n'
		else
			printf 'This installer writes a prebuilt OpenWrt image to a disk.\n'
			printf 'The selected disk will be erased completely.\n\n'
		fi
	fi
}

ui_notice() {
	title="$1"
	message="$2"
	ui_ready_marker "$title"
	if ui_dialog_active; then
		ui_dialog_run --backtitle "$UI_BACKTITLE" --title "$title" --msgbox "$message" 0 0 ||
			die "Notice cancelled"
		return 0
	fi
	if ui_ansi_active; then
		ui_screen_begin "$title"
		ui_line "$message"
		ui_blank
		ui_line "Press Enter to continue."
		ui_rule
		ui_show_cursor
		IFS= read -r ignored || true
	else
		printf '\n%s\n' "$message"
	fi
}

ui_summary_screen() {
	ui_ready_marker "Review installation"
	if ui_dialog_active; then
		body="Target disk: $TARGET
Target info: ${TARGET_DISK_DESCRIPTION:-unknown}
Mode: ${INSTALL_MODE:-clean}
Image source: $PAYLOAD_SOURCE_LABEL
OpenWrt: ${PAYLOAD_VERSION:-unknown} ($PAYLOAD_BOOT_MODE)
Image: $PAYLOAD_FILENAME
SHA-256: $PAYLOAD_SHA256
Storage: $(storage_layout_label)
Profile: $STORAGE_PROFILE
Image root: $STORAGE_ROOT_IMAGE_MIB MiB
Geometry: partition 2 sectors $STORAGE_ROOT_START_SECTOR-$STORAGE_ROOT_TARGET_END_SECTOR"
		while IFS='|' read -r data_number data_start data_end data_label data_mountpoint; do
			body="$body
Data p$data_number: $(((data_end - data_start + 1) / 2048)) MiB ext4, $data_label -> $data_mountpoint, sectors $data_start-$data_end"
		done < "$STORAGE_DATA_LAYOUT_LIST"
		body="$body
SSD reserve: $STORAGE_RESERVED_MIB MiB unallocated; discard=$STORAGE_DISCARD_STATUS"
		if [ "$STORAGE_PROFILE" = "compatible" ]; then
			body="$body
Upgrade: standard sysupgrade only after exact p1/p2 preflight"
		else
			body="$body
WARNING: use Hellforge Safe Upgrade or an exact system-only image; ordinary sysupgrade can replace the partition table"
		fi
		if [ -n "${STORAGE_EXISTING_ROOT_SECTORS:-}" ] &&
			storage_is_nonnegative_integer "$STORAGE_EXISTING_ROOT_SECTORS"; then
			body="$body
Existing root: $(((STORAGE_EXISTING_ROOT_SECTORS + 2047) / 2048)) MiB on $STORAGE_EXISTING_ROOT_PART"
		fi
		if [ "$PAYLOAD_SOURCE_ID" = "downloaded-official" ]; then
			body="$body
RAM: $(bytes_as_mib "$PAYLOAD_COMPRESSED_SIZE") image; $(bytes_as_mib "$PAYLOAD_RAM_AVAILABLE") available; $(bytes_as_mib "$PAYLOAD_RAM_REQUIRED") required"
		elif [ "$PAYLOAD_SOURCE_ID" = "custom-build" ]; then
			body="$body
CUSTOM IMAGE: $PAYLOAD_CUSTOM_CHECKSUM_STATUS; not authenticated by the OpenWrt release key
RAM: $(bytes_as_mib "$PAYLOAD_COMPRESSED_SIZE") image; $(bytes_as_mib "$PAYLOAD_RAM_AVAILABLE") available; $(bytes_as_mib "$PAYLOAD_RAM_REQUIRED") required"
		fi
		case "${INSTALL_MODE:-clean}" in
		import|rescue|safe-upgrade)
			body="$body
Config: $CONFIG_IMPORT_SOURCE_LABEL
Import: $CONFIG_IMPORT_POLICY, $CONFIG_IMPORT_MEMBER_COUNT members, $(bytes_as_mib "$CONFIG_IMPORT_COMPRESSED_SIZE")
Import SHA-256: $CONFIG_IMPORT_SHA256"
			if [ "$INSTALL_MODE" = "rescue" ] || [ "$INSTALL_MODE" = "safe-upgrade" ]; then
				body="$body
Rescue: OpenWrt $STORAGE_RESCUE_SOURCE_VERSION from $STORAGE_RESCUE_SOURCE_PART; skipped=$STORAGE_RESCUE_SKIPPED
Packages: $STORAGE_RESCUE_PACKAGE_COUNT names recorded; not installed"
				body="$body
RAM warning: rescued configuration exists only in volatile memory until installation completes"
				[ "$INSTALL_MODE" != "safe-upgrade" ] || body="$body
Write scope: partition table and data partitions preserved; system partitions 1 and 2 replaced"
			fi
			;;
		esac
		if [ "${NETWORK_SOURCE:-wizard}" = "imported" ]; then
			body="$body
Network: imported from backup"
		elif [ "$SKIP_NETWORK" = "1" ]; then
			body="$body
Network: keep OpenWrt defaults"
		else
			body="$body
LAN: ${LAN_DEV:-selected-by-mac} $LAN_MAC
WAN: ${WAN_DEV:-selected-by-mac} $WAN_MAC
LAN address: $LAN_IP/$LAN_CIDR"
			case "$WAN_PROTO" in
				dhcp) body="$body
WAN IPv4: DHCP client" ;;
				pppoe) body="$body
WAN IPv4: PPPoE user=$WAN_PPP_USERNAME" ;;
				static) body="$body
WAN IPv4: static $WAN_IPADDR/$WAN_CIDR gateway=${WAN_GATEWAY:-none}" ;;
				disabled) body="$body
WAN IPv4: disabled" ;;
			esac
			body="$body
WAN IPv6: $(wan6_label "$WAN6_PROTO")"
			[ "$WAN_PROTO" = "disabled" ] || body="$body
NAT: enabled"
		fi
		if [ "${DRY_RUN:-0}" = "1" ]; then
			body="$body

HARDWARE TEST / DRY RUN: $TARGET WILL NOT BE WRITTEN."
		elif [ "${INSTALL_MODE:-clean}" = "safe-upgrade" ]; then
			body="$body

SYSTEM PARTITIONS 1 AND 2 ON $TARGET WILL BE REPLACED; VALIDATED DATA PARTITIONS WILL BE PRESERVED."
		else
			body="$body

ALL DATA ON $TARGET WILL BE ERASED."
		fi
		ui_dialog_run --backtitle "$UI_BACKTITLE" --title "Review installation" --msgbox "$body" 0 0 ||
			die "Review cancelled"
		return 0
	fi
	ui_ansi_active || return 1
	ui_screen_begin "Review installation"
	ui_line "Target disk: $TARGET"
	ui_line "Target info: ${TARGET_DISK_DESCRIPTION:-unknown}"
	ui_line "Mode: ${INSTALL_MODE:-clean}"
	ui_line "Image source: $PAYLOAD_SOURCE_LABEL"
	ui_line "OpenWrt: ${PAYLOAD_VERSION:-unknown} ($PAYLOAD_BOOT_MODE)"
	ui_line "Image: $PAYLOAD_FILENAME"
	ui_line "SHA-256: $PAYLOAD_SHA256"
	ui_line "Storage: $(storage_layout_label)"
	ui_line "Profile: $STORAGE_PROFILE"
	ui_line "Image root: $STORAGE_ROOT_IMAGE_MIB MiB"
	ui_line "Geometry: partition 2 sectors $STORAGE_ROOT_START_SECTOR-$STORAGE_ROOT_TARGET_END_SECTOR"
	while IFS='|' read -r data_number data_start data_end data_label data_mountpoint; do
		ui_line "Data p$data_number: $(((data_end - data_start + 1) / 2048)) MiB ext4, $data_label -> $data_mountpoint"
	done < "$STORAGE_DATA_LAYOUT_LIST"
	ui_line "SSD reserve: $STORAGE_RESERVED_MIB MiB unallocated; discard=$STORAGE_DISCARD_STATUS"
	if [ "$STORAGE_PROFILE" = "compatible" ]; then
		ui_line_warning "UPGRADE: standard sysupgrade requires exact p1/p2 preflight."
	else
		ui_line_warning "UPGRADE: use Hellforge Safe Upgrade or an exact system-only image."
	fi
	if [ -n "${STORAGE_EXISTING_ROOT_SECTORS:-}" ] &&
		storage_is_nonnegative_integer "$STORAGE_EXISTING_ROOT_SECTORS"; then
		ui_line "Existing root: $(((STORAGE_EXISTING_ROOT_SECTORS + 2047) / 2048)) MiB on $STORAGE_EXISTING_ROOT_PART"
	fi
	if [ "$PAYLOAD_SOURCE_ID" = "downloaded-official" ]; then
		ui_line "RAM: $(bytes_as_mib "$PAYLOAD_COMPRESSED_SIZE") image; $(bytes_as_mib "$PAYLOAD_RAM_AVAILABLE") available; $(bytes_as_mib "$PAYLOAD_RAM_REQUIRED") required"
	elif [ "$PAYLOAD_SOURCE_ID" = "custom-build" ]; then
		ui_line_warning "CUSTOM IMAGE: $PAYLOAD_CUSTOM_CHECKSUM_STATUS; not authenticated by OpenWrt."
		ui_line "RAM: $(bytes_as_mib "$PAYLOAD_COMPRESSED_SIZE") image; $(bytes_as_mib "$PAYLOAD_RAM_AVAILABLE") available; $(bytes_as_mib "$PAYLOAD_RAM_REQUIRED") required"
	fi
	case "${INSTALL_MODE:-clean}" in
	import|rescue|safe-upgrade)
		ui_line "Config: $CONFIG_IMPORT_SOURCE_LABEL"
		ui_line "Import: $CONFIG_IMPORT_POLICY, $CONFIG_IMPORT_MEMBER_COUNT members, $(bytes_as_mib "$CONFIG_IMPORT_COMPRESSED_SIZE")"
		ui_line "Import SHA-256: $CONFIG_IMPORT_SHA256"
		{ [ "$INSTALL_MODE" = "rescue" ] || [ "$INSTALL_MODE" = "safe-upgrade" ]; } &&
			ui_line "Rescue: OpenWrt $STORAGE_RESCUE_SOURCE_VERSION from $STORAGE_RESCUE_SOURCE_PART; skipped=$STORAGE_RESCUE_SKIPPED"
		{ [ "$INSTALL_MODE" = "rescue" ] || [ "$INSTALL_MODE" = "safe-upgrade" ]; } &&
			ui_line "Packages: $STORAGE_RESCUE_PACKAGE_COUNT names recorded; not installed"
		{ [ "$INSTALL_MODE" = "rescue" ] || [ "$INSTALL_MODE" = "safe-upgrade" ]; } &&
			ui_line_warning "RAM ONLY: rescued configuration is volatile until installation completes."
		[ "$INSTALL_MODE" != "safe-upgrade" ] ||
			ui_line_warning "WRITE SCOPE: p1/p2 replaced; partition table and validated data partitions preserved."
		;;
	esac
	if [ "${NETWORK_SOURCE:-wizard}" = "imported" ]; then
		ui_line "Network: imported from backup"
	elif [ "$SKIP_NETWORK" = "1" ]; then
		ui_line "Network: keep OpenWrt defaults"
	else
		ui_line "LAN: ${LAN_DEV:-selected-by-mac} $LAN_MAC"
		ui_line "WAN: ${WAN_DEV:-selected-by-mac} $WAN_MAC"
		ui_line "LAN address: $LAN_IP/$LAN_CIDR"
		case "$WAN_PROTO" in
			dhcp) ui_line "WAN IPv4: DHCP client" ;;
			pppoe) ui_line "WAN IPv4: PPPoE user=$WAN_PPP_USERNAME" ;;
			static) ui_line "WAN IPv4: static $WAN_IPADDR/$WAN_CIDR gateway=${WAN_GATEWAY:-none}" ;;
			disabled) ui_line "WAN IPv4: disabled" ;;
		esac
		ui_line "WAN IPv6: $(wan6_label "$WAN6_PROTO")"
		[ "$WAN_PROTO" = "disabled" ] || ui_line "NAT: enabled"
	fi
	ui_blank
	if [ "${DRY_RUN:-0}" = "1" ]; then
		ui_line_warning "HARDWARE TEST / DRY RUN: $TARGET WILL NOT BE WRITTEN."
	elif [ "${INSTALL_MODE:-clean}" = "safe-upgrade" ]; then
		ui_line_warning "SYSTEM PARTITIONS 1 AND 2 WILL BE REPLACED; VALIDATED DATA PARTITIONS WILL BE PRESERVED."
	else
		ui_line_warning "ALL DATA ON $TARGET WILL BE ERASED."
	fi
	ui_rule
	ui_show_cursor
	return 0
}

ui_confirm_erase_screen() {
	expected="$1"
	if [ "${INSTALL_MODE:-clean}" = "safe-upgrade" ]; then
		confirmation_title="Final system upgrade confirmation"
	else
		confirmation_title="Final erase confirmation"
	fi
	ui_ready_marker "$confirmation_title"
	if [ "${DRY_RUN:-0}" = "1" ]; then
		heading="SAFE DRY RUN"
		detail="Type the exact string to test the keyboard-only gate. No disk write follows."
	elif [ "${INSTALL_MODE:-clean}" = "safe-upgrade" ]; then
		heading="SYSTEM UPGRADE"
		detail="The validated partition table and data partitions are preserved. Type this exact confirmation string in the next prompt:"
	else
		heading="DESTRUCTIVE ACTION"
		detail="Type this exact confirmation string in the next prompt:"
	fi
	if ui_dialog_active; then
		ui_dialog_run --backtitle "$UI_BACKTITLE" --title "$confirmation_title" --msgbox "$heading

$detail

$expected" 0 0 ||
			die "Confirmation cancelled"
		return 0
	fi
	if ui_ansi_active; then
		ui_screen_begin "$confirmation_title"
		ui_line_warning "$heading"
		ui_line "$detail"
		ui_blank
		ui_line "$expected"
		ui_rule
		ui_show_cursor
	fi
}

ui_install_stage() {
	stage="$1"
	detail="$2"
	log_file="${3:-}"
	if ui_dialog_active; then
		body="Stage: $stage

$detail"
		if [ -n "$log_file" ] && [ -r "$log_file" ]; then
			log_tail="$(ui_log_tail_text "$log_file" 4)"
			if [ -n "$log_tail" ]; then
				body="$body

Recent log:
$log_tail"
			fi
		fi
		body="$body

Do not power off the machine while this step is running."
		ui_dialog_run --backtitle "$UI_BACKTITLE" --title "Install" --infobox "$body" 14 76 2>/dev/null || true
		return 0
	fi
	if ui_ansi_active; then
		ui_screen_begin "Install"
		ui_line "Stage: $stage"
		ui_install_progress_line "$stage"
		[ -n "$detail" ] && ui_line "$detail"
		ui_blank
		if [ -n "$log_file" ] && [ -r "$log_file" ]; then
			ui_line "Recent log:"
			ui_log_tail_lines "$log_file" 4 || true
			ui_blank
		fi
		ui_line "Do not power off the machine while this step is running."
		ui_rule
		ui_show_cursor
	else
		printf '[owrt-installer] stage: %s' "$stage"
		[ -n "$detail" ] && printf ' - %s' "$detail"
		printf '\n'
	fi
}

ui_failure_screen() {
	message="$1"
	log_file="${2:-}"
	if ui_dialog_active; then
		body="Installation failed:

$message"
		if [ -n "$log_file" ]; then
			body="$body

Log: $log_file"
		fi
		if [ -n "$log_file" ] && [ -r "$log_file" ]; then
			log_tail="$(ui_log_tail_text "$log_file" 5)"
			if [ -n "$log_tail" ]; then
				body="$body

Recent log:
$log_tail"
			fi
		fi
		body="$body

Return to shell and inspect the log before retrying."
		ui_dialog_run --backtitle "$UI_BACKTITLE" --title "Installation failed" --msgbox "$body" 0 0 2>/dev/null || true
		return 0
	fi
	if ui_ansi_active; then
		ui_screen_begin "Installation failed"
		ui_line_error "ERROR: $message"
		[ -n "$log_file" ] && ui_line "Log: $log_file"
		if [ -n "$log_file" ] && [ -r "$log_file" ]; then
			ui_blank
			ui_line "Recent log:"
			ui_log_tail_lines "$log_file" 5 || true
		fi
		ui_blank
		ui_line "Press Enter to return to shell."
		ui_rule
		ui_show_cursor
		if [ -t 0 ]; then
			IFS= read -r ignored || true
		fi
	else
		printf '\n[owrt-installer] ERROR: %s\n' "$message" >&2
		[ -n "$log_file" ] && printf '[owrt-installer] Log: %s\n' "$log_file" >&2
		if [ -n "$log_file" ] && [ -r "$log_file" ]; then
			printf '[owrt-installer] Recent log:\n' >&2
			tail -n 5 "$log_file" >&2 2>/dev/null || true
		fi
	fi
}

ui_success_screen() {
	message="$1"
	ui_ready_marker "Installation success"
	if ui_dialog_active; then
		ui_dialog_run --backtitle "$UI_BACKTITLE" --title "Installation completed" --msgbox "$message" 0 0 ||
			true
		return 0
	fi
	if ui_ansi_active; then
		ui_screen_begin "Installation completed"
		printf '%s|%s ' "$C_BLUE" "$C_RESET"
		printf '%s%s' "$C_GREEN" "$C_BOLD"
		ui_print_padded "$message"
		printf '%s %s|%s\n' "$C_RESET" "$C_BLUE" "$C_RESET"
		ui_rule
		ui_show_cursor
	else
		printf '\n%s\n\n' "$message"
	fi
}
