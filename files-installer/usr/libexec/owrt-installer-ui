# shellcheck shell=sh
# shellcheck disable=SC2034,SC2154

UI_MODE_ACTUAL="line"
UI_WIDTH=80
UI_HEIGHT=25
UI_INNER_WIDTH=76
UI_CURSOR_HIDDEN=0

ui_repeat() {
	char="$1"
	count="$2"
	while [ "$count" -gt 0 ]; do
		printf '%s' "$char"
		count=$((count - 1))
	done
}

ui_text_len() {
	printf '%s' "$1" | wc -c | tr -d ' '
}

ui_trunc() {
	text="$1"
	max="$2"
	if [ "$max" -le 0 ]; then
		return 0
	fi
	printf '%s' "$text" | cut -c 1-"$max"
}

ui_print_padded() {
	text="$(ui_trunc "$1" "$UI_INNER_WIDTH")"
	len="$(ui_text_len "$text")"
	printf '%s' "$text"
	if [ "$len" -lt "$UI_INNER_WIDTH" ]; then
		ui_repeat ' ' "$((UI_INNER_WIDTH - len))"
	fi
}

ui_terminal_size() {
	UI_WIDTH=80
	UI_HEIGHT=25
	if [ -t 1 ] && command -v stty >/dev/null 2>&1; then
		size="$(stty size 2>/dev/null || true)"
		rows="${size%% *}"
		cols="${size#* }"
		case "$rows" in
			""|*[!0-9]*) rows=25 ;;
		esac
		case "$cols" in
			""|*[!0-9]*) cols=80 ;;
		esac
		[ "$rows" -gt 0 ] || rows=25
		[ "$cols" -gt 0 ] || cols=80
		UI_HEIGHT="$rows"
		UI_WIDTH="$cols"
	fi
	[ "$UI_WIDTH" -gt 100 ] && UI_WIDTH=100
	[ "$UI_WIDTH" -lt 60 ] && UI_WIDTH=60
	UI_INNER_WIDTH=$((UI_WIDTH - 4))
}

ui_is_serial() {
	tty_path="$(tty 2>/dev/null || true)"
	case "$tty_path" in
		/dev/ttyS*|/dev/ttyAMA*|/dev/hvc*|/dev/ttyUSB*)
			return 0
			;;
	esac
	return 1
}

setup_ui() {
	C_RESET=""
	C_BOLD=""
	C_DIM=""
	C_RED=""
	C_GREEN=""
	C_YELLOW=""
	C_BLUE=""
	C_REVERSE=""
	UI_MODE_ACTUAL="line"
	ui_terminal_size

	if [ -t 1 ] && [ "${TERM:-dumb}" != "dumb" ]; then
		C_RESET="$(printf '\033[0m')"
		C_BOLD="$(printf '\033[1m')"
		C_DIM="$(printf '\033[2m')"
		C_RED="$(printf '\033[31m')"
		C_GREEN="$(printf '\033[32m')"
		C_YELLOW="$(printf '\033[33m')"
		C_BLUE="$(printf '\033[36m')"
		C_REVERSE="$(printf '\033[7m')"
	fi

	case "${OWRT_UI_MODE:-auto}" in
		line)
			UI_MODE_ACTUAL="line"
			;;
		ansi|dialog)
			if [ -t 0 ] && [ -t 1 ] && [ "${TERM:-dumb}" != "dumb" ]; then
				UI_MODE_ACTUAL="ansi"
			fi
			;;
		auto|"")
			if [ -t 0 ] && [ -t 1 ] && [ "${TERM:-dumb}" != "dumb" ] &&
				! ui_is_serial && [ "$UI_WIDTH" -ge 80 ] && [ "$UI_HEIGHT" -ge 20 ]; then
				UI_MODE_ACTUAL="ansi"
			fi
			;;
		*)
			UI_MODE_ACTUAL="line"
			;;
	esac
}

ui_ansi_active() {
	[ "$UI_MODE_ACTUAL" = "ansi" ]
}

ui_leave() {
	if [ "$UI_CURSOR_HIDDEN" = "1" ]; then
		printf '\033[?25h'
		UI_CURSOR_HIDDEN=0
	fi
	if ui_ansi_active; then
		printf '\033[?1000l\033[?1006l' 2>/dev/null || true
	fi
}

clear_screen() {
	if ui_ansi_active; then
		printf '\033[2J\033[H'
	fi
}

ui_hide_cursor() {
	if ui_ansi_active; then
		printf '\033[?25l'
		UI_CURSOR_HIDDEN=1
	fi
}

ui_show_cursor() {
	if ui_ansi_active; then
		printf '\033[?25h'
		UI_CURSOR_HIDDEN=0
	fi
}

ui_rule() {
	printf '%s+%s+%s\n' "$C_BLUE" "$(ui_repeat '-' "$((UI_WIDTH - 2))")" "$C_RESET"
}

ui_line() {
	printf '%s|%s ' "$C_BLUE" "$C_RESET"
	ui_print_padded "$1"
	printf ' %s|%s\n' "$C_BLUE" "$C_RESET"
}

ui_line_selected() {
	printf '%s|%s ' "$C_BLUE" "$C_RESET"
	printf '%s%s' "$C_REVERSE" "$C_YELLOW"
	ui_print_padded "$1"
	printf '%s %s|%s\n' "$C_RESET" "$C_BLUE" "$C_RESET"
}

ui_blank() {
	ui_line ""
}

ui_step_name() {
	title="$1"
	case "$title" in
		*disk*|*Disk*) printf '%s\n' "DISK" ;;
		*LAN*) printf '%s\n' "LAN" ;;
		*WAN*|*PPPoE*|*Static*) printf '%s\n' "WAN" ;;
		*summary*|*Summary*|*Review*|*ERASE*|*erase*) printf '%s\n' "REVIEW" ;;
		*completed*|*Completed*|*Install*) printf '%s\n' "INSTALL" ;;
		*) printf '%s\n' "READY" ;;
	esac
}

ui_steps_text() {
	active="$1"
	out="Steps:"
	for step in DISK LAN WAN REVIEW INSTALL; do
		if [ "$step" = "$active" ]; then
			out="$out [$step]"
		else
			out="$out  $step "
		fi
		[ "$step" = "INSTALL" ] || out="$out ->"
	done
	printf '%s\n' "$out"
}

ui_header() {
	version="${INSTALLER_VERSION:-unknown}"
	ui_rule
	ui_line "OPENWRT HELLFORGE INSTALLER                                      $version"
	ui_rule
}

ui_screen_begin() {
	title="$1"
	clear_screen
	ui_hide_cursor
	ui_header
	ui_line "$(ui_steps_text "$(ui_step_name "$title")")"
	ui_rule
	ui_line "$title"
	ui_rule
}

ui_footer() {
	ui_rule
	ui_line "Up/Down Move  Enter Select  q Cancel"
	ui_rule
}

section() {
	title="$1"
	if ui_ansi_active; then
		ui_screen_begin "$title"
	else
		printf '\n%s%s%s%s\n' "$C_BLUE" "$C_BOLD" "$title" "$C_RESET"
		printf '%s\n' "------------------------------------------------------------"
	fi
}

can_arrow_menu() {
	ui_ansi_active &&
		[ -t 0 ] && [ -t 1 ] &&
		[ "${TERM:-dumb}" != "dumb" ] &&
		command -v stty >/dev/null 2>&1
}

menu_reset() {
	: > "$MENU_LIST"
	MENU_NOTE=""
}

menu_note() {
	MENU_NOTE="$1"
}

menu_add() {
	value="$1"
	label="$2"
	printf '%s|%s\n' "$value" "$label" >> "$MENU_LIST"
}

menu_count() {
	wc -l < "$MENU_LIST" | tr -d ' '
}

menu_value_at() {
	sed -n "${1}s/|.*//p" "$MENU_LIST"
}

menu_label_at() {
	sed -n "${1}s/^[^|]*|//p" "$MENU_LIST"
}

ui_note_lines() {
	text="$1"
	max="$UI_INNER_WIDTH"
	while [ -n "$text" ]; do
		ui_line "$(ui_trunc "$text" "$max")"
		text="$(printf '%s' "$text" | cut -c $((max + 1))-)"
	done
}

render_numbered_menu() {
	if [ -n "$MENU_NOTE" ]; then
		if ui_ansi_active; then
			ui_note_lines "$MENU_NOTE"
			ui_blank
		else
			printf '%s\n\n' "$MENU_NOTE"
		fi
	fi
	number=0
	while IFS='|' read -r value label; do
		[ -n "$value" ] || continue
		number=$((number + 1))
		if ui_ansi_active; then
			ui_line "[$number] $label"
		else
			printf '[%s] %s\n' "$number" "$label"
		fi
	done < "$MENU_LIST"
}

render_arrow_menu() {
	title="$1"
	selected="$2"
	count="$(menu_count)"
	ui_terminal_size
	ui_screen_begin "$title"

	if [ -n "$MENU_NOTE" ]; then
		ui_note_lines "$MENU_NOTE"
		ui_blank
	fi

	max_items=$((UI_HEIGHT - 12))
	[ "$max_items" -lt 5 ] && max_items=5
	[ "$max_items" -gt 12 ] && max_items=12
	top=1
	if [ "$selected" -gt "$max_items" ]; then
		top=$((selected - max_items + 1))
	fi
	end=$((top + max_items - 1))

	if [ "$top" -gt 1 ]; then
		ui_line "  ... more above ..."
	fi

	number=0
	while IFS='|' read -r value label; do
		[ -n "$value" ] || continue
		number=$((number + 1))
		[ "$number" -lt "$top" ] && continue
		[ "$number" -gt "$end" ] && continue
		if [ "$number" -eq "$selected" ]; then
			ui_line_selected "> $label"
		else
			ui_line "  $label"
		fi
	done < "$MENU_LIST"

	if [ "$end" -lt "$count" ]; then
		ui_line "  ... more below ..."
	fi
	ui_footer
}

read_one_key() {
	dd bs=1 count=1 2>/dev/null || true
}

ui_restore_tty() {
	if [ -n "$TTY_STATE" ]; then
		stty "$TTY_STATE" 2>/dev/null || true
		TTY_STATE=""
	fi
	ui_show_cursor
}

select_from_menu() {
	title="$1"
	prompt="$2"
	count="$(menu_count)"
	[ "$count" -gt 0 ] || die "No choices available for $prompt"

	if can_arrow_menu; then
		selected=1
		esc="$(printf '\033')"
		TTY_STATE="$(stty -g)"
		stty -icanon -echo min 1 time 0
		while :; do
			render_arrow_menu "$title" "$selected"
			key="$(read_one_key)"
			if [ "$key" = "$esc" ]; then
				key2="$(read_one_key)"
				key3="$(read_one_key)"
				case "$key2$key3" in
					"[A")
						[ "$selected" -gt 1 ] && selected=$((selected - 1))
						;;
					"[B")
						[ "$selected" -lt "$count" ] && selected=$((selected + 1))
						;;
				esac
				continue
			fi
			case "$key" in
				q|Q)
					ui_restore_tty
					die "Selection cancelled"
					;;
				"")
					ui_restore_tty
					SELECTED_VALUE="$(menu_value_at "$selected")"
					MENU_NOTE=""
					clear_screen
					return 0
					;;
			esac
		done
	fi

	section "$title"
	render_numbered_menu
	printf '\nEnter %s number: ' "$prompt"
	IFS= read -r choice
	case "$choice" in
		*[!0-9]*|"") die "Invalid $prompt selection" ;;
	esac
	SELECTED_VALUE="$(menu_value_at "$choice")"
	[ -n "$SELECTED_VALUE" ] || die "Invalid $prompt selection"
	MENU_NOTE=""
}

prompt_default() {
	label="$1"
	default="$2"
	if ui_ansi_active; then
		ui_screen_begin "$label"
		ui_line "Default: $default"
		ui_blank
		ui_line "Type a new value or press Enter to keep the default."
		ui_rule
		ui_show_cursor
	fi
	printf '%s [%s]: ' "$label" "$default"
	IFS= read -r answer
	SELECTED_INPUT="${answer:-$default}"
}

prompt_secret() {
	label="$1"
	if ui_ansi_active; then
		ui_screen_begin "$label"
		ui_line "Input is hidden."
		ui_rule
		ui_show_cursor
	fi
	printf '%s: ' "$label"
	if [ -t 0 ] && command -v stty >/dev/null 2>&1; then
		TTY_STATE="$(stty -g)"
		stty -echo
		IFS= read -r SELECTED_INPUT
		stty "$TTY_STATE" 2>/dev/null || true
		TTY_STATE=""
		printf '\n'
	else
		IFS= read -r SELECTED_INPUT
	fi
}

ui_welcome_screen() {
	version="$1"
	auto_started="$2"
	if ui_ansi_active; then
		ui_screen_begin "Welcome"
		ui_line "OpenWrt x86 Installer $version"
		ui_blank
		if [ "$auto_started" = "1" ]; then
			ui_line "Autostart mode: installer launched from the boot console."
		fi
		ui_line "This installer writes a prebuilt OpenWrt image to a disk."
		ui_line "The selected disk will be erased only after final confirmation."
		ui_rule
		ui_show_cursor
	else
		clear_screen
		printf '\nOpenWrt x86 Installer %s\n\n' "$version"
		[ "$auto_started" = "1" ] && printf 'Autostart mode: installer launched from boot console.\n\n'
		printf 'This installer writes a prebuilt OpenWrt image to a disk.\n'
		printf 'The selected disk will be erased completely.\n\n'
	fi
}

ui_notice() {
	title="$1"
	message="$2"
	if ui_ansi_active; then
		ui_screen_begin "$title"
		ui_line "$message"
		ui_blank
		ui_line "Press Enter to continue."
		ui_rule
		ui_show_cursor
		IFS= read -r ignored || true
	else
		printf '\n%s\n' "$message"
	fi
}

ui_summary_screen() {
	ui_ansi_active || return 1
	ui_screen_begin "Review installation"
	ui_line "Target disk: $TARGET"
	if [ "$SKIP_NETWORK" = "1" ]; then
		ui_line "Network: keep OpenWrt defaults"
	else
		ui_line "LAN: ${LAN_DEV:-selected-by-mac} $LAN_MAC"
		ui_line "WAN: ${WAN_DEV:-selected-by-mac} $WAN_MAC"
		ui_line "LAN address: $LAN_IP/$LAN_CIDR"
		case "$WAN_PROTO" in
			dhcp) ui_line "WAN IPv4: DHCP client" ;;
			pppoe) ui_line "WAN IPv4: PPPoE user=$WAN_PPP_USERNAME" ;;
			static) ui_line "WAN IPv4: static $WAN_IPADDR/$WAN_CIDR gateway=${WAN_GATEWAY:-none}" ;;
			disabled) ui_line "WAN IPv4: disabled" ;;
		esac
		ui_line "WAN IPv6: $(wan6_label "$WAN6_PROTO")"
		[ "$WAN_PROTO" = "disabled" ] || ui_line "NAT: enabled"
	fi
	ui_blank
	printf '%s|%s ' "$C_BLUE" "$C_RESET"
	printf '%s%s' "$C_RED" "$C_BOLD"
	ui_print_padded "ALL DATA ON $TARGET WILL BE ERASED."
	printf '%s %s|%s\n' "$C_RESET" "$C_BLUE" "$C_RESET"
	ui_rule
	ui_show_cursor
	return 0
}

ui_confirm_erase_screen() {
	expected="$1"
	if ui_ansi_active; then
		ui_screen_begin "Final erase confirmation"
		printf '%s|%s ' "$C_BLUE" "$C_RESET"
		printf '%s%s' "$C_RED" "$C_BOLD"
		ui_print_padded "DESTRUCTIVE ACTION"
		printf '%s %s|%s\n' "$C_RESET" "$C_BLUE" "$C_RESET"
		ui_line "Type the exact confirmation string to start writing the image."
		ui_blank
		ui_line "$expected"
		ui_rule
		ui_show_cursor
	fi
}

ui_install_stage() {
	stage="$1"
	detail="$2"
	if ui_ansi_active; then
		ui_screen_begin "Install"
		ui_line "Stage: $stage"
		[ -n "$detail" ] && ui_line "$detail"
		ui_blank
		ui_line "Do not power off the machine while this step is running."
		ui_rule
		ui_show_cursor
	fi
}

ui_success_screen() {
	message="$1"
	if ui_ansi_active; then
		ui_screen_begin "Installation completed"
		printf '%s|%s ' "$C_BLUE" "$C_RESET"
		printf '%s%s' "$C_GREEN" "$C_BOLD"
		ui_print_padded "$message"
		printf '%s %s|%s\n' "$C_RESET" "$C_BLUE" "$C_RESET"
		ui_rule
		ui_show_cursor
	else
		printf '\n%s\n\n' "$message"
	fi
}
