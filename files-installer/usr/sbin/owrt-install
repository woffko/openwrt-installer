#!/bin/sh

set -eu

INSTALLER_VERSION="v1.0-alpha.11"
PAYLOAD="/usr/share/owrt-installer/target.img.gz"
MANIFEST="/usr/share/owrt-installer/manifest.json"
EMBEDDED_PAYLOAD="$PAYLOAD"
EMBEDDED_MANIFEST="$MANIFEST"
NETWORK_APPLIER="/usr/share/owrt-installer/98-installer-network"
OPENWRT_RELEASE_KEY="/usr/share/owrt-installer/keys/openwrt-release.usign.pub"
TARGET_MOUNT="/mnt/target"

tmp_file() {
	if command -v mktemp >/dev/null 2>&1; then
		mktemp "${TMPDIR:-/tmp}/owrt-installer-$1.XXXXXX"
	else
		printf '%s\n' "${TMPDIR:-/tmp}/owrt-installer-$1.$$"
	fi
}

DISK_LIST="$(tmp_file disks)"
NIC_LIST="$(tmp_file nics)"
NIC_CHOICE_LIST="$(tmp_file nic-choices)"
MENU_LIST="$(tmp_file menu)"
CONFIG_IMPORT_PARTITION_LIST="$(tmp_file import-partitions)"
CONFIG_IMPORT_ARCHIVE_LIST="$(tmp_file import-archives)"
CONFIG_IMPORT_SCAN_LIST="$(tmp_file import-scan)"
STORAGE_PARTITION_LIST="$(tmp_file storage-partitions)"
TARGET_MOUNT_LIST="$(tmp_file target-mounts)"
INSTALL_LOG="${TMPDIR:-/tmp}/owrt-installer.log"

TARGET=""
TARGET_DISK_DESCRIPTION=""
LAN_MAC=""
WAN_MAC=""
LAN_DEV=""
WAN_DEV=""
LAN_IP="192.168.1.1"
LAN_CIDR="24"
LAN_NETMASK="255.255.255.0"
