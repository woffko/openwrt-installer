WAN_NETMASK=""
WAN_GATEWAY=""
WAN_DNS=""
ALLOW_REMOVABLE=0
ASSUME_YES=0
AUTO_STARTED=0
DRY_RUN=0
SKIP_NETWORK=0
DOWNLOAD_LATEST=0
CHECK_LATEST=0
TARGET_MOUNTED=0
INSTALL_MODE="clean"
NETWORK_SOURCE="wizard"
CONFIG_IMPORT_SOURCE_REQUEST=""
CONFIG_IMPORT_POLICY_REQUEST=""
CONFIG_IMPORT_NETWORK_REQUEST=""
CONFIG_IMPORT_WORKDIR=""
CONFIG_IMPORT_MOUNTDIR=""
CONFIG_IMPORT_MOUNTED=0
CONFIG_IMPORT_ARCHIVE=""
CONFIG_IMPORT_APPLY_DIR=""
CONFIG_IMPORT_DEVICE=""
CONFIG_IMPORT_FSTYPE=""
CONFIG_IMPORT_SOURCE_PATH=""
CONFIG_IMPORT_SOURCE_LABEL=""
CONFIG_IMPORT_SHA256=""
CONFIG_IMPORT_COMPRESSED_SIZE=""
CONFIG_IMPORT_UNPACKED_SIZE=""
CONFIG_IMPORT_MEMBER_COUNT=""
CONFIG_IMPORT_POLICY="config-only"
CONFIG_IMPORT_HAS_NETWORK=0
CONFIG_IMPORT_ERROR=""
CONFIG_IMPORT_MAX_COMPRESSED_BYTES="${OWRT_IMPORT_MAX_COMPRESSED_BYTES:-67108864}"
CONFIG_IMPORT_MAX_UNPACKED_BYTES="${OWRT_IMPORT_MAX_UNPACKED_BYTES:-134217728}"
CONFIG_IMPORT_MAX_MEMBER_BYTES="${OWRT_IMPORT_MAX_MEMBER_BYTES:-33554432}"
CONFIG_IMPORT_MAX_MEMBERS="${OWRT_IMPORT_MAX_MEMBERS:-8192}"
CONFIG_IMPORT_RAM_RESERVE_BYTES="${OWRT_IMPORT_RAM_RESERVE_BYTES:-67108864}"
TTY_STATE=""
MENU_NOTE=""
CLEANED_UP=0
LOCAL_MOUSE_ACTIVE=0
LOCAL_MOUSE_HELPER="${OWRT_LOCAL_MOUSE_HELPER:-/usr/libexec/owrt-installer-local-mouse}"
WRITE_GZIP_PID=""
WRITE_PV_PID=""
WRITE_DD_PID=""
WRITE_SOURCE_FIFO=""
WRITE_OUTPUT_FIFO=""
WRITE_PROGRESS_FIFO=""
PAYLOAD_SOURCE_ID="embedded"
PAYLOAD_SOURCE_LABEL="Embedded installer image"
PAYLOAD_VERSION=""
PAYLOAD_FILENAME="target.img.gz"
PAYLOAD_IMAGE_TYPE="ext4-combined-efi"
PAYLOAD_BOOT_MODE="BIOS/UEFI"
PAYLOAD_URL="offline"
PAYLOAD_COMPRESSED_SIZE=""
PAYLOAD_RAM_AVAILABLE=""
PAYLOAD_RAM_REQUIRED=""
NETINSTALL_WORKDIR=""
NETINSTALL_NETWORK_BACKED_UP=0
NETINSTALL_ERROR=""
NETINSTALL_DEV=""
NETINSTALL_PROTO="dhcp"
NETINSTALL_IPADDR=""
NETINSTALL_CIDR="24"
NETINSTALL_NETMASK=""
NETINSTALL_GATEWAY=""
NETINSTALL_DNS=""
NETINSTALL_PPP_USERNAME=""
NETINSTALL_PPP_PASSWORD=""
NETINSTALL_AUTO_DHCP_ATTEMPTED=0
STORAGE_LAYOUT="fill"
STORAGE_LAYOUT_REQUEST=""
ROOTFS_TARGET_MIB=""
STORAGE_ERROR=""
STORAGE_TABLE_TYPE=""
STORAGE_PAYLOAD_SECTOR_SIZE=0
STORAGE_BOOT_START_SECTOR=""
STORAGE_BOOT_END_SECTOR=""
