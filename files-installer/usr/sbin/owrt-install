RESCUE_SCOPE_REQUEST=""

C_RESET=""
C_BOLD=""
C_DIM=""
C_RED=""
C_GREEN=""
C_YELLOW=""
C_BLUE=""
C_REVERSE=""

append_install_log() {
	[ -n "${INSTALL_LOG:-}" ] || return 0
	ts="$(date '+%H:%M:%S' 2>/dev/null)" || ts="--:--:--"
	printf '%s %s\n' "$ts" "$*" >> "$INSTALL_LOG" 2>/dev/null || true
}

autostart_serial_marker() {
	[ "$AUTO_STARTED" = "1" ] || return 0
	[ -w /dev/ttyS0 ] || return 0
	printf '%s\n' "$1" > /dev/ttyS0 2>/dev/null || true
}

ui_manages_screen() {
	if command -v ui_ansi_active >/dev/null 2>&1 && ui_ansi_active; then
		return 0
	fi
	if command -v ui_dialog_active >/dev/null 2>&1 && ui_dialog_active; then
		return 0
	fi
	return 1
}

log() {
	append_install_log "INFO: $*"
	if ! ui_manages_screen; then
		printf '%s[owrt-installer]%s %s\n' "${C_GREEN:-}" "${C_RESET:-}" "$*"
	fi
	if command -v logger >/dev/null 2>&1; then
		logger -t owrt-installer "$*" 2>/dev/null || true
	fi
}

warn() {
	append_install_log "WARNING: $*"
	if ! ui_manages_screen; then
		printf '%s[owrt-installer] WARNING:%s %s\n' "${C_YELLOW:-}" "${C_RESET:-}" "$*" >&2
	fi
	if command -v logger >/dev/null 2>&1; then
		logger -t owrt-installer "WARNING: $*" 2>/dev/null || true
	fi
}

die() {
	append_install_log "ERROR: $*"
	if command -v logger >/dev/null 2>&1; then
		logger -t owrt-installer "ERROR: $*" 2>/dev/null || true
	fi
	if command -v ui_failure_screen >/dev/null 2>&1; then
		ui_failure_screen "$*" "$INSTALL_LOG"
	else
		printf '%s[owrt-installer] ERROR:%s %s\n' "${C_RED:-}" "${C_RESET:-}" "$*" >&2
	fi
	cleanup
	exit 1
}

run_or_die() {
	error="$1"
	shift
	"$@" >> "$INSTALL_LOG" 2>&1 || die "$error"
}

local_mouse_start() {
	[ "${OWRT_UI_NO_MOUSE:-0}" != "1" ] || return 0
	[ -x "$LOCAL_MOUSE_HELPER" ] || return 0
	if "$LOCAL_MOUSE_HELPER" start >> "$INSTALL_LOG" 2>&1; then
		LOCAL_MOUSE_ACTIVE=1
		autostart_serial_marker "OWRT_INSTALLER_LOCAL_MOUSE=active"
		autostart_serial_marker "OWRT_INSTALLER_LOCAL_MOUSE_SOCKET_MODE=600"
	else
		LOCAL_MOUSE_ACTIVE=0
		autostart_serial_marker "OWRT_INSTALLER_LOCAL_MOUSE=keyboard-fallback"
	fi
}

local_mouse_stop() {
	[ "$LOCAL_MOUSE_ACTIVE" = "1" ] || return 0
	"$LOCAL_MOUSE_HELPER" stop >> "$INSTALL_LOG" 2>&1 || true
	LOCAL_MOUSE_ACTIVE=0
	autostart_serial_marker "OWRT_INSTALLER_LOCAL_MOUSE=stopped"
}

cleanup() {
	[ "$CLEANED_UP" = "0" ] || return 0
	CLEANED_UP=1
	WAN_PPP_PASSWORD=""
	NETINSTALL_PPP_PASSWORD=""
	local_mouse_stop
	if command -v restore_netinstall_network >/dev/null 2>&1; then
		restore_netinstall_network
	fi
	if command -v storage_cleanup >/dev/null 2>&1; then
		storage_cleanup
	fi
	for write_pid in "$WRITE_GZIP_PID" "$WRITE_PV_PID" "$WRITE_DD_PID"; do
		case "$write_pid" in
			''|*[!0-9]*) ;;
			*) kill "$write_pid" >/dev/null 2>&1 || true ;;
		esac
	done
	for write_pid in "$WRITE_GZIP_PID" "$WRITE_PV_PID" "$WRITE_DD_PID"; do
		case "$write_pid" in
			''|*[!0-9]*) ;;
			*) wait "$write_pid" >/dev/null 2>&1 || true ;;
		esac
	done
	if command -v ui_leave >/dev/null 2>&1; then
		ui_leave
	fi
	if [ -n "$TTY_STATE" ]; then
		stty "$TTY_STATE" 2>/dev/null || true
	fi
	if [ "$TARGET_MOUNTED" = "1" ]; then
		umount "$TARGET_MOUNT" >/dev/null 2>&1 || true
	fi
	if [ "$CONFIG_IMPORT_MOUNTED" = "1" ]; then
		umount "$CONFIG_IMPORT_MOUNTDIR" >/dev/null 2>&1 ||
			umount -l "$CONFIG_IMPORT_MOUNTDIR" >/dev/null 2>&1 || true
		CONFIG_IMPORT_MOUNTED=0
	fi
	case "$CONFIG_IMPORT_MOUNTDIR" in
		"${TMPDIR:-/tmp}"/owrt-import-mnt.*) rmdir "$CONFIG_IMPORT_MOUNTDIR" 2>/dev/null || true ;;
	esac
	case "$CONFIG_IMPORT_WORKDIR" in
		"${TMPDIR:-/tmp}"/owrt-import.*) rm -rf "$CONFIG_IMPORT_WORKDIR" ;;
	esac
	rm -f "$DISK_LIST" "$NIC_LIST" "$NIC_CHOICE_LIST" "$MENU_LIST" \
		"$CONFIG_IMPORT_PARTITION_LIST" "$CONFIG_IMPORT_ARCHIVE_LIST" \
		"$CONFIG_IMPORT_SCAN_LIST" "$STORAGE_PARTITION_LIST" "$TARGET_MOUNT_LIST"
	for write_fifo in "$WRITE_SOURCE_FIFO" "$WRITE_OUTPUT_FIFO" "$WRITE_PROGRESS_FIFO"; do
		[ -n "$write_fifo" ] && rm -f "$write_fifo"
	done
	case "$NETINSTALL_WORKDIR" in
		"${TMPDIR:-/tmp}"/owrt-netinstall.*) rm -rf "$NETINSTALL_WORKDIR" ;;
	esac
	return 0
}

trap 'cleanup' EXIT
trap 'trap - EXIT; cleanup; exit 130' HUP INT TERM

UI_LIB="${UI_LIB:-/usr/libexec/owrt-installer-ui}"
if [ -r "$UI_LIB" ]; then
	# shellcheck source=/dev/null
	. "$UI_LIB"
else
	UI_LIB_LOCAL="$(CDPATH='' cd -- "$(dirname "$0")/.." && pwd)/libexec/owrt-installer-ui"
	# shellcheck source=files-installer/usr/libexec/owrt-installer-ui
	. "$UI_LIB_LOCAL"
fi

CONFIG_IMPORT_LIB="${CONFIG_IMPORT_LIB:-/usr/libexec/owrt-installer-config-import}"
if [ -r "$CONFIG_IMPORT_LIB" ]; then
	# shellcheck source=/dev/null
	. "$CONFIG_IMPORT_LIB"
else
	CONFIG_IMPORT_LIB_LOCAL="$(dirname "$UI_LIB")/owrt-installer-config-import"
	# shellcheck source=files-installer/usr/libexec/owrt-installer-config-import
	. "$CONFIG_IMPORT_LIB_LOCAL"
fi

STORAGE_LIB="${STORAGE_LIB:-/usr/libexec/owrt-installer-storage}"
if [ -r "$STORAGE_LIB" ]; then
	# shellcheck source=/dev/null
	. "$STORAGE_LIB"
else
	STORAGE_LIB_LOCAL="$(dirname "$UI_LIB")/owrt-installer-storage"
	# shellcheck source=files-installer/usr/libexec/owrt-installer-storage
	. "$STORAGE_LIB_LOCAL"
fi

usage() {
	cat <<'EOF'
Usage:
  owrt-install
  owrt-install --help
  owrt-install --list-disks
  owrt-install --list-nics
  owrt-install --target /dev/nvme0n1
  owrt-install --target /dev/nvme0n1 --lan-mac MAC --wan-mac MAC
  owrt-install --target /dev/nvme0n1 --skip-network-wizard
  owrt-install --target /dev/nvme0n1 --lan-ip 192.168.1.1/24 --wan-proto dhcp
  owrt-install --target /dev/nvme0n1 --wan-proto pppoe --pppoe-username USER --pppoe-password PASS
  owrt-install --target /dev/nvme0n1 --allow-removable
  owrt-install --target /dev/nvme0n1 --config-backup /path/to/backup.tar.gz
  owrt-install --target /dev/nvme0n1 --config-backup FILE --config-import-policy config-only
  owrt-install --target /dev/nvme0n1 --config-backup FILE --import-network keep
  owrt-install --target /dev/nvme0n1 --root-size fill
  owrt-install --target /dev/nvme0n1 --root-size image
  owrt-install --target /dev/nvme0n1 --root-size 8GiB
  owrt-install --target /dev/nvme0n1 --rescue-existing --rescue-scope config-only
  owrt-install --target /dev/nvme0n1 --yes-i-know-this-will-erase-data
  owrt-install --download-latest
  owrt-install --check-latest
  owrt-install --dry-run

The selected target disk will be erased completely.
Removable disks and the detected live boot disk are blocked by default.
--download-latest verifies an official signed OpenWrt x86 image in RAM before
the existing target selection, review, and exact ERASE confirmation flow.
--check-latest offers that download only when the official stable release is
newer than the embedded image; network failure falls back to the embedded image.
--config-backup accepts a standard OpenWrt sysupgrade .tar.gz, validates and
stages it in RAM, and applies it only after the target image has been written.
--root-size accepts fill, image, or an integer size in MiB/GiB. Unused disk
space remains unallocated. --rescue-existing requires an existing ext4 x86/64
OpenWrt installation on the selected disk and stages its configuration in RAM
before the disk is erased.
EOF
}

shell_quote() {
	printf "'"
	printf '%s' "$1" | sed "s/'/'\\\\''/g"
	printf "'"
}

lower() {
	printf '%s' "$1" | tr 'A-F' 'a-f'
}

is_ipv4() {
	printf '%s\n' "$1" |
		awk -F. '
			NF != 4 { exit 1 }
			{
				for (i = 1; i <= 4; i++) {
					if ($i !~ /^[0-9]+$/ || $i < 0 || $i > 255) {
						exit 1
					}
				}
				exit 0
			}
		'
}

is_cidr() {
	case "$1" in
		""|*[!0-9]*) return 1 ;;
	esac
	[ "$1" -ge 0 ] && [ "$1" -le 32 ]
}

cidr_to_netmask() {
	case "$1" in
		0) printf '%s\n' "0.0.0.0" ;;
		1) printf '%s\n' "128.0.0.0" ;;
		2) printf '%s\n' "192.0.0.0" ;;
		3) printf '%s\n' "224.0.0.0" ;;
		4) printf '%s\n' "240.0.0.0" ;;
		5) printf '%s\n' "248.0.0.0" ;;
		6) printf '%s\n' "252.0.0.0" ;;
		7) printf '%s\n' "254.0.0.0" ;;
		8) printf '%s\n' "255.0.0.0" ;;
		9) printf '%s\n' "255.128.0.0" ;;
		10) printf '%s\n' "255.192.0.0" ;;
		11) printf '%s\n' "255.224.0.0" ;;
		12) printf '%s\n' "255.240.0.0" ;;
		13) printf '%s\n' "255.248.0.0" ;;
		14) printf '%s\n' "255.252.0.0" ;;
		15) printf '%s\n' "255.254.0.0" ;;
		16) printf '%s\n' "255.255.0.0" ;;
		17) printf '%s\n' "255.255.128.0" ;;
		18) printf '%s\n' "255.255.192.0" ;;
		19) printf '%s\n' "255.255.224.0" ;;
		20) printf '%s\n' "255.255.240.0" ;;
		21) printf '%s\n' "255.255.248.0" ;;
		22) printf '%s\n' "255.255.252.0" ;;
		23) printf '%s\n' "255.255.254.0" ;;
		24) printf '%s\n' "255.255.255.0" ;;
		25) printf '%s\n' "255.255.255.128" ;;
		26) printf '%s\n' "255.255.255.192" ;;
		27) printf '%s\n' "255.255.255.224" ;;
		28) printf '%s\n' "255.255.255.240" ;;
		29) printf '%s\n' "255.255.255.248" ;;
		30) printf '%s\n' "255.255.255.252" ;;
		31) printf '%s\n' "255.255.255.254" ;;
		32) printf '%s\n' "255.255.255.255" ;;
		*) return 1 ;;
	esac
}

parse_cidr_address() {
	value="$1"
	default_cidr="$2"
	case "$value" in
		*/*)
			PARSED_IP="${value%/*}"
			PARSED_CIDR="${value#*/}"
			;;
		*)
			PARSED_IP="$value"
			PARSED_CIDR="$default_cidr"
			;;
	esac
	is_ipv4 "$PARSED_IP" || return 1
	is_cidr "$PARSED_CIDR" || return 1
	PARSED_NETMASK="$(cidr_to_netmask "$PARSED_CIDR")"
}

validate_dns_servers() {
	servers="$1"
	[ -n "$servers" ] || return 0
	for server in $servers; do
		is_ipv4 "$server" || return 1
	done
	return 0
}

trim_file() {
	file="$1"
	if [ -r "$file" ]; then
		tr '\n' ' ' < "$file" | sed 's/[[:space:]][[:space:]]*/ /g; s/^ //; s/ $//'
	else
		printf '%s' "unknown"
	fi
}

json_value() {
	key="$1"
	if command -v jsonfilter >/dev/null 2>&1; then
		jsonfilter -i "$MANIFEST" -e "@.$key"
	else
		sed -n "s/.*\"$key\"[[:space:]]*:[[:space:]]*\"\\([^\"]*\\)\".*/\\1/p" "$MANIFEST" |
			head -n 1
	fi
}

is_positive_integer() {
	case "$1" in
		''|*[!0-9]*|0) return 1 ;;
		*) return 0 ;;
	esac
}

release_version_relation() {
	awk -v candidate="$1" -v current="$2" 'BEGIN {
		if (candidate !~ /^[0-9]+\.[0-9]+\.[0-9]+$/ ||
			current !~ /^[0-9]+\.[0-9]+\.[0-9]+$/) {
			print "unknown"
			exit
		}
		split(candidate, a, ".")
		split(current, b, ".")
		for (i = 1; i <= 3; i++) {
			if ((a[i] + 0) > (b[i] + 0)) { print "newer"; exit }
			if ((a[i] + 0) < (b[i] + 0)) { print "older"; exit }
		}
		print "equal"
	}'
}

release_version_is_newer() {
	[ "$(release_version_relation "$1" "$2")" = "newer" ]
}

bytes_as_mib() {
	bytes_value="$1"
	printf '%s MiB' "$(((bytes_value + 1048575) / 1048576))"
}

reset_to_embedded_payload() {
	PAYLOAD="$EMBEDDED_PAYLOAD"
	MANIFEST="$EMBEDDED_MANIFEST"
	PAYLOAD_SOURCE_ID="embedded"
	PAYLOAD_SOURCE_LABEL="Embedded installer image"
	PAYLOAD_VERSION=""
	ui_set_payload_version ""
	PAYLOAD_FILENAME="target.img.gz"
	PAYLOAD_IMAGE_TYPE="ext4-combined-efi"
	PAYLOAD_BOOT_MODE="BIOS/UEFI"
	PAYLOAD_URL="offline"
	PAYLOAD_COMPRESSED_SIZE=""
	PAYLOAD_RAM_AVAILABLE=""
	PAYLOAD_RAM_REQUIRED=""
}

init_netinstall_workdir() {
	[ -n "$NETINSTALL_WORKDIR" ] && return 0
	command -v mktemp >/dev/null 2>&1 || {
		NETINSTALL_ERROR="mktemp is required for the RAM download workspace"
		return 1
	}
	NETINSTALL_WORKDIR="$(umask 077; mktemp -d "${TMPDIR:-/tmp}/owrt-netinstall.XXXXXX")" || {
		NETINSTALL_ERROR="Could not create the RAM download workspace"
		return 1
	}
}

netinstall_curl_get() {
	netinstall_url="$1"
	netinstall_output="$2"
	netinstall_timeout="${3:-30}"
	curl --fail --silent --show-error \
		--proto '=https' --tlsv1.2 \
		--connect-timeout 8 --max-time "$netinstall_timeout" \
		--output "$netinstall_output" "$netinstall_url" >> "$INSTALL_LOG" 2>&1
}

netinstall_curl_head() {
	netinstall_url="$1"
	netinstall_output="$2"
	curl --fail --silent --show-error \
		--proto '=https' --tlsv1.2 \
		--connect-timeout 8 --max-time 30 \
		--head --output /dev/null --dump-header "$netinstall_output" \
		"$netinstall_url" >> "$INSTALL_LOG" 2>&1
}

netinstall_stable_version() {
	versions_file="$NETINSTALL_WORKDIR/versions.json"
	versions_url="https://downloads.openwrt.org/.versions.json"
	if ! netinstall_curl_get "$versions_url" "$versions_file" 20; then
		NETINSTALL_ERROR="Could not reach the official OpenWrt release index over HTTPS. Check the uplink, DNS, and captive portal."
		return 1
	fi
	if command -v jsonfilter >/dev/null 2>&1; then
		NETINSTALL_STABLE_VERSION="$(jsonfilter -i "$versions_file" -e '@.stable_version' 2>/dev/null || true)"
	else
		NETINSTALL_STABLE_VERSION="$(sed -n 's/.*"stable_version"[[:space:]]*:[[:space:]]*"\([0-9.]*\)".*/\1/p' "$versions_file" | head -n 1)"
	fi
	if ! printf '%s\n' "$NETINSTALL_STABLE_VERSION" |
		grep -Eq '^[0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*$'; then
		NETINSTALL_ERROR="The official release index returned an invalid stable version."
		return 1
	fi
	return 0
}

netinstall_boot_mode() {
	if [ "${OWRT_NETINSTALL_TEST_MODE:-0}" = "1" ] &&
		[ -n "${OWRT_NETINSTALL_TEST_BOOT_MODE:-}" ]; then
		case "$OWRT_NETINSTALL_TEST_BOOT_MODE" in
			bios|uefi) printf '%s\n' "$OWRT_NETINSTALL_TEST_BOOT_MODE" ;;
			*) return 1 ;;
		esac
	elif [ -d /sys/firmware/efi ]; then
		printf '%s\n' "uefi"
	else
		printf '%s\n' "bios"
	fi
}

netinstall_mem_available_bytes() {
	if [ "${OWRT_NETINSTALL_TEST_MODE:-0}" = "1" ] &&
		is_positive_integer "${OWRT_NETINSTALL_TEST_MEM_AVAILABLE:-}"; then
		printf '%s\n' "$OWRT_NETINSTALL_TEST_MEM_AVAILABLE"
		return 0
	fi
	mem_available_kib="$(awk '$1 == "MemAvailable:" { print $2; exit }' /proc/meminfo 2>/dev/null || true)"
	is_positive_integer "$mem_available_kib" || return 1
	printf '%s\n' "$((mem_available_kib * 1024))"
}

validate_downloaded_layout() {
	layout_payload="$1"
	layout_size="$2"
	layout_mode="$3"
	if ! storage_inspect_payload_layout "$layout_payload" "$layout_size" "$layout_mode"; then
		NETINSTALL_ERROR="$STORAGE_ERROR"
		return 1
	fi
}

acquire_downloaded_payload() {
	for netinstall_cmd in curl usign sha256sum gzip stat fdisk dd awk grep; do
		command -v "$netinstall_cmd" >/dev/null 2>&1 || {
			NETINSTALL_ERROR="Required online-install command is missing: $netinstall_cmd"
			return 1
		}
	done
	[ -s "$OPENWRT_RELEASE_KEY" ] || {
		NETINSTALL_ERROR="Pinned OpenWrt release verification key is missing."
		return 1
	}
	init_netinstall_workdir || return 1

	ui_install_stage "Online release" "Checking the official stable OpenWrt release index over HTTPS." "$INSTALL_LOG"
	netinstall_stable_version || return 1
	netinstall_mode="$(netinstall_boot_mode)" || {
		NETINSTALL_ERROR="Could not determine BIOS or UEFI boot mode."
		return 1
	}
	case "$netinstall_mode" in
		uefi)
		netinstall_image_type="ext4-combined-efi"
		netinstall_boot_label="UEFI"
		;;
		bios)
		netinstall_image_type="ext4-combined"
		netinstall_boot_label="BIOS"
		;;
	esac
	netinstall_filename="openwrt-${NETINSTALL_STABLE_VERSION}-x86-64-generic-${netinstall_image_type}.img.gz"
	netinstall_base_url="https://downloads.openwrt.org/releases/${NETINSTALL_STABLE_VERSION}/targets/x86/64"
	netinstall_image_url="$netinstall_base_url/$netinstall_filename"
	netinstall_sums="$NETINSTALL_WORKDIR/sha256sums"
	netinstall_signature="$NETINSTALL_WORKDIR/sha256sums.sig"
	netinstall_headers="$NETINSTALL_WORKDIR/image.headers"
	netinstall_payload="$NETINSTALL_WORKDIR/target.img.gz"
	netinstall_manifest="$NETINSTALL_WORKDIR/manifest.json"

	ui_install_stage "Verify release" "Downloading and verifying the signed OpenWrt checksum manifest." "$INSTALL_LOG"
	netinstall_curl_get "$netinstall_base_url/sha256sums" "$netinstall_sums" 45 || {
		NETINSTALL_ERROR="Could not download the official OpenWrt checksum manifest."
		return 1
	}
	netinstall_curl_get "$netinstall_base_url/sha256sums.sig" "$netinstall_signature" 30 || {
		NETINSTALL_ERROR="Could not download the OpenWrt usign signature."
		return 1
	}
	if ! usign -V -m "$netinstall_sums" -x "$netinstall_signature" \
		-p "$OPENWRT_RELEASE_KEY" >> "$INSTALL_LOG" 2>&1; then
		NETINSTALL_ERROR="The OpenWrt checksum manifest signature is invalid."
		return 1
	fi
	autostart_serial_marker "OWRT_INSTALLER_NETINSTALL_SIGNATURE_VERIFIED=1"

	netinstall_hashes="$(awk -v wanted="*$netinstall_filename" '
		$2 == wanted && length($1) == 64 && $1 !~ /[^0-9a-f]/ { print $1 }
	' "$netinstall_sums")"
	netinstall_expected_sha="$(printf '%s\n' "$netinstall_hashes" | sed -n '1p')"
	if [ -z "$netinstall_expected_sha" ] ||
		[ -n "$(printf '%s\n' "$netinstall_hashes" | sed -n '2p')" ]; then
		NETINSTALL_ERROR="The signed checksum manifest does not contain exactly one expected x86 image entry."
		return 1
	fi

	netinstall_curl_head "$netinstall_image_url" "$netinstall_headers" || {
		NETINSTALL_ERROR="Could not obtain the official image size before allocating RAM."
		return 1
	}
	netinstall_content_length="$(tr -d '\r' < "$netinstall_headers" |
		awk 'tolower($1) == "content-length:" { value=$2 } END { print value }')"
	is_positive_integer "$netinstall_content_length" || {
		NETINSTALL_ERROR="The official image server did not provide a valid Content-Length."
		return 1
	}
	netinstall_max_image=1073741824
	[ "$netinstall_content_length" -le "$netinstall_max_image" ] || {
		NETINSTALL_ERROR="The advertised OpenWrt image exceeds the 1 GiB safety limit."
		return 1
	}
	netinstall_mem_available="$(netinstall_mem_available_bytes)" || {
		NETINSTALL_ERROR="Could not read MemAvailable for the RAM safety gate."
		return 1
	}
	netinstall_ram_reserve=268435456
	if [ "${OWRT_NETINSTALL_TEST_MODE:-0}" = "1" ] &&
		is_positive_integer "${OWRT_NETINSTALL_TEST_RAM_RESERVE:-}"; then
		netinstall_ram_reserve="$OWRT_NETINSTALL_TEST_RAM_RESERVE"
	fi
	netinstall_ram_required=$((netinstall_content_length + netinstall_ram_reserve))
	[ "$netinstall_mem_available" -ge "$netinstall_ram_required" ] || {
		NETINSTALL_ERROR="Insufficient RAM: $(bytes_as_mib "$netinstall_mem_available") available, $(bytes_as_mib "$netinstall_ram_required") required including reserve."
		return 1
	}

	ui_install_stage "Download image" "Downloading $netinstall_filename into RAM." "$INSTALL_LOG"
	if ! curl --fail --silent --show-error \
		--proto '=https' --tlsv1.2 \
		--connect-timeout 10 --max-time 900 \
		--max-filesize "$netinstall_content_length" \
		--output "$netinstall_payload" "$netinstall_image_url" >> "$INSTALL_LOG" 2>&1; then
		rm -f "$netinstall_payload"
		NETINSTALL_ERROR="The official OpenWrt image download failed or exceeded its advertised size."
		return 1
	fi
	netinstall_actual_size="$(stat -c '%s' "$netinstall_payload" 2>/dev/null || true)"
	[ "$netinstall_actual_size" = "$netinstall_content_length" ] || {
		rm -f "$netinstall_payload"
		NETINSTALL_ERROR="The downloaded image size does not match the preflight Content-Length."
		return 1
	}
	netinstall_actual_sha="$(sha256sum "$netinstall_payload" | awk '{ print $1 }')"
	[ "$netinstall_actual_sha" = "$netinstall_expected_sha" ] || {
		rm -f "$netinstall_payload"
		NETINSTALL_ERROR="The downloaded image SHA-256 does not match the signed manifest."
		return 1
	}
	if ! gzip -t "$netinstall_payload" >> "$INSTALL_LOG" 2>&1; then
		rm -f "$netinstall_payload"
		NETINSTALL_ERROR="The downloaded image has an invalid or truncated gzip stream."
		return 1
	fi
	netinstall_uncompressed_size="$(gzip -l "$netinstall_payload" 2>/dev/null |
		awk 'NR == 2 { print $2 }')"
	is_positive_integer "$netinstall_uncompressed_size" || {
		NETINSTALL_ERROR="Could not determine the downloaded image uncompressed size."
		return 1
	}
	validate_downloaded_layout "$netinstall_payload" "$netinstall_uncompressed_size" "$netinstall_mode" || return 1

	cat > "$netinstall_manifest" <<EOF_NETINSTALL_MANIFEST
{
  "installer_version": "$INSTALLER_VERSION",
  "openwrt_version": "$NETINSTALL_STABLE_VERSION",
  "target_arch": "x86_64",
  "target_profile": "generic",
  "image_type": "$netinstall_image_type",
  "payload_source": "downloaded-official",
  "payload_filename": "$netinstall_filename",
  "payload_sha256": "$netinstall_expected_sha",
  "payload_uncompressed_size": "$netinstall_uncompressed_size"
}
EOF_NETINSTALL_MANIFEST

	PAYLOAD="$netinstall_payload"
	MANIFEST="$netinstall_manifest"
	PAYLOAD_SOURCE_ID="downloaded-official"
	PAYLOAD_SOURCE_LABEL="Downloaded official OpenWrt"
	PAYLOAD_VERSION="$NETINSTALL_STABLE_VERSION"
	PAYLOAD_FILENAME="$netinstall_filename"
	PAYLOAD_IMAGE_TYPE="$netinstall_image_type"
	PAYLOAD_BOOT_MODE="$netinstall_boot_label"
	PAYLOAD_URL="$netinstall_image_url"
	PAYLOAD_COMPRESSED_SIZE="$netinstall_actual_size"
	PAYLOAD_RAM_AVAILABLE="$netinstall_mem_available"
	PAYLOAD_RAM_REQUIRED="$netinstall_ram_required"
	autostart_serial_marker "OWRT_INSTALLER_NETINSTALL_VERSION=$PAYLOAD_VERSION"
	autostart_serial_marker "OWRT_INSTALLER_NETINSTALL_IMAGE=$PAYLOAD_FILENAME"
	autostart_serial_marker "OWRT_INSTALLER_NETINSTALL_PAYLOAD_VERIFIED=1"
	NETINSTALL_ERROR=""
	return 0
}

restore_netinstall_network() {
	[ "$NETINSTALL_NETWORK_BACKED_UP" = "1" ] || return 0
	netinstall_network_backup="$NETINSTALL_WORKDIR/network.config"
	if [ -s "$netinstall_network_backup" ]; then
		cp "$netinstall_network_backup" /etc/config/network >> "$INSTALL_LOG" 2>&1 || true
		if [ -x /etc/init.d/network ]; then
			/etc/init.d/network restart >> "$INSTALL_LOG" 2>&1 || true
		fi
	fi
	NETINSTALL_NETWORK_BACKED_UP=0
}

backup_netinstall_network() {
	[ "$NETINSTALL_NETWORK_BACKED_UP" = "0" ] || return 0
	init_netinstall_workdir || return 1
	[ -s /etc/config/network ] || {
		NETINSTALL_ERROR="The live network configuration is missing."
		return 1
	}
	cp /etc/config/network "$NETINSTALL_WORKDIR/network.config" >> "$INSTALL_LOG" 2>&1 || {
		NETINSTALL_ERROR="Could not back up the live RAM network configuration."
		return 1
	}
	NETINSTALL_NETWORK_BACKED_UP=1
}

netinstall_has_default_route() {
	ip route show default 2>/dev/null | grep -q '^default' && return 0
	ip -6 route show default 2>/dev/null | grep -q '^default' && return 0
	return 1
}

apply_netinstall_network() {
	netinstall_wait_override="${1:-}"
	backup_netinstall_network || return 1
	: > /etc/config/network || {
		NETINSTALL_ERROR="Could not prepare the temporary live network configuration."
		restore_netinstall_network
		return 1
	}

	if ! {
		uci -q set network.loopback=interface
		uci -q set network.loopback.device='lo'
		uci -q set network.loopback.proto='static'
		uci -q set network.loopback.ipaddr='127.0.0.1'
		uci -q set network.loopback.netmask='255.0.0.0'
		uci -q set network.owrt_netinstall=interface
		uci -q set network.owrt_netinstall.device="$NETINSTALL_DEV"
		uci -q set network.owrt_netinstall.proto="$NETINSTALL_PROTO"
		case "$NETINSTALL_PROTO" in
			dhcp)
				uci -q set network.owrt_netinstall.peerdns='1'
				;;
			static)
				uci -q set network.owrt_netinstall.ipaddr="$NETINSTALL_IPADDR"
				uci -q set network.owrt_netinstall.netmask="$NETINSTALL_NETMASK"
				uci -q set network.owrt_netinstall.gateway="$NETINSTALL_GATEWAY"
				for netinstall_dns in $NETINSTALL_DNS; do
					uci -q add_list network.owrt_netinstall.dns="$netinstall_dns"
				done
				;;
			pppoe)
				uci -q set network.owrt_netinstall.username="$NETINSTALL_PPP_USERNAME"
				uci -q set network.owrt_netinstall.password="$NETINSTALL_PPP_PASSWORD"
				uci -q set network.owrt_netinstall.ipv6='auto'
				uci -q set network.owrt_netinstall.peerdns='1'
				;;
		esac
		uci -q commit network
	}; then
		NETINSTALL_ERROR="Could not create the temporary live uplink configuration."
		restore_netinstall_network
		return 1
	fi

	if ! /etc/init.d/network restart >> "$INSTALL_LOG" 2>&1; then
		NETINSTALL_ERROR="The live network service rejected the temporary uplink configuration."
		restore_netinstall_network
		return 1
	fi
	netinstall_wait="${netinstall_wait_override:-${OWRT_NETINSTALL_NETWORK_WAIT:-45}}"
	case "$netinstall_wait" in
		''|*[!0-9]*) netinstall_wait=45 ;;
	esac
	netinstall_elapsed=0
	while [ "$netinstall_elapsed" -lt "$netinstall_wait" ]; do
		if netinstall_has_default_route; then
			return 0
		fi
		sleep 1
		netinstall_elapsed=$((netinstall_elapsed + 1))
	done
	NETINSTALL_ERROR="The selected uplink did not obtain a default route within ${netinstall_wait}s."
	return 1
}

auto_configure_netinstall_dhcp() {
	refresh_nics
	netinstall_auto_count=0
	netinstall_auto_wait="${OWRT_NETINSTALL_AUTO_DHCP_WAIT:-12}"
	case "$netinstall_auto_wait" in
		''|*[!0-9]*) netinstall_auto_wait=12 ;;
	esac

	# Prefer interfaces with carrier, but also try devices whose link state is
	# not visible until the network service brings them up.
	for netinstall_link_pass in up down; do
		while IFS='|' read -r netinstall_auto_dev _; do
			[ -n "$netinstall_auto_dev" ] || continue
			ip link set dev "$netinstall_auto_dev" up >> "$INSTALL_LOG" 2>&1 || true
			netinstall_auto_link="$(get_nic_link "$netinstall_auto_dev")"
			case "$netinstall_link_pass:$netinstall_auto_link" in
				up:up|down:down) ;;
				*) continue ;;
			esac

			netinstall_auto_count=$((netinstall_auto_count + 1))
			NETINSTALL_DEV="$netinstall_auto_dev"
			NETINSTALL_PROTO="dhcp"
			ui_install_stage "Automatic DHCP" \
				"Trying temporary DHCP on $NETINSTALL_DEV for the official OpenWrt download." \
				"$INSTALL_LOG"
			if apply_netinstall_network "$netinstall_auto_wait"; then
				NETINSTALL_AUTO_DHCP_ATTEMPTED=1
				autostart_serial_marker "OWRT_INSTALLER_NETINSTALL_AUTO_DHCP=$NETINSTALL_DEV"
				return 0
			fi
		done < "$NIC_LIST"
	done

	NETINSTALL_AUTO_DHCP_ATTEMPTED=1
	restore_netinstall_network
	NETINSTALL_ERROR="Automatic DHCP did not obtain a default route on any of the $netinstall_auto_count detected Ethernet interfaces."
	return 1
}

select_netinstall_uplink() {
	refresh_nics
	build_nic_menu
	menu_note "This temporary uplink is used only to download and verify the official image. Installed LAN/WAN settings are selected later."
	menu_add "__back" "Back to online source options"
	select_from_menu "Select download uplink" "download uplink"
	[ "$SELECTED_VALUE" != "__back" ] || return 2
	NETINSTALL_DEV="${SELECTED_VALUE%%,*}"
	return 0
}

select_netinstall_mode() {
	menu_reset
	menu_note "Choose how the live installer should reach the official OpenWrt download server."
	menu_add "dhcp" "DHCP client"
	menu_add "static" "Static IPv4"
	menu_add "pppoe" "PPPoE"
	menu_add "__back" "Back to uplink selection"
	select_from_menu "Select download network mode" "download network mode"
	NETINSTALL_SELECTED_PROTO="$SELECTED_VALUE"
}

select_netinstall_static() {
	netinstall_form_error=""
	while :; do
		prompt_default \
			"Download uplink IPv4/CIDR" \
			"${NETINSTALL_IPADDR:-192.0.2.2}/$NETINSTALL_CIDR" \
			"Download static IPv4" \
			"Example: 192.0.2.2/24" \
			"$netinstall_form_error" \
			"This configuration exists only in the live installer RAM."
		[ "$UI_INPUT_ACTION" != "back" ] || return 2
		if parse_cidr_address "$SELECTED_INPUT" "$NETINSTALL_CIDR"; then
			NETINSTALL_IPADDR="$PARSED_IP"
			NETINSTALL_CIDR="$PARSED_CIDR"
			NETINSTALL_NETMASK="$PARSED_NETMASK"
			break
		fi
		netinstall_form_error="Invalid IPv4/CIDR value."
	done

	netinstall_form_error=""
	while :; do
		prompt_default \
			"Download uplink gateway" \
			"${NETINSTALL_GATEWAY:-}" \
			"Download static IPv4" \
			"Example: 192.0.2.1" \
			"$netinstall_form_error" \
			"A gateway is required for the online download path."
		[ "$UI_INPUT_ACTION" != "back" ] || return 2
		if is_ipv4 "$SELECTED_INPUT"; then
			NETINSTALL_GATEWAY="$SELECTED_INPUT"
			break
		fi
		netinstall_form_error="A valid IPv4 gateway is required."
	done

	netinstall_form_error=""
	while :; do
		prompt_default \
			"Download uplink DNS servers" \
			"${NETINSTALL_DNS:-1.1.1.1}" \
			"Download static IPv4" \
			"Example: 1.1.1.1 8.8.8.8" \
			"$netinstall_form_error" \
			"At least one DNS server is required for HTTPS release discovery."
		[ "$UI_INPUT_ACTION" != "back" ] || return 2
		if [ -n "$SELECTED_INPUT" ] && validate_dns_servers "$SELECTED_INPUT"; then
			NETINSTALL_DNS="$SELECTED_INPUT"
			return 0
		fi
		netinstall_form_error="Enter one or more valid IPv4 DNS servers."
	done
}

select_netinstall_pppoe() {
	netinstall_pppoe_state="username"
	netinstall_form_error=""
	while :; do
		case "$netinstall_pppoe_state" in
			username)
				prompt_default \
					"Download PPPoE username" \
					"${NETINSTALL_PPP_USERNAME:-}" \
					"Download PPPoE username" \
					"Example: user@example.net" \
					"$netinstall_form_error" \
					"Step 1 of 2. This temporary credential is cleared when the installer exits."
				[ "$UI_INPUT_ACTION" != "back" ] || return 2
				if [ -n "$SELECTED_INPUT" ]; then
					NETINSTALL_PPP_USERNAME="$SELECTED_INPUT"
					netinstall_form_error=""
					netinstall_pppoe_state="password"
				else
					netinstall_form_error="PPPoE username is required."
				fi
				;;
			password)
				prompt_secret \
					"Download PPPoE password" \
					"Download PPPoE password" \
					"" \
					"Step 2 of 2.
Input is hidden and used only for this temporary live uplink.
Leave it empty only if your ISP explicitly requires no password." \
					"${NETINSTALL_PPP_PASSWORD:-}"
				if [ "$UI_INPUT_ACTION" = "back" ]; then
					netinstall_pppoe_state="username"
					continue
				fi
				NETINSTALL_PPP_PASSWORD="$SELECTED_INPUT"
				return 0
				;;
		esac
	done
}

configure_netinstall_network() {
	while :; do
		if select_netinstall_uplink; then
			:
		else
			netinstall_select_status=$?
			[ "$netinstall_select_status" -eq 2 ] && return 2
			return "$netinstall_select_status"
		fi
		while :; do
			select_netinstall_mode
			case "$NETINSTALL_SELECTED_PROTO" in
				__back) break ;;
				dhcp)
					NETINSTALL_PROTO="dhcp"
					break
					;;
				static)
					if select_netinstall_static; then
						NETINSTALL_PROTO="static"
						break
					else
						netinstall_form_status=$?
					fi
					[ "$netinstall_form_status" -eq 2 ] || return "$netinstall_form_status"
					;;
				pppoe)
					if select_netinstall_pppoe; then
						NETINSTALL_PROTO="pppoe"
						break
					else
						netinstall_form_status=$?
					fi
					[ "$netinstall_form_status" -eq 2 ] || return "$netinstall_form_status"
					;;
				*)
					NETINSTALL_ERROR="Unsupported download network mode: $NETINSTALL_SELECTED_PROTO"
					return 1
					;;
			esac
		done
		[ "$NETINSTALL_SELECTED_PROTO" = "__back" ] && continue
		ui_install_stage "Configure uplink" "Applying temporary $NETINSTALL_PROTO networking on $NETINSTALL_DEV." "$INSTALL_LOG"
		apply_netinstall_network
		return $?
	done
}

prepare_online_payload() {
	init_netinstall_workdir || die "$NETINSTALL_ERROR"
	if ! netinstall_has_default_route; then
		auto_configure_netinstall_dhcp || true
	fi
	while :; do
		if acquire_downloaded_payload; then
			restore_netinstall_network
			ui_notice "Online image ready" "OpenWrt $PAYLOAD_VERSION $PAYLOAD_BOOT_MODE image is signed, downloaded into RAM, and verified. Target disk selection starts next."
			return 0
		fi
		case "$NETINSTALL_ERROR" in
			"Could not reach the official OpenWrt release index over HTTPS."*)
				if [ "$NETINSTALL_AUTO_DHCP_ATTEMPTED" = "0" ]; then
					auto_configure_netinstall_dhcp && continue
				fi
				NETINSTALL_ERROR="$NETINSTALL_ERROR Automatic DHCP was already tried; manual DHCP, static IPv4, and PPPoE remain available."
				;;
		esac

		menu_reset
		menu_note "$NETINSTALL_ERROR"
		menu_add "configure" "Configure or change the temporary download uplink"
		menu_add "retry" "Retry official release discovery and verification"
		menu_add "embedded" "Use the embedded offline OpenWrt image"
		menu_add "cancel" "Cancel and return to shell"
		select_from_menu "Online image unavailable" "online source action"
		case "$SELECTED_VALUE" in
			configure)
				if configure_netinstall_network; then
					:
				else
					netinstall_config_status=$?
					[ "$netinstall_config_status" -eq 2 ] || warn "$NETINSTALL_ERROR"
				fi
				;;
			retry) ;;
			embedded)
				restore_netinstall_network
				reset_to_embedded_payload
				autostart_serial_marker "OWRT_INSTALLER_NETINSTALL_FALLBACK=embedded"
				ui_notice "Offline fallback" "The embedded verified OpenWrt image will be used. No network download is required."
				return 0
				;;
			cancel)
				restore_netinstall_network
				die "Online installation cancelled"
				;;
		esac
	done
}

check_for_newer_payload() {
	if ! init_netinstall_workdir; then
		append_install_log "INFO: Latest-release check skipped: $NETINSTALL_ERROR"
		autostart_serial_marker "OWRT_INSTALLER_LATEST_CHECK=local-workspace-unavailable"
		reset_to_embedded_payload
		return 0
	fi

	if ! netinstall_has_default_route; then
		if ! auto_configure_netinstall_dhcp; then
			append_install_log "INFO: Latest-release check uses embedded image: $NETINSTALL_ERROR"
			autostart_serial_marker "OWRT_INSTALLER_LATEST_CHECK=local-no-network"
			reset_to_embedded_payload
			return 0
		fi
	fi

	if ! netinstall_stable_version; then
		append_install_log "INFO: Latest-release check uses embedded image: $NETINSTALL_ERROR"
		autostart_serial_marker "OWRT_INSTALLER_LATEST_CHECK=local-index-unavailable"
		restore_netinstall_network
		reset_to_embedded_payload
		return 0
	fi

	embedded_version="$(json_value openwrt_version || true)"
	if ! printf '%s\n' "$embedded_version" |
		grep -Eq '^[0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*$'; then
		append_install_log "INFO: Latest-release check skipped: embedded version is invalid"
		autostart_serial_marker "OWRT_INSTALLER_LATEST_CHECK=local-invalid-embedded-version"
		restore_netinstall_network
		reset_to_embedded_payload
		return 0
	fi

	if ! release_version_is_newer "$NETINSTALL_STABLE_VERSION" "$embedded_version"; then
		autostart_serial_marker "OWRT_INSTALLER_LATEST_CHECK=local-current"
		restore_netinstall_network
		reset_to_embedded_payload
		return 0
	fi

	menu_reset
	menu_note "Embedded image: OpenWrt $embedded_version. Available stable release: OpenWrt $NETINSTALL_STABLE_VERSION."
	menu_add "download" "Download, verify, and install OpenWrt $NETINSTALL_STABLE_VERSION"
	menu_add "embedded" "Continue with embedded OpenWrt $embedded_version"
	select_from_menu "New OpenWrt release available" "online update action"
	case "$SELECTED_VALUE" in
		download)
			autostart_serial_marker "OWRT_INSTALLER_LATEST_CHECK=download-accepted"
			prepare_online_payload
			;;
		embedded)
			autostart_serial_marker "OWRT_INSTALLER_LATEST_CHECK=local-selected"
			restore_netinstall_network
			reset_to_embedded_payload
			;;
	esac
}

verify_payload() {
	[ -s "$PAYLOAD" ] || die "Payload image is missing: $PAYLOAD"
	[ -s "$MANIFEST" ] || die "Payload manifest is missing: $MANIFEST"
	command -v sha256sum >/dev/null 2>&1 || die "sha256sum is required"
	command -v gzip >/dev/null 2>&1 || die "gzip is required"

	expected="$(json_value payload_sha256)"
	[ -n "$expected" ] || die "payload_sha256 is missing from $MANIFEST"
	actual="$(sha256sum "$PAYLOAD" | awk '{ print $1 }')"
	[ "$actual" = "$expected" ] || die "Payload SHA-256 mismatch"
	gzip -t "$PAYLOAD" || die "Payload gzip stream is invalid"

	PAYLOAD_SHA256="$actual"
	PAYLOAD_UNCOMPRESSED_SIZE="$(json_value payload_uncompressed_size || true)"
	manifest_version="$(json_value openwrt_version || true)"
	manifest_filename="$(json_value payload_filename || true)"
	manifest_image_type="$(json_value image_type || true)"
	manifest_source="$(json_value payload_source || true)"
	[ -n "$manifest_version" ] || die "openwrt_version is missing from $MANIFEST"
	PAYLOAD_VERSION="$manifest_version"
	[ -n "$manifest_filename" ] && PAYLOAD_FILENAME="$manifest_filename"
	[ -n "$manifest_image_type" ] && PAYLOAD_IMAGE_TYPE="$manifest_image_type"
	if [ "$manifest_source" = "downloaded-official" ]; then
		PAYLOAD_SOURCE_ID="downloaded-official"
		PAYLOAD_SOURCE_LABEL="Downloaded official OpenWrt"
	fi
	PAYLOAD_COMPRESSED_SIZE="$(stat -c '%s' "$PAYLOAD" 2>/dev/null || true)"
	is_positive_integer "$PAYLOAD_UNCOMPRESSED_SIZE" ||
		die "payload_uncompressed_size is invalid in $MANIFEST"
	case "$PAYLOAD_IMAGE_TYPE" in
		*combined-efi*) payload_layout_mode="uefi" ;;
		*combined*) payload_layout_mode="bios" ;;
		*) die "Unsupported payload image type: $PAYLOAD_IMAGE_TYPE" ;;
	esac
	storage_inspect_payload_layout "$PAYLOAD" "$PAYLOAD_UNCOMPRESSED_SIZE" "$payload_layout_mode" ||
		die "$STORAGE_ERROR"
	export PAYLOAD_SHA256
	export PAYLOAD_UNCOMPRESSED_SIZE
	log "Payload SHA-256 verified"
	if [ -n "$PAYLOAD_UNCOMPRESSED_SIZE" ]; then
		log "Payload uncompressed size: $PAYLOAD_UNCOMPRESSED_SIZE bytes"
	fi
}

disk_name_from_path() {
	printf '%s\n' "${1#/dev/}"
}

is_supported_disk_name() {
	case "$1" in
		sd[a-z]|vd[a-z]|xvd[a-z]|nvme[0-9]*n[0-9]*|mmcblk[0-9]*) return 0 ;;
		*) return 1 ;;
	esac
}

parent_disk() {
	dev="$1"
	resolved="$(readlink -f "$dev" 2>/dev/null || true)"
	case "$resolved" in
		/dev/*) dev="$resolved" ;;
	esac
	case "$dev" in
		/dev/nvme[0-9]*n[0-9]*p[0-9]*|/dev/mmcblk[0-9]*p[0-9]*)
			printf '%s\n' "${dev%p[0-9]*}"
			;;
		/dev/sd[a-z][0-9]*|/dev/vd[a-z][0-9]*|/dev/xvd[a-z][0-9]*)
			printf '%s\n' "${dev%%[0-9]*}"
			;;
		*)
			printf '%s\n' "$dev"
			;;
	esac
}

root_device_from_cmdline() {
	cmdline="$(cat /proc/cmdline 2>/dev/null || true)"
	for arg in $cmdline; do
		case "$arg" in
			root=/dev/*)
				printf '%s\n' "${arg#root=}"
				return 0
				;;
			root=PARTUUID=*|root=UUID=*)
				query="${arg#root=}"
				device="$(blkid -t "$query" -o device 2>/dev/null | head -n 1)"
				if [ -n "$device" ]; then
					printf '%s\n' "$device"
					return 0
				fi
				;;
		esac
	done
	return 1
}

is_live_boot_disk() {
	disk="$1"
	root_device="$(root_device_from_cmdline || true)"
	if [ -n "$root_device" ] && [ "$(parent_disk "$root_device")" = "$disk" ]; then
		return 0
	fi
	while read -r source mountpoint rest; do
		case "$source" in
			/dev/*)
				[ "$(parent_disk "$source")" = "$disk" ] && return 0
				;;
		esac
	done < /proc/mounts
	return 1
}

disk_size() {
	name="$1"
	sectors="$(cat "/sys/block/$name/size" 2>/dev/null || printf 0)"
	bytes=$((sectors * 512))
	if [ "$bytes" -ge 1099511627776 ]; then
		printf '%sT' "$((bytes / 1099511627776))"
	elif [ "$bytes" -ge 1073741824 ]; then
		printf '%sG' "$((bytes / 1073741824))"
	elif [ "$bytes" -ge 1048576 ]; then
		printf '%sM' "$((bytes / 1048576))"
	else
		printf '%sK' "$((bytes / 1024))"
	fi
}

refresh_disks() {
	: > "$DISK_LIST"
	for sysdev in /sys/block/*; do
		[ -e "$sysdev" ] || continue
		name="$(basename "$sysdev")"
		is_supported_disk_name "$name" || continue
		[ -b "/dev/$name" ] || continue
		printf '%s\n' "/dev/$name" >> "$DISK_LIST"
	done
}

disk_label() {
	disk="$1"
	name="$(disk_name_from_path "$disk")"
	model="$(trim_file "/sys/block/$name/device/model")"
	serial="$(trim_file "/sys/block/$name/device/serial")"
	removable="$(cat "/sys/block/$name/removable" 2>/dev/null || printf '?')"
	rotational="$(cat "/sys/block/$name/queue/rotational" 2>/dev/null || printf '?')"
	transport="$(basename "$(readlink -f "/sys/block/$name/device" 2>/dev/null)" 2>/dev/null || printf unknown)"
	boot=""
	is_live_boot_disk "$disk" && boot=" live-boot-disk=1"
	printf '%-18s %-6s model=%s serial=%s removable=%s rotational=%s transport=%s%s' \
		"$disk" "$(disk_size "$name")" "$model" "$serial" \
		"$removable" "$rotational" "$transport" "$boot"
}

disk_menu_label() {
	disk="$1"
	name="$(disk_name_from_path "$disk")"
	model="$(trim_file "/sys/block/$name/device/model")"
	removable="$(cat "/sys/block/$name/removable" 2>/dev/null || printf 0)"
	case "$removable" in
		1) media="removable" ;;
		*) media="fixed" ;;
	esac
	live=""
	is_live_boot_disk "$disk" && live=" LIVE-BOOT"
	printf '%-18s %-6s %.24s [%s]%s' \
		"$disk" "$(disk_size "$name")" "${model:-unknown}" "$media" "$live"
}

build_disk_menu() {
	label_mode="${1:-compact}"
	refresh_disks
	menu_reset
	while IFS= read -r disk; do
		[ -n "$disk" ] || continue
		case "$label_mode" in
			detailed) label="$(disk_label "$disk")" ;;
			*) label="$(disk_menu_label "$disk")" ;;
		esac
		menu_add "$disk" "$label"
	done < "$DISK_LIST"
}

show_disks() {
	build_disk_menu detailed
	section "Available target disks"
	if [ "$(menu_count)" -eq 0 ]; then
		printf 'No supported target disks found.\n'
	else
		render_numbered_menu
	fi
}

validate_target_disk() {
	disk="$1"
	name="$(disk_name_from_path "$disk")"

	[ "$disk" = "/dev/$name" ] || die "Target disk must be an absolute /dev path"
	is_supported_disk_name "$name" || die "Unsupported target disk: $disk"
	[ -b "$disk" ] || die "Target is not a block device: $disk"
	[ -d "/sys/block/$name" ] || die "Target is a partition or unknown disk: $disk"

	removable="$(cat "/sys/block/$name/removable" 2>/dev/null || printf 0)"
	if [ "$removable" = "1" ] && [ "$ALLOW_REMOVABLE" != "1" ]; then
		die "Refusing removable target $disk. Use --allow-removable only if intentional."
	fi
	if is_live_boot_disk "$disk"; then
		die "Refusing detected live boot disk: $disk"
	fi
}

select_target_disk() {
	build_disk_menu
	if [ "$DRY_RUN" = "1" ]; then
		menu_warning "HARDWARE TEST: the selected disk will not be written."
	else
		menu_warning "WARNING: selected disk will be erased after final confirmation."
	fi
	select_from_menu "Select target disk" "target disk"
	TARGET="$SELECTED_VALUE"
}

select_installation_type() {
	menu_reset
	menu_add "clean" "Clean installation"
	menu_add "import" "Import OpenWrt backup from USB"
	menu_add "__back" "Back to target disk selection"
	menu_note "Import validates an OpenWrt sysupgrade .tar.gz in RAM before the erase review."
	select_from_menu "Select installation type" "installation type"
	SELECTED_INSTALL_MODE="$SELECTED_VALUE"
}

storage_preset_fits() {
	storage_preset_mib="$1"
	storage_preset_end=$((STORAGE_ROOT_START_SECTOR + storage_preset_mib * 2048 - 1))
	[ "$storage_preset_end" -ge "$STORAGE_ROOT_IMAGE_END_SECTOR" ] &&
		[ "$storage_preset_end" -le "$STORAGE_DISK_USABLE_END_SECTOR" ]
}

select_custom_storage_size() {
	storage_custom_default="${ROOTFS_TARGET_MIB:-8192} MiB"
	storage_custom_error=""
	while :; do
		prompt_default "OpenWrt partition size" "$storage_custom_default" \
			"Custom OpenWrt partition size" \
			"Examples: 4096 MiB, 8 GiB. Integer sizes only; percentages are not accepted." \
			"$storage_custom_error" \
			"The partition cannot be smaller than the embedded root image and cannot exceed the selected disk."
		[ "$UI_INPUT_ACTION" = "back" ] && return 2
		if ! storage_parse_size_mib "$SELECTED_INPUT"; then
			storage_custom_error="Enter an integer size with MiB or GiB units."
			continue
		fi
		if storage_calculate_layout bounded "$STORAGE_PARSED_SIZE_MIB"; then
			return 0
		fi
		storage_custom_error="$STORAGE_ERROR"
	done
}

select_storage_layout() {
	while :; do
		menu_reset
		menu_note "Only the OpenWrt root partition is resized. Remaining space stays unallocated."
		menu_add "fill" "Use entire disk (default)"
		for storage_preset_mib in 4096 8192 16384 32768; do
			storage_preset_fits "$storage_preset_mib" || continue
			menu_add "mib:$storage_preset_mib" "$((storage_preset_mib / 1024)) GiB OpenWrt partition"
		done
		menu_add "image" "Keep original image size ($STORAGE_ROOT_IMAGE_MIB MiB)"
		menu_add "custom" "Custom size in MiB or GiB"
		menu_add "__back" "Back"
		menu_warning "Selected disk: $TARGET, $STORAGE_DISK_MIB MiB."
		select_from_menu "Select OpenWrt partition size" "partition size"
		case "$SELECTED_VALUE" in
			fill) storage_calculate_layout fill; return 0 ;;
			image) storage_calculate_layout image; return 0 ;;
			mib:*) storage_calculate_layout bounded "${SELECTED_VALUE#mib:}"; return 0 ;;
			custom)
				storage_custom_status=0
				select_custom_storage_size || storage_custom_status=$?
				[ "$storage_custom_status" -eq 0 ] && return 0
				[ "$storage_custom_status" -eq 2 ] || return "$storage_custom_status"
				;;
			__back) return 2 ;;
		esac
	done
}

prepare_requested_storage_layout() {
	case "${STORAGE_LAYOUT_REQUEST:-fill}" in
		fill) storage_calculate_layout fill || die "$STORAGE_ERROR" ;;
		image) storage_calculate_layout image || die "$STORAGE_ERROR" ;;
		*)
			storage_parse_size_mib "$STORAGE_LAYOUT_REQUEST" ||
				die "Invalid --root-size value: $STORAGE_LAYOUT_REQUEST"
			storage_calculate_layout bounded "$STORAGE_PARSED_SIZE_MIB" || die "$STORAGE_ERROR"
			;;
	esac
}

record_storage_selection() {
	log "Storage layout: $STORAGE_LAYOUT, root sectors $STORAGE_ROOT_START_SECTOR-$STORAGE_ROOT_TARGET_END_SECTOR, unallocated ${STORAGE_UNALLOCATED_MIB} MiB"
	autostart_serial_marker "OWRT_INSTALLER_STORAGE_LAYOUT=$STORAGE_LAYOUT"
	autostart_serial_marker "OWRT_INSTALLER_ROOTFS_END_SECTOR=$STORAGE_ROOT_TARGET_END_SECTOR"
}

select_existing_installation_action() {
	menu_reset
	menu_note "Detected OpenWrt $STORAGE_EXISTING_VERSION ${STORAGE_EXISTING_REVISION:-} ($STORAGE_EXISTING_TARGET) on $STORAGE_EXISTING_ROOT_PART. The probe is unmounted and no disk writes have occurred."
	if [ "$STORAGE_EXISTING_RESCUE_AVAILABLE" = "1" ]; then
		menu_add "rescue" "Rescue configuration in RAM, reinstall, and restore (recommended)"
	fi
	if [ -n "$STORAGE_EXISTING_BOOT_PART" ]; then
		menu_add "boot" "Boot existing OpenWrt for its standard sysupgrade/owut flow"
	fi
	menu_add "clean" "Clean installation without restoring configuration"
	menu_add "import" "Import a different OpenWrt backup from USB"
	menu_add "__back" "Back to target disk selection"
	if [ "$STORAGE_EXISTING_RESCUE_AVAILABLE" = "1" ]; then
		menu_warning "Rescue copies configuration only. Installed packages are recorded but not copied into the new image."
	else
		menu_warning "Automatic rescue unavailable: $STORAGE_EXISTING_PROBE_REASON"
	fi
	select_from_menu "Select installation action" "installation action"
	SELECTED_INSTALL_MODE="$SELECTED_VALUE"
}

reset_rescue_metadata() {
	STORAGE_RESCUE_SCOPE=""
	STORAGE_RESCUE_SOURCE_VERSION=""
	STORAGE_RESCUE_SOURCE_PART=""
	STORAGE_RESCUE_MEMBER_COUNT=0
	STORAGE_RESCUE_UNPACKED_SIZE=0
	STORAGE_RESCUE_SKIPPED=0
	STORAGE_RESCUE_PACKAGE_COUNT=0
	STORAGE_RESCUE_PACKAGE_LIST=""
}

select_rescue_scope() {
	menu_reset
	menu_note "The snapshot is copied to private RAM, validated as an OpenWrt backup, and the source partition is unmounted before erase."
	menu_add "config-only" "UCI configuration only: /etc/config (recommended)"
	menu_add "full" "Advanced: regular files from /etc"
	menu_add "__back" "Back"
	rescue_warning="Full /etc restore can carry settings that are incompatible with OpenWrt $PAYLOAD_VERSION. Symlinks and special files are skipped."
	if [ "$STORAGE_EXISTING_VERSION" != "$PAYLOAD_VERSION" ]; then
		rescue_warning="Source OpenWrt $STORAGE_EXISTING_VERSION differs from target $PAYLOAD_VERSION. $rescue_warning"
	fi
	menu_warning "$rescue_warning"
	select_from_menu "Select rescue scope" "rescue scope"
	SELECTED_RESCUE_SCOPE="$SELECTED_VALUE"
}

confirm_full_rescue() {
	menu_reset
	menu_warning "ADVANCED RESTORE: regular files from the old /etc can replace credentials, SSH keys, services, and first-boot configuration. They may be incompatible with OpenWrt $PAYLOAD_VERSION."
	menu_add "continue" "Continue with full /etc rescue"
	menu_add "__back" "Back to rescue scope"
	select_from_menu "Full rescue warning" "full rescue action"
	[ "$SELECTED_VALUE" = "continue" ]
}

confirm_rescue_version_risk() {
	rescue_version_relation="$1"
	menu_reset
	if [ "$rescue_version_relation" = "newer" ]; then
		menu_warning "DOWNGRADE: rescued settings come from OpenWrt $STORAGE_EXISTING_VERSION, newer than target $PAYLOAD_VERSION. Restoring them can make the new system unbootable or unreachable."
		menu_add "continue" "Advanced: continue rescue into the older target"
	else
		menu_warning "UNKNOWN VERSION RELATION: source OpenWrt $STORAGE_EXISTING_VERSION and target $PAYLOAD_VERSION cannot be compared as stable releases. Restoring settings can make the new system unbootable or unreachable."
		menu_add "continue" "Advanced: continue with uncomparable versions"
	fi
	menu_add "__back" "Back to rescue scope"
	select_from_menu "Rescue version warning" "rescue version action"
	[ "$SELECTED_VALUE" = "continue" ]
}

prepare_interactive_rescue() {
	while :; do
		select_rescue_scope
		[ "$SELECTED_RESCUE_SCOPE" = "__back" ] && return 2
		rescue_version_relation="$(release_version_relation \
			"$STORAGE_EXISTING_VERSION" "$PAYLOAD_VERSION")"
		case "$rescue_version_relation" in
			newer|unknown)
				confirm_rescue_version_risk "$rescue_version_relation" || continue
				;;
		esac
		if [ "$SELECTED_RESCUE_SCOPE" = "full" ] && ! confirm_full_rescue; then
			continue
		fi
		ui_install_stage "Rescue configuration" \
			"Copying regular configuration files from $STORAGE_EXISTING_ROOT_PART into private RAM." "$INSTALL_LOG"
		if ! storage_prepare_rescue_snapshot "$SELECTED_RESCUE_SCOPE"; then
			autostart_serial_marker "OWRT_INSTALLER_RESCUE_ERROR=$STORAGE_ERROR"
			ui_notice "Rescue unavailable" "$STORAGE_ERROR"
			config_import_clear_workspace
			return 2
		fi
		INSTALL_MODE="rescue"
		autostart_serial_marker "OWRT_INSTALLER_RESCUE_READY=$STORAGE_RESCUE_SOURCE_VERSION:$STORAGE_RESCUE_SCOPE"
		if [ "$CONFIG_IMPORT_HAS_NETWORK" = "1" ]; then
			rescue_network_status=0
			config_import_select_network_source || rescue_network_status=$?
			if [ "$rescue_network_status" -eq 2 ]; then
				config_import_clear_workspace
				continue
			fi
			[ "$rescue_network_status" -eq 0 ] || die "$CONFIG_IMPORT_ERROR"
		else
			NETWORK_SOURCE="wizard"
			SKIP_NETWORK=0
		fi
		ui_notice "Rescue ready" \
			"Validated RAM snapshot from OpenWrt $STORAGE_RESCUE_SOURCE_VERSION: $CONFIG_IMPORT_MEMBER_COUNT members, $(bytes_as_mib "$CONFIG_IMPORT_COMPRESSED_SIZE"), SHA-256 $CONFIG_IMPORT_SHA256. Package inventory: $STORAGE_RESCUE_PACKAGE_COUNT names. Skipped links or special/installer-owned entries: $STORAGE_RESCUE_SKIPPED."
		return 0
	done
}

prepare_requested_rescue() {
	storage_probe_existing_openwrt ||
		die "--rescue-existing did not find a supported ext4 OpenWrt x86/64 installation on $TARGET"
	[ "$STORAGE_EXISTING_RESCUE_AVAILABLE" = "1" ] || die "$STORAGE_EXISTING_PROBE_REASON"
	rescue_version_relation="$(release_version_relation \
		"$STORAGE_EXISTING_VERSION" "$PAYLOAD_VERSION")"
	case "$rescue_version_relation" in
		newer)
			die "Refusing non-interactive rescue downgrade from OpenWrt $STORAGE_EXISTING_VERSION to $PAYLOAD_VERSION"
			;;
		unknown)
			die "Refusing non-interactive rescue because source OpenWrt $STORAGE_EXISTING_VERSION and target $PAYLOAD_VERSION cannot be compared safely"
			;;
	esac
	ui_install_stage "Rescue configuration" \
		"Copying the requested existing OpenWrt configuration into private RAM." "$INSTALL_LOG"
	storage_prepare_rescue_snapshot "$RESCUE_SCOPE_REQUEST" || die "$STORAGE_ERROR"
	if [ "$STORAGE_RESCUE_SOURCE_VERSION" != "$PAYLOAD_VERSION" ]; then
		warn "Rescue source OpenWrt $STORAGE_RESCUE_SOURCE_VERSION differs from target $PAYLOAD_VERSION"
	fi
	INSTALL_MODE="rescue"
	autostart_serial_marker "OWRT_INSTALLER_RESCUE_READY=$STORAGE_RESCUE_SOURCE_VERSION:$STORAGE_RESCUE_SCOPE"
	case "${CONFIG_IMPORT_NETWORK_REQUEST:-}" in
		keep)
			[ "$CONFIG_IMPORT_HAS_NETWORK" = "1" ] ||
				die "--import-network keep requires etc/config/network in the rescued configuration"
			NETWORK_SOURCE="imported"
			SKIP_NETWORK=1
			;;
		wizard)
			NETWORK_SOURCE="wizard"
			SKIP_NETWORK=0
			;;
		"")
			if [ "$CONFIG_IMPORT_HAS_NETWORK" = "1" ]; then
				NETWORK_SOURCE="imported"
				SKIP_NETWORK=1
			elif [ "$SKIP_NETWORK" = "1" ]; then
				NETWORK_SOURCE="defaults"
			else
				NETWORK_SOURCE="wizard"
			fi
			;;
	esac
}

existing_upgrade_handoff() {
	while :; do
		menu_reset
		menu_note "The live installer will not run sysupgrade against an offline root. Reboot into OpenWrt $STORAGE_EXISTING_VERSION and use LuCI, sysupgrade, or owut there. The ISO boot menu selects the installed OpenWrt entry by default while this disk is present."
		menu_add "reboot" "Reboot into the installed OpenWrt"
		menu_add "__back" "Back to installation actions"
		menu_warning "This handoff does not modify $TARGET. A standard x86 combined image can reset partition 2 geometry and overwrite later partitions; check owut --rootfs-size in the installed system when preserving a custom root size."
		select_from_menu "Standard OpenWrt upgrade" "upgrade handoff action"
		case "$SELECTED_VALUE" in
			reboot)
				if [ "$DRY_RUN" = "1" ]; then
					ui_notice "Dry run" "Reboot handoff selected; dry-run mode leaves the machine running."
					return 0
				fi
				cleanup
				reboot
				return 0
				;;
			__back) return 2 ;;
		esac
	done
}

edit_staged_configuration() {
	case "$INSTALL_MODE" in
		rescue)
			edit_rescue_status=0
			prepare_interactive_rescue || edit_rescue_status=$?
			if [ "$edit_rescue_status" -ne 0 ] && [ ! -d "$CONFIG_IMPORT_APPLY_DIR/etc" ]; then
				die "The previous rescue snapshot is no longer staged after a failed edit"
			fi
			;;
		import)
			while :; do
				edit_import_status=0
				config_import_select_policy || edit_import_status=$?
				[ "$edit_import_status" -eq 2 ] && return 0
				[ "$edit_import_status" -eq 0 ] || die "$CONFIG_IMPORT_ERROR"
				config_import_select_network_source || edit_import_status=$?
				[ "$edit_import_status" -eq 2 ] && continue
				[ "$edit_import_status" -eq 0 ] || die "$CONFIG_IMPORT_ERROR"
				return 0
			done
			;;
	esac
}

prepare_interactive_config_import() {
	while :; do
		config_import_status=0
		config_import_select_usb_archive || config_import_status=$?
		case "$config_import_status" in
			0) ;;
			2)
				config_import_clear_workspace
				return 2
				;;
			*)
				autostart_serial_marker "OWRT_INSTALLER_CONFIG_IMPORT_ERROR=$CONFIG_IMPORT_ERROR"
				ui_notice "Backup unavailable" "$CONFIG_IMPORT_ERROR"
				config_import_clear_workspace
				return 2
				;;
		esac

		while :; do
			config_import_status=0
			config_import_select_policy || config_import_status=$?
			case "$config_import_status" in
				0) ;;
				2)
					config_import_clear_workspace
					break
					;;
				*)
					autostart_serial_marker "OWRT_INSTALLER_CONFIG_IMPORT_ERROR=$CONFIG_IMPORT_ERROR"
					ui_notice "Backup rejected" "$CONFIG_IMPORT_ERROR"
					config_import_clear_workspace
					break
					;;
			esac
			config_import_status=0
			config_import_select_network_source || config_import_status=$?
			[ "$config_import_status" -eq 2 ] && continue
			if [ "$config_import_status" -ne 0 ]; then
				autostart_serial_marker "OWRT_INSTALLER_CONFIG_IMPORT_ERROR=$CONFIG_IMPORT_ERROR"
				ui_notice "Backup rejected" "$CONFIG_IMPORT_ERROR"
				config_import_clear_workspace
				break
			fi
			INSTALL_MODE="import"
			config_import_ready_notice
			return 0
		done
	done
}

prepare_requested_config_import() {
	ui_install_stage "Validate backup" "Copying the selected OpenWrt backup into RAM and validating every member." "$INSTALL_LOG"
	config_import_prepare_file "$CONFIG_IMPORT_SOURCE_REQUEST" || die "$CONFIG_IMPORT_ERROR"
	config_import_policy="${CONFIG_IMPORT_POLICY_REQUEST:-config-only}"
	config_import_prepare_policy "$config_import_policy" || die "$CONFIG_IMPORT_ERROR"
	case "${CONFIG_IMPORT_NETWORK_REQUEST:-}" in
		keep)
			[ "$CONFIG_IMPORT_HAS_NETWORK" = "1" ] ||
				die "--import-network keep requires etc/config/network in the backup"
			NETWORK_SOURCE="imported"
			SKIP_NETWORK=1
			;;
		wizard)
			NETWORK_SOURCE="wizard"
			SKIP_NETWORK=0
			;;
		"")
			if [ "$CONFIG_IMPORT_HAS_NETWORK" = "1" ]; then
				NETWORK_SOURCE="imported"
				SKIP_NETWORK=1
			elif [ "$SKIP_NETWORK" = "1" ]; then
				NETWORK_SOURCE="defaults"
			else
				NETWORK_SOURCE="wizard"
			fi
			;;
	esac
	INSTALL_MODE="import"
}

is_ignored_nic() {
	case "$1" in
		lo|br-*|docker*|veth*|tun*|tap*|wg*|ppp*|ifb*|gre*|erspan*|ip6tnl*|sit*)
			return 0
			;;
		*)
			return 1
			;;
	esac
}

get_nic_mac() {
	lower "$(cat "/sys/class/net/$1/address" 2>/dev/null || true)"
}

get_nic_driver() {
	basename "$(readlink -f "/sys/class/net/$1/device/driver" 2>/dev/null)" 2>/dev/null ||
		printf '%s' "unknown"
}

get_nic_speed() {
	cat "/sys/class/net/$1/speed" 2>/dev/null || printf '%s' "unknown"
}

get_nic_link() {
	carrier="$(cat "/sys/class/net/$1/carrier" 2>/dev/null || printf 0)"
	[ "$carrier" = "1" ] && printf '%s' "up" || printf '%s' "down"
}

refresh_nics() {
	: > "$NIC_LIST"
	for devpath in /sys/class/net/*; do
		[ -e "$devpath" ] || continue
		name="$(basename "$devpath")"
		is_ignored_nic "$name" && continue
		mac="$(get_nic_mac "$name")"
		[ -n "$mac" ] || continue
		printf '%s|%s\n' "$name" "$mac" >> "$NIC_LIST"
	done
}

nic_label() {
	name="$1"
	mac="$2"
	pci_path="$(readlink -f "/sys/class/net/$name/device" 2>/dev/null || printf unknown)"
	printf '%-12s %s driver=%s link=%s speed=%s pci=%s' \
		"$name" "$mac" "$(get_nic_driver "$name")" \
		"$(get_nic_link "$name")" "$(get_nic_speed "$name")" "$pci_path"
}

build_nic_menu() {
	excluded_dev="${1:-}"
	menu_reset
	while IFS='|' read -r name mac; do
		[ -n "$name" ] || continue
		[ "$name" = "$excluded_dev" ] && continue
		menu_add "$name,$mac" "$(nic_label "$name" "$mac")"
	done < "$NIC_LIST"
}

show_nics() {
	refresh_nics
	build_nic_menu
	section "Available network interfaces"
	if [ "$(menu_count)" -eq 0 ]; then
		printf 'No usable network interfaces found.\n'
	else
		render_numbered_menu
	fi
}

select_nic() {
	role="$1"
	excluded_dev="${2:-}"
	build_nic_menu "$excluded_dev"
	select_from_menu "Select $role interface" "$role interface"
	SELECTED_NIC="$SELECTED_VALUE"
}

is_valid_mac() {
	printf '%s\n' "$1" | grep -Eq '^([0-9a-f]{2}:){5}[0-9a-f]{2}$'
}

validate_network_selection() {
	LAN_MAC="$(lower "$LAN_MAC")"
	WAN_MAC="$(lower "$WAN_MAC")"
	is_valid_mac "$LAN_MAC" || die "Invalid or empty LAN MAC address: $LAN_MAC"
	is_valid_mac "$WAN_MAC" || die "Invalid or empty WAN MAC address: $WAN_MAC"
	[ "$LAN_MAC" != "$WAN_MAC" ] || die "LAN and WAN cannot use the same MAC address"
}

select_lan_settings() {
	error=""
	while :; do
		prompt_default \
			"LAN IPv4 address/CIDR" \
			"$LAN_IP/$LAN_CIDR" \
			"LAN IPv4 settings" \
			"Example: 192.168.1.1/24" \
			"$error" \
			"This address becomes the router address and LAN gateway."
		if [ "$UI_INPUT_ACTION" = "back" ]; then
			return 2
		fi
		if parse_cidr_address "$SELECTED_INPUT" "$LAN_CIDR"; then
			LAN_IP="$PARSED_IP"
			LAN_CIDR="$PARSED_CIDR"
			LAN_NETMASK="$PARSED_NETMASK"
			return 0
		fi
		error="Invalid LAN address. Use IPv4/CIDR, for example 192.168.1.1/24."
	done
}

select_wan_mode() {
	menu_reset
	menu_note "Choose how the installed OpenWrt system will configure IPv4 on the WAN interface."
	menu_add "dhcp" "DHCP client"
	menu_add "pppoe" "PPPoE"
	menu_add "static" "Static IPv4"
	menu_add "disabled" "Disabled / LAN-only"
	menu_add "__back" "Back to LAN settings"
	select_from_menu "Select WAN mode" "WAN mode"
	SELECTED_WAN_MODE="$SELECTED_VALUE"
}

select_wan6_mode() {
	menu_reset
	case "$WAN_PROTO" in
		pppoe)
			menu_note "IPv6 is configured separately from PPPoE IPv4. There is no separate PPPoE IPv6 mode here; choose DHCPv6 / Prefix Delegation if your ISP provides IPv6 over the PPP session."
			;;
		*)
			menu_note "IPv6 is configured separately from the IPv4 WAN mode. Choose DHCPv6 / Prefix Delegation for typical ISP IPv6, or None to leave WAN IPv6 disabled."
			;;
	esac
	menu_add "dhcpv6" "DHCPv6 / Prefix Delegation"
	menu_add "disabled" "Disabled / no WAN IPv6"
	menu_add "__back" "Back to previous WAN setting"
	select_from_menu "Select WAN IPv6 configuration type" "WAN IPv6 mode"
	SELECTED_WAN6_MODE="$SELECTED_VALUE"
}

wan6_label() {
	case "$1" in
		dhcpv6) printf '%s\n' "DHCPv6 / Prefix Delegation" ;;
		disabled) printf '%s\n' "disabled" ;;
		*) printf '%s\n' "$1" ;;
	esac
}

clear_unused_wan_settings() {
	case "$WAN_PROTO" in
		dhcp)
			WAN_PPP_USERNAME=""
			WAN_PPP_PASSWORD=""
			WAN_IPADDR=""
			WAN_NETMASK=""
			WAN_GATEWAY=""
			WAN_DNS=""
			;;
		pppoe)
			WAN_IPADDR=""
			WAN_NETMASK=""
			WAN_GATEWAY=""
			WAN_DNS=""
			;;
		static)
			WAN_PPP_USERNAME=""
			WAN_PPP_PASSWORD=""
			;;
		disabled)
			WAN6_PROTO="disabled"
			WAN_PPP_USERNAME=""
			WAN_PPP_PASSWORD=""
			WAN_IPADDR=""
			WAN_NETMASK=""
			WAN_GATEWAY=""
			WAN_DNS=""
			;;
	esac
}

select_wan_settings() {
	wan_state="mode"
	wan_back_from_wan6="mode"
	wan_form_error=""

	while :; do
		case "$wan_state" in
			mode)
				select_wan_mode
				if [ "$SELECTED_WAN_MODE" = "__back" ]; then
					return 2
				fi
				WAN_PROTO="$SELECTED_WAN_MODE"
				wan_form_error=""
				case "$WAN_PROTO" in
					dhcp)
						wan_back_from_wan6="mode"
						wan_state="wan6"
						;;
					pppoe) wan_state="pppoe-user" ;;
					static) wan_state="static-ip" ;;
					disabled)
						clear_unused_wan_settings
						return 0
						;;
					*) die "Unsupported WAN mode: $WAN_PROTO" ;;
				esac
				;;
			pppoe-user)
				prompt_default \
					"PPPoE username" \
					"${WAN_PPP_USERNAME:-}" \
					"PPPoE username" \
					"Example: user@example.net" \
					"$wan_form_error" \
					"Step 1 of 2. Credentials are saved only into the installed OpenWrt configuration."
				if [ "$UI_INPUT_ACTION" = "back" ]; then
					wan_form_error=""
					wan_state="mode"
					continue
				fi
				if [ -n "$SELECTED_INPUT" ]; then
					WAN_PPP_USERNAME="$SELECTED_INPUT"
					wan_form_error=""
					wan_state="pppoe-password"
				else
					wan_form_error="PPPoE username is required."
				fi
				;;
			pppoe-password)
				prompt_secret \
					"PPPoE password" \
					"PPPoE password" \
					"" \
					"Step 2 of 2.
Input is hidden and omitted from the review screen.
Leave it empty only if your ISP explicitly requires no password." \
					"${WAN_PPP_PASSWORD:-}"
				if [ "$UI_INPUT_ACTION" = "back" ]; then
					wan_state="pppoe-user"
					continue
				fi
				WAN_PPP_PASSWORD="$SELECTED_INPUT"
				wan_back_from_wan6="pppoe-password"
				wan_state="wan6"
				;;
			static-ip)
				prompt_default \
					"WAN IPv4 address/CIDR" \
					"${WAN_IPADDR:-192.0.2.2}/$WAN_CIDR" \
					"Static WAN IPv4 settings" \
					"Example: 192.0.2.2/24" \
					"$wan_form_error" \
					"Set the address assigned by your ISP or upstream router."
				if [ "$UI_INPUT_ACTION" = "back" ]; then
					wan_form_error=""
					wan_state="mode"
					continue
				fi
				if parse_cidr_address "$SELECTED_INPUT" "$WAN_CIDR"; then
					WAN_IPADDR="$PARSED_IP"
					WAN_CIDR="$PARSED_CIDR"
					WAN_NETMASK="$PARSED_NETMASK"
					wan_form_error=""
					wan_state="static-gateway"
				else
					wan_form_error="Invalid WAN address. Use IPv4/CIDR, for example 192.0.2.2/24."
				fi
				;;
			static-gateway)
				prompt_default \
					"WAN gateway" \
					"${WAN_GATEWAY:-}" \
					"Static WAN IPv4 settings" \
					"Example: 192.0.2.1, or leave empty if no gateway is needed" \
					"$wan_form_error" \
					"Gateway must be an IPv4 address reachable through the WAN network."
				if [ "$UI_INPUT_ACTION" = "back" ]; then
					wan_form_error=""
					wan_state="static-ip"
					continue
				fi
				if [ -z "$SELECTED_INPUT" ] || is_ipv4 "$SELECTED_INPUT"; then
					WAN_GATEWAY="$SELECTED_INPUT"
					wan_form_error=""
					wan_state="static-dns"
				else
					wan_form_error="Invalid gateway IPv4 address."
				fi
				;;
			static-dns)
				prompt_default \
					"WAN DNS servers" \
					"${WAN_DNS:-}" \
					"Static WAN IPv4 settings" \
					"Example: 1.1.1.1 8.8.8.8, or leave empty" \
					"$wan_form_error" \
					"Enter IPv4 DNS server addresses separated by spaces."
				if [ "$UI_INPUT_ACTION" = "back" ]; then
					wan_form_error=""
					wan_state="static-gateway"
					continue
				fi
				if validate_dns_servers "$SELECTED_INPUT"; then
					WAN_DNS="$SELECTED_INPUT"
					wan_form_error=""
					wan_back_from_wan6="static-dns"
					wan_state="wan6"
				else
					wan_form_error="DNS servers must be IPv4 addresses separated by spaces."
				fi
				;;
			wan6)
				select_wan6_mode
				if [ "$SELECTED_WAN6_MODE" = "__back" ]; then
					wan_state="$wan_back_from_wan6"
					continue
				fi
				WAN6_PROTO="$SELECTED_WAN6_MODE"
				clear_unused_wan_settings
				return 0
				;;
			*) die "Unsupported WAN settings state: $wan_state" ;;
		esac
	done
}

select_network_settings() {
	while :; do
		if select_lan_settings; then
			:
		else
			form_status=$?
			[ "$form_status" -eq 2 ] && return 2
			return "$form_status"
		fi
		if select_wan_settings; then
			return 0
		else
			form_status=$?
		fi
		[ "$form_status" -eq 2 ] || return "$form_status"
	done
}

validate_network_settings() {
	is_ipv4 "$LAN_IP" || die "Invalid LAN IPv4 address: $LAN_IP"
	is_cidr "$LAN_CIDR" || die "Invalid LAN CIDR: $LAN_CIDR"
	LAN_NETMASK="$(cidr_to_netmask "$LAN_CIDR")"
	case "$WAN_PROTO" in
		dhcp)
			;;
		pppoe)
			[ -n "$WAN_PPP_USERNAME" ] || die "PPPoE username is required"
			;;
		static)
			is_ipv4 "$WAN_IPADDR" || die "Static WAN IPv4 address is required"
			is_cidr "$WAN_CIDR" || die "Invalid WAN CIDR: $WAN_CIDR"
			WAN_NETMASK="$(cidr_to_netmask "$WAN_CIDR")"
			if [ -n "$WAN_GATEWAY" ]; then
				is_ipv4 "$WAN_GATEWAY" || die "Invalid WAN gateway: $WAN_GATEWAY"
			fi
			validate_dns_servers "$WAN_DNS" || die "Invalid WAN DNS servers: $WAN_DNS"
			;;
		disabled)
			WAN6_PROTO="disabled"
			;;
		*)
			die "Unsupported WAN mode: $WAN_PROTO"
			;;
	esac
	case "$WAN6_PROTO" in
		dhcpv6|disabled) ;;
		*) die "Unsupported WAN6 mode: $WAN6_PROTO" ;;
	esac
}

select_network() {
	while :; do
		refresh_nics
		nic_count="$(wc -l < "$NIC_LIST")"
		[ "$nic_count" -ge 2 ] ||
			die "At least two network interfaces are required. Use --skip-network-wizard to keep defaults."

		select_nic LAN
		entry="$SELECTED_NIC"
		LAN_DEV="${entry%%,*}"
		LAN_MAC="${entry#*,}"

		if [ "$nic_count" -eq 2 ]; then
			while IFS='|' read -r name mac; do
				[ "$name" = "$LAN_DEV" ] && continue
				WAN_DEV="$name"
				WAN_MAC="$mac"
				break
			done < "$NIC_LIST"
			ui_notice "WAN interface" "WAN selected automatically: $WAN_DEV $WAN_MAC"
		else
			select_nic WAN "$LAN_DEV"
			entry="$SELECTED_NIC"
			WAN_DEV="${entry%%,*}"
			WAN_MAC="${entry#*,}"
		fi
		validate_network_selection
		if select_network_settings; then
			validate_network_settings
			return 0
		else
			network_status=$?
		fi
		[ "$network_status" -eq 2 ] || return "$network_status"
	done
}

get_partition_path() {
	disk="$1"
	number="$2"
	case "$disk" in
		*[0-9]) printf '%sp%s\n' "$disk" "$number" ;;
		*) printf '%s%s\n' "$disk" "$number" ;;
	esac
}

unmount_target_partitions() {
	target="$1"
	awk '{ print $2, $1 }' /proc/mounts | sort -r > "$TARGET_MOUNT_LIST" ||
		die "Could not inspect mounted target partitions"
	while read -r mountpoint source; do
			case "$source" in
				"$target"[0-9]*|"$target"p[0-9]*)
					log "Unmounting $source from $mountpoint"
					umount "$mountpoint" || die "Could not unmount $mountpoint"
					;;
			esac
	done < "$TARGET_MOUNT_LIST"
	: > "$TARGET_MOUNT_LIST"
}

reread_partition_table() {
	target="$1"
	if command -v blockdev >/dev/null 2>&1; then
		blockdev --rereadpt "$target" >> "$INSTALL_LOG" 2>&1 || true
	fi
	if command -v partprobe >/dev/null 2>&1; then
		partprobe "$target" >> "$INSTALL_LOG" 2>&1 || true
	fi
	sleep 2
}

write_payload_without_percent() {
	target="$1"
	gzip -dc "$PAYLOAD" 2>> "$INSTALL_LOG" |
		dd of="$target" bs=16M conv=fsync >> "$INSTALL_LOG" 2>&1 ||
		die "Could not write payload image to $target"
}

write_payload_with_percent() {
	target="$1"
	WRITE_SOURCE_FIFO="$(tmp_file write-source)"
	WRITE_OUTPUT_FIFO="$(tmp_file write-output)"
	WRITE_PROGRESS_FIFO="$(tmp_file write-progress)"
	rm -f "$WRITE_SOURCE_FIFO" "$WRITE_OUTPUT_FIFO" "$WRITE_PROGRESS_FIFO"
	mkfifo "$WRITE_SOURCE_FIFO" "$WRITE_OUTPUT_FIFO" "$WRITE_PROGRESS_FIFO" ||
		die "Could not create payload progress pipes"

	gzip -dc "$PAYLOAD" > "$WRITE_SOURCE_FIFO" 2>> "$INSTALL_LOG" &
	WRITE_GZIP_PID=$!
	pv -f -n -s "$PAYLOAD_UNCOMPRESSED_SIZE" \
		< "$WRITE_SOURCE_FIFO" > "$WRITE_OUTPUT_FIFO" 2> "$WRITE_PROGRESS_FIFO" &
	WRITE_PV_PID=$!
	dd if="$WRITE_OUTPUT_FIFO" of="$target" bs=16M conv=fsync \
		>> "$INSTALL_LOG" 2>&1 &
	WRITE_DD_PID=$!

	ui_install_progress_stream "$WRITE_PROGRESS_FIFO" "Write image" \
		"Writing embedded OpenWrt image to $target." "$INSTALL_LOG" ||
		die "Payload progress display failed"

	write_gzip_status=0
	write_pv_status=0
	write_dd_status=0
	wait "$WRITE_GZIP_PID" || write_gzip_status=$?
	WRITE_GZIP_PID=""
	wait "$WRITE_PV_PID" || write_pv_status=$?
	WRITE_PV_PID=""
	wait "$WRITE_DD_PID" || write_dd_status=$?
	WRITE_DD_PID=""

	rm -f "$WRITE_SOURCE_FIFO" "$WRITE_OUTPUT_FIFO" "$WRITE_PROGRESS_FIFO"
	WRITE_SOURCE_FIFO=""
	WRITE_OUTPUT_FIFO=""
	WRITE_PROGRESS_FIFO=""

	[ "$write_dd_status" -eq 0 ] || die "Could not write payload image to $target (dd status $write_dd_status)"
	[ "$write_gzip_status" -eq 0 ] || die "Could not decompress payload image (gzip status $write_gzip_status)"
	[ "$write_pv_status" -eq 0 ] || die "Payload progress stream failed (pv status $write_pv_status)"
}

write_payload() {
	target="$1"
	log "Writing payload to $target"
	if [ -n "${PAYLOAD_UNCOMPRESSED_SIZE:-}" ]; then
		log "Streaming $PAYLOAD_UNCOMPRESSED_SIZE bytes after decompression"
	fi
	if command -v pv >/dev/null 2>&1 && command -v mkfifo >/dev/null 2>&1 &&
		[ -n "${PAYLOAD_UNCOMPRESSED_SIZE:-}" ] &&
		[ "$PAYLOAD_UNCOMPRESSED_SIZE" -gt 0 ] 2>/dev/null; then
		write_payload_with_percent "$target"
	else
		warn "Determinate write progress unavailable; using stage-only fallback"
		write_payload_without_percent "$target"
	fi

	ui_install_stage "Sync" "Flushing image writes to stable storage." "$INSTALL_LOG"
	log "Payload stream completed; syncing disks"
	run_or_die "sync failed after payload write" sync

	ui_install_stage "Reread partition table" "Asking the kernel to reload $target partitions." "$INSTALL_LOG"
	reread_partition_table "$target"
	log "Partition table reread requested for $target"
}

check_ext4() {
	rootpart="$1"
	status=0
	e2fsck -f -y "$rootpart" >> "$INSTALL_LOG" 2>&1 || status=$?
	[ "$status" -le 1 ] || die "e2fsck failed for $rootpart with status $status"
}

verify_ext4_geometry() {
	rootpart="$1"
	ext4_header="$(dumpe2fs -h "$rootpart" 2>> "$INSTALL_LOG")" ||
		die "Could not read ext4 geometry from $rootpart"
	ext4_block_count="$(printf '%s\n' "$ext4_header" |
		awk -F: '$1 ~ /^Block count/ { gsub(/[[:space:]]/, "", $2); print $2; exit }')"
	ext4_block_size="$(printf '%s\n' "$ext4_header" |
		awk -F: '$1 ~ /^Block size/ { gsub(/[[:space:]]/, "", $2); print $2; exit }')"
	if ! is_positive_integer "$ext4_block_count" || ! is_positive_integer "$ext4_block_size"; then
		die "Ext4 geometry is incomplete for $rootpart"
	fi
	ext4_filesystem_bytes=$((ext4_block_count * ext4_block_size))
	ext4_partition_sectors=$((STORAGE_ACTUAL_END_SECTOR - STORAGE_ACTUAL_START_SECTOR + 1))
	ext4_partition_bytes=$((ext4_partition_sectors * STORAGE_PAYLOAD_SECTOR_SIZE))
	ext4_slack_bytes=$((ext4_partition_bytes - ext4_filesystem_bytes))
	if ! { [ "$ext4_slack_bytes" -ge 0 ] && [ "$ext4_slack_bytes" -lt "$ext4_block_size" ]; }; then
		die "Ext4 size does not fill the reviewed root partition"
	fi
	log "Verified ext4 geometry: $ext4_block_count blocks x $ext4_block_size bytes, partition slack $ext4_slack_bytes bytes"
	autostart_serial_marker "OWRT_INSTALLER_ROOTFS_VERIFIED_MIB=$((ext4_filesystem_bytes / 1048576))"
}

resize_rootfs() {
	target="$1"
	rootpart="$2"
	command -v parted >/dev/null 2>&1 || die "parted is required"
	command -v blkid >/dev/null 2>&1 || die "blkid is required"
	command -v e2fsck >/dev/null 2>&1 || die "e2fsck is required"
	command -v resize2fs >/dev/null 2>&1 || die "resize2fs is required"
	command -v dumpe2fs >/dev/null 2>&1 || die "dumpe2fs is required"

	if [ "$STORAGE_ROOT_TARGET_END_SECTOR" -gt "$STORAGE_ROOT_IMAGE_END_SECTOR" ]; then
		ui_install_stage "Resize partition" "Setting partition 2 to $(storage_layout_label)." "$INSTALL_LOG"
		log "Setting partition 2 end sector to $STORAGE_ROOT_TARGET_END_SECTOR on $target"
		run_or_die "Could not resize partition 2 on $target" \
			parted -s -f "$target" resizepart 2 "${STORAGE_ROOT_TARGET_END_SECTOR}s"

		ui_install_stage "Reread partition table" "Reloading partition layout after resize." "$INSTALL_LOG"
		reread_partition_table "$target"
	else
		if [ "$STORAGE_TABLE_TYPE" = "gpt" ]; then
			ui_install_stage "Finalize GPT" "Relocating the backup GPT while keeping partition 2 at image size." "$INSTALL_LOG"
			log "Relocating the backup GPT to the end of $target"
			run_or_die "Could not relocate the backup GPT on $target" \
				parted -s -f "$target" unit s print
			reread_partition_table "$target"
		fi
		log "Keeping the OpenWrt root partition at its image size"
	fi
	[ -b "$rootpart" ] || die "Root partition did not appear: $rootpart"
	storage_partition_geometry "$target" 2 || die "Could not verify partition 2 geometry on $target"
	if ! { [ "$STORAGE_ACTUAL_START_SECTOR" -eq "$STORAGE_ROOT_START_SECTOR" ] &&
		[ "$STORAGE_ACTUAL_END_SECTOR" -eq "$STORAGE_ROOT_TARGET_END_SECTOR" ]; }; then
		die "Partition 2 geometry does not match the reviewed layout"
	fi

	fstype="$(blkid -o value -s TYPE "$rootpart" 2>/dev/null || true)"
	[ "$fstype" = "ext4" ] || die "Expected ext4 root partition at $rootpart, found: ${fstype:-unknown}"

	ui_install_stage "Check ext4" "Checking root filesystem before resize." "$INSTALL_LOG"
	log "Checking ext4 filesystem before resize"
	check_ext4 "$rootpart"

	if [ "$STORAGE_ROOT_TARGET_END_SECTOR" -gt "$STORAGE_ROOT_IMAGE_END_SECTOR" ]; then
		ui_install_stage "Resize ext4" "Growing root filesystem to the reviewed partition size." "$INSTALL_LOG"
		log "Growing ext4 filesystem"
		run_or_die "resize2fs failed for $rootpart" resize2fs "$rootpart"
	fi

	ui_install_stage "Final ext4 check" "Verifying root filesystem after resize." "$INSTALL_LOG"
	log "Checking ext4 filesystem after resize"
	check_ext4 "$rootpart"
	verify_ext4_geometry "$rootpart"

	ui_install_stage "Sync" "Flushing resized filesystem metadata." "$INSTALL_LOG"
	run_or_die "sync failed after filesystem resize" sync
}

write_installed_config() {
	rootpart="$1"
	target="$2"
	install_date="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
	release_lan_mac="$LAN_MAC"
	release_wan_mac="$WAN_MAC"
	release_lan_ip="$LAN_IP"
	release_lan_cidr="$LAN_CIDR"
	release_wan_proto="$WAN_PROTO"
	release_wan6_proto="$WAN6_PROTO"
	release_import_source="none"
	release_import_sha256="none"
	release_import_policy="none"
	release_import_members=0
	release_rescue_disk="none"
	release_rescue_revision="none"
	case "$INSTALL_MODE" in
	import|rescue)
		release_import_source="$CONFIG_IMPORT_SOURCE_LABEL"
		release_import_sha256="$CONFIG_IMPORT_SHA256"
		release_import_policy="$CONFIG_IMPORT_POLICY"
		release_import_members="$CONFIG_IMPORT_MEMBER_COUNT"
		if [ "$INSTALL_MODE" = "rescue" ]; then
			release_rescue_disk="$target"
			release_rescue_revision="${STORAGE_EXISTING_REVISION:-unknown}"
		fi
		;;
	esac
	if [ "$NETWORK_SOURCE" = "imported" ]; then
		release_lan_mac="imported"
		release_wan_mac="imported"
		release_lan_ip="imported"
		release_lan_cidr="imported"
		release_wan_proto="imported"
		release_wan6_proto="imported"
	fi

	log "Mounting $rootpart for installed configuration"
	mkdir -p "$TARGET_MOUNT" || die "Could not create target mount point: $TARGET_MOUNT"
	run_or_die "Could not mount $rootpart at $TARGET_MOUNT" mount "$rootpart" "$TARGET_MOUNT"
	TARGET_MOUNTED=1
	config_import_apply_to_target "$TARGET_MOUNT"

	mkdir -p "$TARGET_MOUNT/etc/owrt-installer" ||
		die "Could not create installer metadata directory"
	if [ "$INSTALL_MODE" = "rescue" ] && [ -f "$STORAGE_RESCUE_PACKAGE_LIST" ]; then
		cp "$STORAGE_RESCUE_PACKAGE_LIST" \
			"$TARGET_MOUNT/etc/owrt-installer/rescued-packages.txt" ||
			die "Could not save the rescued package inventory"
		chmod 0600 "$TARGET_MOUNT/etc/owrt-installer/rescued-packages.txt" ||
			die "Could not secure the rescued package inventory"
	fi
	if [ -s "$NETWORK_APPLIER" ] &&
		{ [ "$INSTALL_MODE" != "import" ] && [ "$INSTALL_MODE" != "rescue" ] || [ "$NETWORK_SOURCE" != "imported" ]; }; then
		if [ -L "$TARGET_MOUNT/etc/uci-defaults" ] ||
			{ [ -e "$TARGET_MOUNT/etc/uci-defaults" ] && [ ! -d "$TARGET_MOUNT/etc/uci-defaults" ]; }; then
			rm -rf "$TARGET_MOUNT/etc/uci-defaults" ||
				die "Could not replace conflicting installed uci-defaults path"
		fi
		mkdir -p "$TARGET_MOUNT/etc/uci-defaults" ||
			die "Could not create installed uci-defaults directory"
		cp "$NETWORK_APPLIER" "$TARGET_MOUNT/etc/uci-defaults/98-installer-network" ||
			die "Could not install the first-boot network applier"
		chmod 0755 "$TARGET_MOUNT/etc/uci-defaults/98-installer-network" ||
			die "Could not mark the first-boot network applier executable"
	fi
	if [ "$SKIP_NETWORK" != "1" ]; then
		if ! {
			printf 'LAN_MAC=%s\n' "$(shell_quote "$LAN_MAC")"
			printf 'WAN_MAC=%s\n' "$(shell_quote "$WAN_MAC")"
			printf 'LAN_IP=%s\n' "$(shell_quote "$LAN_IP")"
			printf 'LAN_CIDR=%s\n' "$(shell_quote "$LAN_CIDR")"
			printf 'LAN_NETMASK=%s\n' "$(shell_quote "$LAN_NETMASK")"
			printf 'WAN_PROTO=%s\n' "$(shell_quote "$WAN_PROTO")"
			printf 'WAN6_PROTO=%s\n' "$(shell_quote "$WAN6_PROTO")"
			printf 'WAN_PPP_USERNAME=%s\n' "$(shell_quote "$WAN_PPP_USERNAME")"
			printf 'WAN_PPP_PASSWORD=%s\n' "$(shell_quote "$WAN_PPP_PASSWORD")"
			printf 'WAN_IPADDR=%s\n' "$(shell_quote "$WAN_IPADDR")"
			printf 'WAN_CIDR=%s\n' "$(shell_quote "$WAN_CIDR")"
			printf 'WAN_NETMASK=%s\n' "$(shell_quote "$WAN_NETMASK")"
			printf 'WAN_GATEWAY=%s\n' "$(shell_quote "$WAN_GATEWAY")"
			printf 'WAN_DNS=%s\n' "$(shell_quote "$WAN_DNS")"
		} > "$TARGET_MOUNT/etc/owrt-installer/interface-map"; then
			die "Could not write installed network mapping"
		fi
	fi

	if ! cat > "$TARGET_MOUNT/etc/openwrt-installer-release" <<EOF
installed_by=openwrt-x86-installer
installer_version=$INSTALLER_VERSION
install_date=$install_date
target_disk=$target
payload_sha256=$PAYLOAD_SHA256
payload_source=$PAYLOAD_SOURCE_ID
openwrt_version=$PAYLOAD_VERSION
payload_filename=$PAYLOAD_FILENAME
image_type=$PAYLOAD_IMAGE_TYPE
boot_mode=$PAYLOAD_BOOT_MODE
payload_url=$PAYLOAD_URL
install_mode=$INSTALL_MODE
network_source=$NETWORK_SOURCE
storage_layout=$STORAGE_LAYOUT
rootfs_target_mib=$STORAGE_ROOT_TARGET_MIB
rootfs_start_sector=$STORAGE_ROOT_START_SECTOR
rootfs_end_sector=$STORAGE_ROOT_TARGET_END_SECTOR
unallocated_mib=$STORAGE_UNALLOCATED_MIB
config_import_source=$release_import_source
config_import_sha256=$release_import_sha256
config_import_policy=$release_import_policy
config_import_members=$release_import_members
rescue_source_version=${STORAGE_RESCUE_SOURCE_VERSION:-none}
rescue_source_revision=$release_rescue_revision
rescue_source_disk=$release_rescue_disk
rescue_source_partition=${STORAGE_RESCUE_SOURCE_PART:-none}
rescue_scope=${STORAGE_RESCUE_SCOPE:-none}
rescue_snapshot_sha256=$release_import_sha256
rescue_skipped_members=${STORAGE_RESCUE_SKIPPED:-0}
rescue_package_count=${STORAGE_RESCUE_PACKAGE_COUNT:-0}
lan_mac=$release_lan_mac
wan_mac=$release_wan_mac
lan_ip=$release_lan_ip
lan_cidr=$release_lan_cidr
wan_proto=$release_wan_proto
wan6_proto=$release_wan6_proto
EOF
	then
		die "Could not write installer release metadata"
	fi

	run_or_die "Could not unmount $TARGET_MOUNT" umount "$TARGET_MOUNT"
	TARGET_MOUNTED=0
	run_or_die "sync failed after writing installed config" sync
}

show_summary() {
	if ui_summary_screen; then
		return 0
	fi
	printf '\nInstallation summary:\n\n'
	printf '  Target disk: %s\n' "$TARGET"
	[ -n "$TARGET_DISK_DESCRIPTION" ] && printf '  Target info: %s\n' "$TARGET_DISK_DESCRIPTION"
	printf '  Mode:        %s\n' "$INSTALL_MODE"
	printf '  Image source: %s\n' "$PAYLOAD_SOURCE_LABEL"
	printf '  OpenWrt:      %s\n' "${PAYLOAD_VERSION:-unknown}"
	printf '  Image:        %s\n' "$PAYLOAD_FILENAME"
	printf '  Boot mode:    %s\n' "$PAYLOAD_BOOT_MODE"
	printf '  SHA-256:      %s\n' "$PAYLOAD_SHA256"
	printf '  Storage:      %s\n' "$(storage_layout_label)"
	printf '  Image root:   %s MiB\n' "$STORAGE_ROOT_IMAGE_MIB"
	printf '  Geometry:     partition 2 sectors %s-%s\n' \
		"$STORAGE_ROOT_START_SECTOR" "$STORAGE_ROOT_TARGET_END_SECTOR"
	if [ -n "$STORAGE_EXISTING_ROOT_SECTORS" ] &&
		storage_is_nonnegative_integer "$STORAGE_EXISTING_ROOT_SECTORS"; then
		printf '  Existing root: %s MiB on %s\n' \
			"$(((STORAGE_EXISTING_ROOT_SECTORS + 2047) / 2048))" "$STORAGE_EXISTING_ROOT_PART"
	fi
	if [ "$PAYLOAD_SOURCE_ID" = "downloaded-official" ]; then
		printf '  RAM download: %s compressed; %s required with reserve\n' \
			"$(bytes_as_mib "$PAYLOAD_COMPRESSED_SIZE")" \
			"$(bytes_as_mib "$PAYLOAD_RAM_REQUIRED")"
	fi
	case "$INSTALL_MODE" in
	import|rescue)
		printf '  Config:      %s\n' "$CONFIG_IMPORT_SOURCE_LABEL"
		printf '  Import:      %s, %s members, %s\n' "$CONFIG_IMPORT_POLICY" \
			"$CONFIG_IMPORT_MEMBER_COUNT" "$(bytes_as_mib "$CONFIG_IMPORT_COMPRESSED_SIZE")"
		printf '  Import SHA:  %s\n' "$CONFIG_IMPORT_SHA256"
		[ "$INSTALL_MODE" = "rescue" ] && printf '  Rescue:      OpenWrt %s from %s; skipped=%s\n' \
			"$STORAGE_RESCUE_SOURCE_VERSION" "$STORAGE_RESCUE_SOURCE_PART" "$STORAGE_RESCUE_SKIPPED"
		[ "$INSTALL_MODE" = "rescue" ] && printf '  Packages:    %s names recorded for reference (not installed)\n' \
			"$STORAGE_RESCUE_PACKAGE_COUNT"
		[ "$INSTALL_MODE" = "rescue" ] && printf '  RAM warning: rescued configuration exists only in volatile memory until install completes\n'
		;;
	esac
	if [ "$NETWORK_SOURCE" = "imported" ]; then
		printf '  Network:     imported from backup\n'
	elif [ "$SKIP_NETWORK" = "1" ]; then
		printf '  Network:     keep OpenWrt defaults\n'
	else
		printf '  LAN:         %s %s\n' "${LAN_DEV:-selected-by-mac}" "$LAN_MAC"
		printf '  WAN:         %s %s\n' "${WAN_DEV:-selected-by-mac}" "$WAN_MAC"
		printf '  LAN address: %s/%s\n' "$LAN_IP" "$LAN_CIDR"
		case "$WAN_PROTO" in
			dhcp) printf '  WAN:         DHCP client\n' ;;
			pppoe) printf '  WAN:         PPPoE user=%s\n' "$WAN_PPP_USERNAME" ;;
			static) printf '  WAN:         static %s/%s gateway=%s\n' "$WAN_IPADDR" "$WAN_CIDR" "${WAN_GATEWAY:-none}" ;;
			disabled) printf '  WAN:         disabled\n' ;;
		esac
		printf '  WAN6:        %s\n' "$(wan6_label "$WAN6_PROTO")"
		[ "$WAN_PROTO" = "disabled" ] || printf '  NAT:         enabled\n'
	fi
	if [ "$DRY_RUN" = "1" ]; then
		printf '\nHARDWARE TEST / DRY RUN: %s WILL NOT BE WRITTEN.\n\n' "$TARGET"
	else
		printf '\nALL DATA ON %s WILL BE ERASED.\n\n' "$TARGET"
	fi
}

confirm_erase() {
	[ "$ASSUME_YES" = "1" ] && return 0
	expected="ERASE $TARGET"
	ui_confirm_erase_screen "$expected"
	# The exact destructive phrase must remain keyboard-only. Previous Newt
	# widgets have exited before the daemon and its socket are removed here.
	local_mouse_stop
	autostart_serial_marker "OWRT_INSTALLER_UI_READY=exact-erase"
	printf 'Type exactly "%s" to continue: ' "$expected"
	IFS= read -r answer
	[ "$answer" = "$expected" ] || die "Confirmation did not match; installation cancelled"
	local_mouse_start
}

review_and_confirm() {
	while :; do
		show_summary
		[ "$ASSUME_YES" = "1" ] && return 0

		menu_reset
		if [ "$DRY_RUN" = "1" ]; then
			menu_note "Hardware test: continue exercises the exact ERASE gate, but no disk write is permitted."
		else
			menu_note "No disk write starts from this screen. Continue only opens the final exact ERASE confirmation."
		fi
		menu_add "continue" "Continue to final ERASE confirmation"
		menu_add "edit-storage" "Edit OpenWrt partition size"
		case "$INSTALL_MODE" in
			import) menu_add "edit-config" "Edit imported backup scope and network policy" ;;
			rescue) menu_add "edit-config" "Edit rescue scope and network policy" ;;
		esac
		if [ "$SKIP_NETWORK" != "1" ] ||
			{ [ "$CONFIG_IMPORT_HAS_NETWORK" = "1" ] &&
				{ [ "$INSTALL_MODE" = "import" ] || [ "$INSTALL_MODE" = "rescue" ]; }; }; then
			menu_add "edit-network" "Edit LAN/WAN interfaces and network settings"
		fi
		menu_add "cancel" "Cancel and return to shell"
		select_from_menu "Review action" "review action"

		case "$SELECTED_VALUE" in
			continue)
				confirm_erase
				return 0
				;;
			edit-storage)
				review_storage_status=0
				select_storage_layout || review_storage_status=$?
				[ "$review_storage_status" -eq 0 ] && record_storage_selection
				;;
			edit-config)
				edit_staged_configuration
				;;
			edit-network)
				select_network
				validate_network_settings
				NETWORK_SOURCE="wizard"
				SKIP_NETWORK=0
				;;
			cancel)
				die "Installation cancelled"
				;;
			*)
				die "Unsupported review action: $SELECTED_VALUE"
				;;
		esac
	done
}

post_install_menu() {
	if ui_ansi_active || ui_dialog_active; then
		menu_reset
		menu_add "1" "Reboot now"
		menu_add "2" "Shutdown"
		menu_add "3" "Return to shell"
		select_from_menu "Installation completed" "post-install action"
		choice="$SELECTED_VALUE"
		case "$choice" in
			1) reboot ;;
			2) poweroff ;;
			*) return 0 ;;
		esac
		return 0
	fi
	printf '\nInstallation completed successfully.\n\n'
	printf '[1] Reboot now\n'
	printf '[2] Shutdown\n'
	printf '[3] Return to shell\n\n'
	printf 'Select action [3]: '
	IFS= read -r choice || choice=3
	case "${choice:-3}" in
		1) reboot ;;
		2) poweroff ;;
		*) return 0 ;;
	esac
}

run_install() {
	: > "$INSTALL_LOG" 2>/dev/null || true
	local_mouse_start
	setup_ui
	append_install_log "INFO: Installer session started"
	append_install_log "INFO: UI backend: ${UI_MODE_ACTUAL:-line}"
	autostart_serial_marker "OWRT_INSTALLER_UI_BACKEND=${UI_MODE_ACTUAL:-line}"
	ui_welcome_screen "$INSTALLER_VERSION" "$AUTO_STARTED"

	if [ "$DOWNLOAD_LATEST" = "1" ]; then
		prepare_online_payload
	elif [ "$CHECK_LATEST" = "1" ]; then
		check_for_newer_payload
	fi
	ui_install_stage "Verify payload" "Checking the selected local OpenWrt image integrity." "$INSTALL_LOG"
	verify_payload
	ui_set_payload_version "$PAYLOAD_VERSION"
	if [ -z "$TARGET" ]; then
		install_target_ready=0
		while [ "$install_target_ready" = "0" ]; do
			select_target_disk
			validate_target_disk "$TARGET"
			TARGET_DISK_DESCRIPTION="$(disk_label "$TARGET")"
			storage_prepare_target_geometry "$TARGET" || die "$STORAGE_ERROR"
			storage_probe_existing_openwrt || true
			if [ "$STORAGE_EXISTING_FOUND" = "1" ]; then
				autostart_serial_marker "OWRT_INSTALLER_EXISTING_OPENWRT=$STORAGE_EXISTING_VERSION:$STORAGE_EXISTING_ROOT_PART"
				if [ "$STORAGE_EXISTING_RESCUE_AVAILABLE" = "1" ]; then
					autostart_serial_marker "OWRT_INSTALLER_EXISTING_RESCUE=ready"
				else
					autostart_serial_marker "OWRT_INSTALLER_EXISTING_RESCUE=unavailable"
					log "Existing OpenWrt rescue unavailable: $STORAGE_EXISTING_PROBE_REASON"
				fi
			fi
			while :; do
				if [ "$STORAGE_EXISTING_FOUND" = "1" ]; then
					select_existing_installation_action
				else
					select_installation_type
				fi
				case "$SELECTED_INSTALL_MODE" in
					clean)
						config_import_clear_workspace
						reset_rescue_metadata
						INSTALL_MODE="clean"
						if [ "$SKIP_NETWORK" = "1" ]; then
							NETWORK_SOURCE="defaults"
						else
							NETWORK_SOURCE="wizard"
						fi
						;;
					import)
						reset_rescue_metadata
						config_import_status=0
						prepare_interactive_config_import || config_import_status=$?
						[ "$config_import_status" -eq 0 ] || continue
						;;
					rescue)
						rescue_status=0
						prepare_interactive_rescue || rescue_status=$?
						[ "$rescue_status" -eq 0 ] || continue
						;;
					boot)
						handoff_status=0
						existing_upgrade_handoff || handoff_status=$?
						[ "$handoff_status" -eq 2 ] && continue
						return 0
						;;
					__back)
						config_import_clear_workspace
						TARGET=""
						break
						;;
				esac
				[ -n "$TARGET" ] || break
				storage_select_status=0
				select_storage_layout || storage_select_status=$?
				[ "$storage_select_status" -eq 0 ] || continue
				record_storage_selection
				install_target_ready=1
				break
			done
		done
	else
		validate_target_disk "$TARGET"
		TARGET_DISK_DESCRIPTION="$(disk_label "$TARGET")"
		storage_prepare_target_geometry "$TARGET" || die "$STORAGE_ERROR"
		if [ "$RESCUE_EXISTING" = "1" ]; then
			prepare_requested_rescue
		elif [ -n "$CONFIG_IMPORT_SOURCE_REQUEST" ]; then
			reset_rescue_metadata
			prepare_requested_config_import
		else
			reset_rescue_metadata
			INSTALL_MODE="clean"
			if [ "$SKIP_NETWORK" = "1" ]; then
				NETWORK_SOURCE="defaults"
			else
				NETWORK_SOURCE="wizard"
			fi
		fi
		prepare_requested_storage_layout
		record_storage_selection
	fi

	if [ "$SKIP_NETWORK" != "1" ]; then
		if [ -n "$LAN_MAC" ] || [ -n "$WAN_MAC" ]; then
			if [ -z "$LAN_MAC" ] || [ -z "$WAN_MAC" ]; then
				die "Specify both --lan-mac and --wan-mac, or neither"
			fi
			validate_network_selection
			validate_network_settings
		else
			select_network
		fi
	fi

	review_and_confirm

	if [ "$DRY_RUN" = "1" ]; then
		log "Dry run complete; no changes were made"
		autostart_serial_marker "OWRT_INSTALLER_DRY_RUN_COMPLETE=1"
		ui_notice "Dry run complete" "Hardware test passed the installer flow. No disk changes were made."
		return 0
	fi

	ui_install_stage "Prepare target" "Stopping swap and unmounting target partitions." "$INSTALL_LOG"
	[ "$STORAGE_PROBE_MOUNTED" = "0" ] || die "Existing OpenWrt source is still mounted before target erase"
	[ "$CONFIG_IMPORT_MOUNTED" = "0" ] || die "Configuration source is still mounted before target erase"
	swapoff -a >> "$INSTALL_LOG" 2>&1 || true
	unmount_target_partitions "$TARGET"
	ui_install_stage "Write image" "Writing the verified OpenWrt image to $TARGET." "$INSTALL_LOG"
	write_payload "$TARGET"

	rootpart="$(get_partition_path "$TARGET" 2)"
	resize_rootfs "$TARGET" "$rootpart"
	ui_install_stage "Write installed config" "Saving installer metadata and network mapping." "$INSTALL_LOG"
	write_installed_config "$rootpart" "$TARGET"
	log "Installation completed successfully"
	ui_success_screen "Installation completed successfully."

	if [ "$ASSUME_YES" != "1" ]; then
		post_install_menu
	fi
}

parse_args() {
	action=install
	while [ "$#" -gt 0 ]; do
		case "$1" in
			--help|-h)
				usage
				exit 0
				;;
			--list-disks)
				action=list-disks
				shift
				;;
			--list-nics)
				action=list-nics
				shift
				;;
			--target)
				[ "$#" -ge 2 ] || die "--target requires a disk path"
				TARGET="$2"
				shift 2
				;;
			--lan-mac)
				[ "$#" -ge 2 ] || die "--lan-mac requires an address"
				LAN_MAC="$2"
				shift 2
				;;
			--wan-mac)
				[ "$#" -ge 2 ] || die "--wan-mac requires an address"
				WAN_MAC="$2"
				shift 2
				;;
			--lan-ip)
				[ "$#" -ge 2 ] || die "--lan-ip requires IPv4/CIDR"
				parse_cidr_address "$2" "$LAN_CIDR" || die "Invalid --lan-ip value: $2"
				LAN_IP="$PARSED_IP"
				LAN_CIDR="$PARSED_CIDR"
				LAN_NETMASK="$PARSED_NETMASK"
				shift 2
				;;
			--wan-proto)
				[ "$#" -ge 2 ] || die "--wan-proto requires dhcp, pppoe, static, or disabled"
				case "$2" in
					dhcp|pppoe|static|disabled) WAN_PROTO="$2" ;;
					*) die "Invalid --wan-proto value: $2" ;;
				esac
				[ "$WAN_PROTO" = "disabled" ] && WAN6_PROTO="disabled"
				shift 2
				;;
			--wan6-proto)
				[ "$#" -ge 2 ] || die "--wan6-proto requires dhcpv6 or disabled"
				case "$2" in
					dhcpv6|disabled) WAN6_PROTO="$2" ;;
					*) die "Invalid --wan6-proto value: $2" ;;
				esac
				shift 2
				;;
			--pppoe-username)
				[ "$#" -ge 2 ] || die "--pppoe-username requires a value"
				WAN_PPP_USERNAME="$2"
				shift 2
				;;
			--pppoe-password)
				[ "$#" -ge 2 ] || die "--pppoe-password requires a value"
				WAN_PPP_PASSWORD="$2"
				shift 2
				;;
			--wan-ip)
				[ "$#" -ge 2 ] || die "--wan-ip requires IPv4/CIDR"
				parse_cidr_address "$2" "$WAN_CIDR" || die "Invalid --wan-ip value: $2"
				WAN_IPADDR="$PARSED_IP"
				WAN_CIDR="$PARSED_CIDR"
				WAN_NETMASK="$PARSED_NETMASK"
				shift 2
				;;
			--wan-gateway)
				[ "$#" -ge 2 ] || die "--wan-gateway requires an IPv4 address"
				is_ipv4 "$2" || die "Invalid --wan-gateway value: $2"
				WAN_GATEWAY="$2"
				shift 2
				;;
			--wan-dns)
				[ "$#" -ge 2 ] || die "--wan-dns requires a value"
				WAN_DNS="$2"
				shift 2
				;;
			--skip-network-wizard)
				SKIP_NETWORK=1
				shift
				;;
			--config-backup)
				[ "$#" -ge 2 ] || die "--config-backup requires a .tar.gz file"
				CONFIG_IMPORT_SOURCE_REQUEST="$2"
				shift 2
				;;
			--root-size)
				[ "$#" -ge 2 ] || die "--root-size requires fill, image, or a MiB/GiB size"
				STORAGE_LAYOUT_REQUEST="$2"
				shift 2
				;;
			--rescue-existing)
				RESCUE_EXISTING=1
				shift
				;;
			--rescue-scope)
				[ "$#" -ge 2 ] || die "--rescue-scope requires config-only or full"
				case "$2" in
					config-only|full) RESCUE_SCOPE_REQUEST="$2" ;;
					*) die "Invalid --rescue-scope value: $2" ;;
				esac
				shift 2
				;;
			--config-import-policy)
				[ "$#" -ge 2 ] || die "--config-import-policy requires config-only or full"
				case "$2" in
					config-only|full) CONFIG_IMPORT_POLICY_REQUEST="$2" ;;
					*) die "Invalid --config-import-policy value: $2" ;;
				esac
				shift 2
				;;
			--import-network)
				[ "$#" -ge 2 ] || die "--import-network requires keep or wizard"
				case "$2" in
					keep|wizard) CONFIG_IMPORT_NETWORK_REQUEST="$2" ;;
					*) die "Invalid --import-network value: $2" ;;
				esac
				shift 2
				;;
			--download-latest)
				DOWNLOAD_LATEST=1
				shift
				;;
			--check-latest)
				CHECK_LATEST=1
				shift
				;;
			--autostart)
				AUTO_STARTED=1
				shift
				;;
			--allow-removable)
				ALLOW_REMOVABLE=1
				shift
				;;
			--yes-i-know-this-will-erase-data)
				ASSUME_YES=1
				shift
				;;
			--dry-run)
				DRY_RUN=1
				shift
				;;
			*)
				die "Unknown option: $1"
				;;
		esac
	done
	if [ -z "$CONFIG_IMPORT_SOURCE_REQUEST" ]; then
		[ -z "$CONFIG_IMPORT_POLICY_REQUEST" ] ||
			die "--config-import-policy requires --config-backup"
	fi
	if [ "$RESCUE_EXISTING" = "1" ]; then
		[ -n "$TARGET" ] || die "--rescue-existing requires --target"
		[ -n "$RESCUE_SCOPE_REQUEST" ] || die "--rescue-existing requires --rescue-scope"
		[ -z "$CONFIG_IMPORT_SOURCE_REQUEST" ] || die "--rescue-existing cannot be combined with --config-backup"
	else
		[ -z "$RESCUE_SCOPE_REQUEST" ] || die "--rescue-scope requires --rescue-existing"
	fi
	if [ -z "$CONFIG_IMPORT_SOURCE_REQUEST" ] && [ "$RESCUE_EXISTING" != "1" ]; then
		[ -z "$CONFIG_IMPORT_NETWORK_REQUEST" ] ||
			die "--import-network requires --config-backup or --rescue-existing"
	fi
	if [ -n "$STORAGE_LAYOUT_REQUEST" ]; then
		[ -n "$TARGET" ] || die "--root-size requires --target"
		case "$STORAGE_LAYOUT_REQUEST" in
			fill|image) ;;
			*)
				storage_parse_size_mib "$STORAGE_LAYOUT_REQUEST" ||
					die "Invalid --root-size value: $STORAGE_LAYOUT_REQUEST"
				;;
		esac
	fi
}

main() {
	if [ "$#" -eq 0 ]; then
		run_install
		cleanup
		exit 0
	fi

	parse_args "$@"
	setup_ui

	case "$action" in
		list-disks) show_disks ;;
		list-nics) show_nics ;;
		install) run_install ;;
	esac

	cleanup
}

if [ "${OWRT_INSTALL_TEST_SOURCE_ONLY:-0}" = "1" ]; then
	if (return 0 2>/dev/null); then
		return 0
	fi
	exit 0
fi

main "$@"
