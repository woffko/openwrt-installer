#!/bin/sh

set -eu

OUTPUT="${1:-/tmp/owrt-hardware-report.txt}"
CMDLINE_FILE="${OWRT_HW_CMDLINE_FILE:-/proc/cmdline}"
INPUT_CLASS="${OWRT_HW_INPUT_CLASS:-/sys/class/input}"
APK_DB="${OWRT_HW_APK_DB:-/lib/apk/db/installed}"
INSTALL_LOG="${OWRT_HW_INSTALL_LOG:-/tmp/owrt-installer.log}"
INSTALLER_BIN="${OWRT_HW_INSTALLER_BIN:-/usr/sbin/owrt-install}"
PROC_ROOT="${OWRT_HW_PROC_ROOT:-/proc}"
GPM_PID_FILE="${OWRT_HW_GPM_PID_FILE:-/var/run/gpm.pid}"
GPM_SOCKET="${OWRT_HW_GPM_SOCKET:-/dev/gpmctl}"
MOUSE_STATE="${OWRT_HW_MOUSE_STATE:-/tmp/owrt-installer-mouse/state}"

has_cmdline_arg() {
	needle="$1"
	[ -r "$CMDLINE_FILE" ] || return 1
	case " $(cat "$CMDLINE_FILE") " in
		*" $needle "*) return 0 ;;
	esac
	return 1
}

package_version() {
	package="$1"
	[ -r "$APK_DB" ] || {
		printf 'unknown\n'
		return
	}
	awk -F: -v package="$package" '
		$1 == "P" { current = $2 }
		current == package && $1 == "V" { print $2; exit }
	' "$APK_DB"
}

installer_version() {
	[ -r "$INSTALLER_BIN" ] || {
		printf 'unknown\n'
		return
	}
	sed -n 's/^INSTALLER_VERSION="\([^"]*\)"/\1/p' "$INSTALLER_BIN" | head -n 1
}

log_has() {
	pattern="$1"
	[ -r "$INSTALL_LOG" ] && grep -F "$pattern" "$INSTALL_LOG" >/dev/null 2>&1
}

gpm_is_running() {
	for comm in "$PROC_ROOT"/[0-9]*/comm; do
		[ -r "$comm" ] || continue
		[ "$(cat "$comm" 2>/dev/null || true)" = "gpm" ] && return 0
	done
	return 1
}

ask_result() {
	prompt="$1"
	override="${2:-}"
	case "$override" in
		pass|fail|skipped) printf '%s\n' "$override"; return ;;
		'') ;;
		*) printf 'Invalid report result override: %s\n' "$override" >&2; exit 2 ;;
	esac
	if [ "${OWRT_HW_REPORT_NONINTERACTIVE:-0}" = "1" ] || [ ! -t 0 ]; then
		printf 'skipped\n'
		return
	fi
	while :; do
		printf '%s [p=pass/f=fail/s=skip]: ' "$prompt" >&2
		IFS= read -r answer || answer=s
		case "$answer" in
			p|P|pass|PASS) printf 'pass\n'; return ;;
			f|F|fail|FAIL) printf 'fail\n'; return ;;
			s|S|skip|SKIP|'') printf 'skipped\n'; return ;;
		esac
	done
}

ask_pointer_connection() {
	override="${OWRT_HW_POINTER_CONNECTION:-}"
	case "$override" in
		usb-wired|usb-receiver|ps2|other) printf '%s\n' "$override"; return ;;
		'') ;;
		*) printf 'Invalid pointer connection override: %s\n' "$override" >&2; exit 2 ;;
	esac
	if [ "${OWRT_HW_REPORT_NONINTERACTIVE:-0}" = "1" ] || [ ! -t 0 ]; then
		printf 'unknown\n'
		return
	fi
	while :; do
		printf '%s\n' 'Pointer connection: 1=wired USB, 2=USB receiver, 3=PS/2, 4=other' >&2
		printf 'Select connection type [1-4]: ' >&2
		IFS= read -r answer || answer=
		case "$answer" in
			1) printf 'usb-wired\n'; return ;;
			2) printf 'usb-receiver\n'; return ;;
			3) printf 'ps2\n'; return ;;
			4) printf 'other\n'; return ;;
		esac
	done
}

ask_wheel_skip_reason() {
	override="${OWRT_HW_WHEEL_SKIP_REASON:-}"
	case "$override" in
		no-scrollable-list|unavailable) printf '%s\n' "$override"; return ;;
		'') ;;
		*) printf 'Invalid wheel skip reason override: %s\n' "$override" >&2; exit 2 ;;
	esac
	if [ "${OWRT_HW_REPORT_NONINTERACTIVE:-0}" = "1" ] || [ ! -t 0 ]; then
		printf 'unknown\n'
		return
	fi
	while :; do
		printf 'Wheel skip reason [n=no scrollable list/u=unavailable]: ' >&2
		IFS= read -r answer || answer=
		case "$answer" in
			n|N) printf 'no-scrollable-list\n'; return ;;
			u|U) printf 'unavailable\n'; return ;;
		esac
	done
}

value_or_unknown() {
	value="$1"
	[ -n "$value" ] && printf '%s' "$value" || printf 'unknown'
}

umask 077
tmp_output="$OUTPUT.tmp.$$"
trap 'rm -f "$tmp_output"' EXIT INT TERM
: > "$tmp_output"

if [ -d /sys/firmware/efi ]; then
	boot_mode=uefi
else
	boot_mode=bios
fi

mouse_flag=no
has_cmdline_arg owrt.mouse=1 && mouse_flag=yes
hardware_test_flag=no
has_cmdline_arg owrt.hardware-test=1 && hardware_test_flag=yes

mouse_started=no
log_has "[owrt-installer-mouse] active on " && mouse_started=yes
mouse_stopped=no
log_has "[owrt-installer-mouse] stopped" && mouse_stopped=yes
dry_run_complete=no
log_has "Dry run complete; no changes were made" && dry_run_complete=yes

runtime_clean=yes
gpm_is_running && runtime_clean=no
[ ! -e "$GPM_PID_FILE" ] || runtime_clean=no
[ ! -e "$GPM_SOCKET" ] || runtime_clean=no
[ ! -e "$MOUSE_STATE" ] || runtime_clean=no

pointer_connection="$(ask_pointer_connection)"
manual_move="$(ask_result "Pointer movement was stable in the installer" "${OWRT_HW_MANUAL_MOVE:-}")"
manual_click="$(ask_result "Click selected and submitted the intended UI control" "${OWRT_HW_MANUAL_CLICK:-}")"
manual_wheel="$(ask_result "Wheel changed the highlighted menu item" "${OWRT_HW_MANUAL_WHEEL:-}")"
wheel_skip_reason=not-applicable
if [ "$manual_wheel" = "skipped" ]; then
	wheel_skip_reason="$(ask_wheel_skip_reason)"
fi
manual_keyboard="$(ask_result "Arrow keys and Enter remained usable" "${OWRT_HW_MANUAL_KEYBOARD:-}")"
manual_exact="$(ask_result "Mouse input stopped before the exact ERASE prompt" "${OWRT_HW_MANUAL_EXACT:-}")"
manual_storage_navigation="$(ask_result "Mouse and keyboard navigation worked on storage and rescue screens" "${OWRT_HW_MANUAL_STORAGE_NAVIGATION:-}")"
manual_sata_layout="$(ask_result "A physical SATA SSD booted with the requested OpenWrt root size" "${OWRT_HW_MANUAL_SATA_LAYOUT:-}")"
manual_nvme_layout="$(ask_result "A physical NVMe disk booted with the requested OpenWrt root size" "${OWRT_HW_MANUAL_NVME_LAYOUT:-}")"
manual_rescue_restore="$(ask_result "Rescue reinstalled OpenWrt and restored the changed LAN/WAN configuration" "${OWRT_HW_MANUAL_RESCUE_RESTORE:-}")"
manual_power_cycle="$(ask_result "Cancelling or powering off after the RAM snapshot and before ERASE left the source disk unchanged" "${OWRT_HW_MANUAL_POWER_CYCLE:-}")"

{
	printf 'report_schema=3\n'
	printf 'installer_version=%s\n' "$(value_or_unknown "$(installer_version)")"
	printf 'architecture=%s\n' "$(uname -m 2>/dev/null || printf unknown)"
	printf 'kernel=%s\n' "$(uname -r 2>/dev/null || printf unknown)"
	printf 'boot_mode=%s\n' "$boot_mode"
	printf 'kernel_mouse_flag=%s\n' "$mouse_flag"
	printf 'kernel_hardware_test_flag=%s\n' "$hardware_test_flag"
	printf 'gpm_daemon_version=%s\n' "$(value_or_unknown "$(package_version gpm-daemon)")"
	printf 'libnewt_version=%s\n' "$(value_or_unknown "$(package_version libnewt)")"
	printf 'whiptail_version=%s\n' "$(value_or_unknown "$(package_version whiptail)")"
	printf 'mouse_started=%s\n' "$mouse_started"
	printf 'mouse_stopped=%s\n' "$mouse_stopped"
	printf 'dry_run_complete=%s\n' "$dry_run_complete"
	printf 'runtime_cleanup=%s\n' "$runtime_clean"
	printf 'pointer_connection=%s\n' "$pointer_connection"
	printf 'manual_pointer_move=%s\n' "$manual_move"
	printf 'manual_click=%s\n' "$manual_click"
	printf 'manual_wheel=%s\n' "$manual_wheel"
	printf 'manual_wheel_skip_reason=%s\n' "$wheel_skip_reason"
	printf 'manual_keyboard=%s\n' "$manual_keyboard"
	printf 'manual_exact_prompt_mouse_stop=%s\n' "$manual_exact"
	printf 'manual_storage_rescue_navigation=%s\n' "$manual_storage_navigation"
	printf 'manual_sata_root_size_and_boot=%s\n' "$manual_sata_layout"
	printf 'manual_nvme_root_size_and_boot=%s\n' "$manual_nvme_layout"
	printf 'manual_rescue_restore=%s\n' "$manual_rescue_restore"
	printf 'manual_pre_erase_power_cycle_no_change=%s\n' "$manual_power_cycle"
} >> "$tmp_output"

pointer_count=0
for event_path in "$INPUT_CLASS"/event*; do
	[ -d "$event_path" ] || continue
	rel_file="$event_path/device/capabilities/rel"
	[ -r "$rel_file" ] || continue
	rel_word="$(awk '{ print $NF }' "$rel_file" 2>/dev/null || true)"
	case "$rel_word" in
		''|*[!0-9a-fA-F]*) continue ;;
	esac
	rel_value="$(printf '%d' "0x$rel_word" 2>/dev/null || true)"
	case "$rel_value" in
		''|*[!0-9]*) continue ;;
	esac
	[ $((rel_value & 3)) -eq 3 ] || continue
	pointer_count=$((pointer_count + 1))
	id_dir="$event_path/device/id"
	bus="$(cat "$id_dir/bustype" 2>/dev/null || true)"
	vendor="$(cat "$id_dir/vendor" 2>/dev/null || true)"
	product="$(cat "$id_dir/product" 2>/dev/null || true)"
	printf 'relative_pointer_%s=%s,bus=%s,vendor=%s,product=%s\n' \
		"$pointer_count" "${event_path##*/}" \
		"$(value_or_unknown "$bus")" "$(value_or_unknown "$vendor")" \
		"$(value_or_unknown "$product")" >> "$tmp_output"
done
printf 'relative_pointer_count=%s\n' "$pointer_count" >> "$tmp_output"

physical_result=pass
for automatic_gate in \
	"$mouse_flag" "$hardware_test_flag" "$mouse_started" "$mouse_stopped" \
	"$dry_run_complete" "$runtime_clean"
do
	[ "$automatic_gate" = "yes" ] || physical_result=fail
done
[ "$pointer_count" -ge 1 ] || physical_result=fail

case "$manual_move:$manual_click:$manual_keyboard:$manual_exact" in
	*fail*) physical_result=fail ;;
	*skipped*) [ "$physical_result" = "fail" ] || physical_result=incomplete ;;
esac
case "$manual_storage_navigation:$manual_sata_layout:$manual_nvme_layout:$manual_rescue_restore:$manual_power_cycle" in
	*fail*) physical_result=fail ;;
	*skipped*) [ "$physical_result" = "fail" ] || physical_result=incomplete ;;
esac
case "$manual_wheel" in
	fail) physical_result=fail ;;
	skipped)
		if [ "$wheel_skip_reason" != "no-scrollable-list" ] && [ "$physical_result" != "fail" ]; then
			physical_result=incomplete
		fi
		;;
esac
[ "$pointer_connection" != "unknown" ] || {
	[ "$physical_result" = "fail" ] || physical_result=incomplete
}
printf 'physical_flow_result=%s\n' "$physical_result" >> "$tmp_output"

mv "$tmp_output" "$OUTPUT"
trap - EXIT INT TERM
printf 'Hardware report written to %s\n' "$OUTPUT" >&2
cat "$OUTPUT"

case "$physical_result" in
	pass) exit 0 ;;
	fail) exit 1 ;;
	*) exit 2 ;;
esac
