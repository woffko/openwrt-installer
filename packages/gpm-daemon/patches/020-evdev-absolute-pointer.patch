 #ifdef HAVE_LINUX_INPUT_H
+static struct input_absinfo evdev_abs_x;
+static struct input_absinfo evdev_abs_y;
+static int evdev_absolute;
+
+static int evdev_test_bit(unsigned int bit, const unsigned long *bits)
+{
+   unsigned int bits_per_long = sizeof(unsigned long) * 8;
+   return !!(bits[bit / bits_per_long] & (1UL << (bit % bits_per_long)));
+}
+
+static int evdev_has_relative_xy(int fd)
+{
+   unsigned long rel_bits[(REL_MAX / (sizeof(unsigned long) * 8)) + 1];
+
+   memset(rel_bits, 0, sizeof(rel_bits));
+   if (ioctl(fd, EVIOCGBIT(EV_REL, sizeof(rel_bits)), rel_bits) < 0)
+      return 0;
+
+   return evdev_test_bit(REL_X, rel_bits) && evdev_test_bit(REL_Y, rel_bits);
+}
+
+static int evdev_scale_absolute(int value, const struct input_absinfo *axis,
+                                int cells)
+{
+   long long offset;
+   long long range;
+
+   if (cells <= 1 || axis->maximum <= axis->minimum)
+      return 1;
+   if (value < axis->minimum)
+      value = axis->minimum;
+   else if (value > axis->maximum)
+      value = axis->maximum;
+
+   offset = (long long)value - axis->minimum;
+   range = (long long)axis->maximum - axis->minimum;
+   return 1 + (int)(offset * (cells - 1) / range);
+}
+
+static Gpm_Type *I_evdev(int fd, unsigned short flags, Gpm_Type *type,
+                         int argc, char **argv)
+{
+   (void)flags;
+   (void)argc;
+   (void)argv;
+   evdev_absolute = 0;
+   type->absolute = 0;
+
+   /* Prefer relative motion on hybrid devices. It avoids mode changes for
+    * ordinary mice while allowing VMware/QEMU tablets as a fallback. */
+   if (evdev_has_relative_xy(fd))
+      return type;
+
+   if (ioctl(fd, EVIOCGABS(ABS_X), &evdev_abs_x) == 0 &&
+       ioctl(fd, EVIOCGABS(ABS_Y), &evdev_abs_y) == 0 &&
+       evdev_abs_x.maximum > evdev_abs_x.minimum &&
+       evdev_abs_y.maximum > evdev_abs_y.minimum) {
+      evdev_absolute = 1;
+      type->absolute = 1;
+   }
+
+   return type;
+}
+
