+static int backtitleHeight(const char *text)
+{
+    int height = 0;
+
+    if (text == NULL || *text == '\0')
+        return 0;
+
+    height = 1;
+    while (*text != '\0') {
+        if (*text == '\n')
+            height++;
+        text++;
+    }
+    return height;
+}
+
+static int backtitleWidth(const char *text)
+{
+    int width = 0;
+
+    while (text != NULL && *text != '\0') {
+        const char *next = strchr(text, '\n');
+        int lineWidth = _newt_wstrlen(text, next ? next - text : -1);
+
+        width = max(width, lineWidth);
+        text = next ? next + 1 : NULL;
+    }
+    return width;
+}
+
+static void drawBacktitle(const char *text)
+{
+    char *copy, *line, *next;
+    int row = 0, column;
+
+    if (text == NULL || *text == '\0')
+        return;
+
+    copy = strdup(text);
+    if (copy == NULL)
+        return;
+
+    column = max(0, (SLtt_Screen_Cols - backtitleWidth(text)) / 2);
+
+    line = copy;
+    while (line != NULL) {
+        next = strchr(line, '\n');
+        if (next != NULL)
+            *next++ = '\0';
+        newtDrawRootText(column, row++, line);
+        line = next;
+    }
+    free(copy);
+}
